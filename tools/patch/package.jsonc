{
  "name": "patch",
  "display": "patch",
  "description": "A utility to apply patch files to original sources",
  "site": "https://www.gnu.org/software/patch/patch.html",
  "license": "GPL",
  "process_time": 500,
  "options": [
    {
      "display": "Version",
      "name": "version",
      "enable": false,
      "type": "choice",
      "items": "{{$versions}}",
      "default": "$latest_version"
    },
    {
      "display": "Visual Studio version",
      "name": "msvc_version",
      "enable": false,
      "type": "choice",
      "items": "{{$msvc_versions}}",
      "default": "$msvc_version_default"
    },
    {
      "display": "MSVC toolset version",
      "name": "msvc_toolset_version",
      "enable": false,
      "type": "choice",
      "items": "{{$msvc_toolset_versions}}",
      "default": "$msvc_toolset_version_default"
    },
    {
      "display": "Build arch",
      "name": "build_arch",
      "enable": false,
      "type": "choice",
      "items": [
        "x64",
        "x32"
      ],
      "default": "x64"
    },
    {
      "display": "MSVC runtime library",
      "name": "msvc_runtime_library",
      "enable": false,
      "type": "choice",
      "items": [
        "mt",
        "md"
      ],
      "default": "md"
    },
    {
      "display": "Build library",
      "name": "build_library",
      "enable": false,
      "type": "choice",
      "items": [
        "shared",
        "static"
      ],
      "default": "static"
    },
    {
      "display": "Build type",
      "name": "build_type",
      "enable": false,
      "type": "choice",
      "items": [
        "Release",
        "Debug"
      ],
      "default": "Release"
    },
    {
      "display": "Build layout",
      "name": "build_layout",
      "enable": false,
      "type": "choice",
      "items": [
        "union",
        "separation"
      ],
      "default": "separation"
    },
    {
      "display": "Using CUDA",
      "name": "cuda_enable",
      "enable": false,
      "type": "bool",
      "default": false
    },
    {
      "display": "CUDA Version",
      "name": "cuda_version",
      "enable": "{{$cuda_enable}}",
      "type": "choice",
      "items": "{{$cuda_versions}}",
      "default": "{{$cuda_version_default}}"
    }
  ],
  "versions": {
    "default": {
      "environments": {
        "LC_ALL": "C",
        "MSYS": "winsymlinks:nativestrict",
        "MSYSTEM": "MSYS",
        "CHERE_INVOKING": "1",
        // "MSYS2_PATH_TYPE": "inherit",
        "CC": "/ucrt64/bin/gcc.exe",
        "CXX": "/ucrt64/bin/g++.exe",
        "LD": "/ucrt64/bin/ld.exe",
        "AR": "/ucrt64/bin/ar.exe",
        "RANLIB": "/ucrt64/bin/ranlib.exe",
        "STRIP": "/ucrt64/bin/strip.exe",
        "NM": "/ucrt64/bin/nm.exe",
        "OBJCOPY": "/ucrt64/bin/objcopy.exe",
        "OBJDUMP": "/ucrt64/bin/objdump.exe",
        "CPPFLAGS": "-I/opt/ucrt64/include",
        "LDFLAGS": "-L/opt/ucrt64/lib",
        "SED": "/usr/bin/sed.exe",
        "PERLIO": "raw",
        "CUDA_PATH": "{{os.path.join($cuda_root, f'v{$cuda_version}')  if $cuda_enable else ''}}",
        "CUDNN_PATH": "{{os.path.join($cuda_root, f'v{$cuda_version}')  if $cuda_enable else ''}}"
      },
      "source_dir": "${source_rootdir}\\${name}-${version}",
      "dist_name": "${name}-${version}{{'' if $build_library == 'interface' else '-' + $build_arch + '-' + $msvc_toolset_version + '-' + $msvc_runtime_library + (('-cu' + $cuda_version.replace('.','')) if $cuda_enable else '') + ('-static' if 'static' == $build_library else '')}}",
      "dist_name_release": "${dist_name}{{'-release' if $build_layout == 'separation' else ''}}",
      "build_dir_release": "${source_rootdir}\\${dist_name_release}-build",
      "dist_dir_release": "${package_dir}",
      "cache_file": "${cache_rootdir}\\${name}-${version}.tar.gz",
      "download_url": "https://ftp.gnu.org/pub/gnu/${name}/${name}-${version}.tar.gz",
      "msys2_dir" : "${tools_rootdir}\\msys2\\msys64",
      "msys2_external_runtime_dir": "${msys2_dir}\\opt\\ucrt64",
      "msys2_bash_ob": "\"${msys2_dir}\\usr\\bin\\bash.exe\" -lc ",
      "msys2_bash_cb": "",
      "stages": {
        "download": {
          "scripts": [
            {
              "when": "{{os.path.isdir($source_dir)}}",
              "script": "rmdir /q /s \"$source_dir\""
            },
            {
              "message": "donloads",
              "when": "{{not os.path.isdir($source_dir) and not os.path.isfile($cache_file)}}",
              "script": "curl.exe --fail -L -s -o \"$cache_file\" \"$download_url\"",
              "fallback": "rmdir /q /s \"$source_dir\""
            },
            {
              "message": "extract from cache.",
              "when": "{{not os.path.isdir($source_dir) and os.path.isfile($cache_file)}}",
              "script": "7z.exe x \"${cache_file}\" -so > \"${cache_file}.temp.tar\" && 7z.exe x \"${cache_file}.temp.tar\" -aoa -o\"${source_rootdir}\" && del \"${cache_file}.temp.tar\"",
              "fallback": "rmdir /q /s \"$source_dir\""
            }
          ]
        },
        "patch": {
          "patch_command": "${msys2_dir}\\usr\\bin\\patch.exe",
          "repo_url":"https://raw.githubusercontent.com/WinMerge/patch/refs/heads/master/msys2",
          "patch_files": [
            {
              "url": "$repo_url/msys2-patch-2.7.1.patch"
            },
            {
              "url": "$repo_url/msys2-patch-manifest.patch"
            }
          ],
          "scripts": [
            {
              "message": "Clean /opt/ucrt64 directory in msys2",
              "script": "del /q /s \"$msys2_external_runtime_dir\" > nul",
              "ignore_errors": true
            },
            {
              // Download patch_files
              "message": "Patch ${name} source code",
              "when": "{{'patch_files' in globals()}}",
              "chdir": "$source_dir",
              "script": "{{' && '.join([(f'pushd \"{p[\"chdir\"]}\" && ' if \"chdir\" in p else '')+(f'curl.exe --fail -L -s -o \"{os.path.basename(p[\"url\"])}\" \"{p[\"url\"]}\" && copy nul > \"__downloaded__{os.path.basename(p[\"url\"])}\"' if \"url\" in p else '') + (' && popd ' if \"chdir\" in p else '') for p in $patch_files if p.get('when', True) and not os.path.exists('__downloaded__' + os.path.basename(p.get('url')))])}}"
            },
            {
              "chdir": "$source_dir",
              "bash_script": "rm -f src/patch.manifest; rm -f src/patch.rc",
              "script": "${msys2_bash_ob} \"${bash_script}\" ${msys2_bash_cb}"
            },
            {
              "message": "Apply patch file.",
              "chdir": "$source_dir",
              "when": "{{os.path.isfile('msys2-patch-2.7.1.patch') and not os.path.isfile('__patched__msys2-patch-2.7.1.patch')}}",
              "bash_script": "/usr/bin/patch -Np1 -i msys2-patch-2.7.1.patch && touch __patched__msys2-patch-2.7.1.patch",
              "script": "${msys2_bash_ob} \"${bash_script}\" ${msys2_bash_cb}"
            },
            {
              "message": "Apply patch file.",
              "chdir": "$source_dir",
              "when": "{{os.path.isfile('msys2-patch-manifest.patch') and not os.path.isfile('__patched__msys2-patch-manifest.patch')}}",
              "bash_script": "/usr/bin/patch -Np2 -i msys2-patch-manifest.patch && touch __patched__msys2-patch-manifest.patch",
              "script": "${msys2_bash_ob} \"${bash_script}\" ${msys2_bash_cb}"
            },
            {
              "message": "Apply patch file.",
              "chdir": "$source_dir",
              "when": "{{not os.path.isfile('__patched__msys2-patch-sources.diff')}}",
              "bash_script": "/usr/bin/patch -Np1 -i msys2-patch-sources.diff && touch __patched__msys2-patch-sources.diff",
              "script": "copy /y ${package_dir}\\msys2-patch-sources.diff ${source_dir}\\msys2-patch-sources.diff && ${msys2_bash_ob} \"${bash_script}\" ${msys2_bash_cb}"
            },
            {
              "message": "sed to adjust manifest file for msys2 runtime.",
              "chdir": "$source_dir",
              "bash_script": "/usr/bin/sed -e 's/@ARCH@/amd64/g' -i src/patch.manifest",
              "script": "${msys2_bash_ob} \"${bash_script}\" ${msys2_bash_cb}"
            },
            {
              "message": "reconfigure",
              "chdir": "$source_dir",
              "bash_script": "autoreconf -vfi",
              "script": "${msys2_bash_ob} \"${bash_script}\" ${msys2_bash_cb}"
            }
          ]
        },
        "configure": {
          "config_options":[
            "--host=x86_64-w64-mingw32",
            "--disable-maintainer-mode",
            "ac_cv_func_setmode_dos=yes",
            "{{'--enable-static' if 'static' in $build_library else '--disable-static'}}",
            "{{'--enable-shared' if 'shared' in $build_library else '--disable-shared'}}"
          ],
          "config_options_release": [
            "--prefix=/opt/${name}/release"
          ],
          "scripts": [
            {
              "when": "{{'Release' in $build_type }}",
              "script": "del /q /s \"$build_dir_release\" > nul",
              "ignore_errors": true
            },
            {
              "when": "{{'Release' in $build_type and not os.path.isdir($build_dir_release)}}",
              "script": "mkdir \"$build_dir_release\"",
              "ignore_errors": true
            },
            {
              "message": "config for release.",
              "when": "{{'Release' in $build_type}}",
              "environments": {
                "PATH":"{{exec('import re') or re.sub(r'[^;]+pkg-config[^;]+', '', '%PATH%')}}"
              },
              "chdir": "$build_dir_release",
              "bash_script": "../{{os.path.basename($source_dir)}}/configure {{' '.join($config_options)}} {{' '.join($config_options_release)}}",
              "script": "${msys2_bash_ob} \"${bash_script}\" ${msys2_bash_cb}"
            }
          ]
        },
        "build": {
          "scripts": [
            {
              "message": "Clean /opt/${name} directory in msys2",
              "bash_script": "rm -rf /opt/${name}/*",
              "script": "${msys2_bash_ob} \"${bash_script}\" ${msys2_bash_cb}",
              "ignore_errors": false
            },
            {
              "message": "build for release.",
              "when": "{{'Release' in $build_type}}",
              "environments": {
                "PATH": "{{';'.join(['%PATH%', $dependent_dlls_release])}}",
                "PERLIO": "raw",
                "CFLAGS": "-Dputenv=_putenv"
              },
              "chdir": "$build_dir_release",
              "bash_script": "make -j4",
              "script": "${msys2_bash_ob} \"${bash_script}\" ${msys2_bash_cb}"
            }
          ]
        },
        "install": {
          "scripts": [
            {
              "message": "build for release.",
              "when": "{{'Release' in $build_type}}",
              "chdir": "$build_dir_release",
              "bash_script": "make install",
              "script": "${msys2_bash_ob} \"${bash_script}\" ${msys2_bash_cb}"
            },
            {
              "message": "Copy ${name} files for release.",
              "when": "{{'Release' in $build_type}}",
              "script": "xcopy \"${msys2_dir}\\opt\\${name}\\release\" \"$dist_dir_release\" /s /e /i /y"
            }
          ]
        },
        "post-install": {
          "scripts": [
            {
              "message": "Copy msys2 runtime files",
              "script": "copy /y \"${msys2_dir}\\ucrt64\\bin\\libwinpthread-1.dll\" \"$dist_dir_release\\bin\" > nul",
              "ignore_errors": true
            }
          ]
        }
      }
    },
    "2.7.6": {}
  }
}

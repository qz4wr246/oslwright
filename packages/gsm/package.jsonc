{
  "name": "gsm",
  "display": "gsm",
  "description": "Shared libraries for GSM 06.10 lossy speech compression",
  "site": "https://www.quut.com/gsm/",
  "license": "custom",
  "info": "info.md",
  "process_time": 440,
  "options": [
    {
      "display": "Version",
      "name": "version",
      "type": "choice",
      "items": "{{$versions}}",
      "default": "$latest_version"
    },
    {
      "display": "Visual Studio version",
      "name": "msvc_version",
      "type": "choice",
      "items": "{{$msvc_versions}}",
      "default": "$msvc_version_default"
    },
    {
      "display": "MSVC toolset version",
      "name": "msvc_toolset_version",
      "type": "choice",
      "items": "{{$msvc_toolset_versions}}",
      "default": "$msvc_toolset_version_default"
    },
    {
      "display": "Build arch",
      "name": "build_arch",
      "type": "choice",
      "items": [
        "x64",
        "x32"
      ],
      "default": "$build_arch_default"
    },
    {
      "display": "MSVC runtime library",
      "name": "msvc_runtime_library",
      "type": "choice",
      "items": [
        "mt",
        "md"
      ],
      "default": "$msvc_runtime_library_default"
    },
    {
      "display": "Build library",
      "name": "build_library",
      "enable": false,
      "type": "choice",
      "items": [
        "shared",
        "static"
      ],
      "default": "shared"
    },
    {
      "display": "Build type",
      "name": "build_type",
      "type": "choice",
      "items": [
        "Release",
        "Debug"
      ],
      "default": "Release"
    },
    {
      "display": "Build layout",
      "name": "build_layout",
      "enable": false,
      "type": "choice",
      "items": [
        "union",
        "separation"
      ],
      "default": "separation"
    },
    {
      "display": "Using CUDA",
      "name": "cuda_enable",
      "enable": false,
      "type": "bool",
      "default": false
    },
    {
      "display": "CUDA Version",
      "name": "cuda_version",
      "enable": "{{$cuda_enable}}",
      "type": "choice",
      "items": "{{$cuda_versions}}",
      "default": "{{$cuda_version_default}}"
    }
  ],
  "versions": {
    "default": {
      "dist_name": "${name}-${version}{{'' if $build_library == 'interface' else '-' + $build_arch + '-' + $msvc_toolset_version + '-' + $msvc_runtime_library + (('-cu' + $cuda_version.replace('.','')) if $cuda_enable else '') + ('-static' if 'static' == $build_library else '')}}",
      "dist_name_debug": "${dist_name}{{'-debug' if $build_layout == 'separation' else ''}}",
      "dist_name_release": "${dist_name}{{'-release' if $build_layout == 'separation' else ''}}",
      "build_dir_debug": "${source_rootdir}\\${dist_name_debug}-build",
      "build_dir_release": "${source_rootdir}\\${dist_name_release}-build",
      "dist_dir_debug": "${dist_rootdir}\\${dist_name_debug}",
      "dist_dir_release": "${dist_rootdir}\\${dist_name_release}",
      "cache_file": "${cache_rootdir}\\${name}-${version}.tar.gz",
      "download_url": "http://www.quut.com/${name}/${name}-${version}.tar.gz",
      "msys2_dir" : "${tools_rootdir}\\msys2\\msys64",
      "msys2_external_runtime_dir": "${msys2_dir}\\opt\\ucrt64",
      "msys2_bash": "\"${msys2_dir}\\usr\\bin\\bash.exe\" -lc ",
      "environments": {
        "LC_ALL": "C",
        "MSYS": "winsymlinks:nativestrict",
        "MSYSTEM": "MSYS",
        "CHERE_INVOKING": "1",
        // "MSYS2_PATH_TYPE": "inherit",
        "CC": "/ucrt64/bin/gcc.exe",
        "CXX": "/ucrt64/bin/g++.exe",
        "LD": "/ucrt64/bin/ld.exe",
        "AR": "/ucrt64/bin/ar.exe",
        "RANLIB": "/ucrt64/bin/ranlib.exe",
        "STRIP": "/ucrt64/bin/strip.exe",
        "NM": "/ucrt64/bin/nm.exe",
        "OBJCOPY": "/ucrt64/bin/objcopy.exe",
        "OBJDUMP": "/ucrt64/bin/objdump.exe",
        "CPPFLAGS": "-I/opt/ucrt64/include",
        "LDFLAGS": "-L/opt/ucrt64/lib",
        "SED": "/usr/bin/sed.exe",
        "PERLIO": "raw",
        "CUDA_PATH": "{{os.path.join($cuda_root, f'v{$cuda_version}')  if $cuda_enable else ''}}",
        "CUDNN_PATH": "{{os.path.join($cuda_root, f'v{$cuda_version}')  if $cuda_enable else ''}}"
      },
      "stages": {
        "download": {
          "scripts": [
            {
              "when": "{{os.path.isdir($source_dir)}}",
              "script": "rmdir /q /s \"$source_dir\""
            },
            {
              "message": "donloads",
              "when": "{{not os.path.isdir($source_dir) and not os.path.isfile($cache_file)}}",
              "script": "curl.exe --fail -L -s -o \"$cache_file\" \"$download_url\"",
              "fallback": "del /q /f \"$cache_file\""
            },
            {
              "message": "extract from cache.",
              "when": "{{not os.path.isdir($source_dir) and os.path.isfile($cache_file)}}",
              "script": "7z.exe x \"${cache_file}\" -so > \"${cache_file}.temp.tar\" && 7z.exe x \"${cache_file}.temp.tar\" -aoa -o\"${source_rootdir}\" && del \"${cache_file}.temp.tar\"",
              "fallback": "rmdir /q /s \"$source_dir\""
            }
          ]
        },
        "patch": {
          "repo_url":"https://raw.githubusercontent.com/msys2/MINGW-packages/refs/heads/master/mingw-w64-gsm",
          "patch_files": [
            {
              "remote": "$repo_url/0001-adapt-makefile-to.mingw.patch"
            },
            {
              "remote": "$repo_url/0002-adapt-config-h-to.mingw.patch"
            },
            {
              "remote": "$repo_url/0003-fix-ln.mingw.patch"
            },
            {
              "remote": "$repo_url/0004-use-cc-instead-of-gcc.patch"
            }
          ],
          "scripts": [
            {
              // Patch Script: patching source code with patch_files
              "message": "Patch ${name} source code",
              "chdir": "$source_dir",
              "script": "{{' && '.join([(f'(if not exist \"{p[\"chdir\"]}\" mkdir \"{p[\"chdir\"]}\") && pushd \"{p[\"chdir\"]}\" && ' if 'chdir' in p else '') + (f'(if not exist \"{os.path.join(cache_rootdir, name)}\" mkdir \"{os.path.join(cache_rootdir, name)}\") && (if not exist \"{os.path.join(cache_rootdir, name, b)}\" (curl.exe --fail -l -s -o \"{os.path.join(cache_rootdir, name, b)}\" \"{p[\"remote\"]}\" || exit /b 1)) && patch -t -b -p1 -i \"{os.path.join(cache_rootdir, name, b)}\"' if 'remote' in p else f'patch -t -b -p1 -i \"{p[\"local\"]}\"' if 'local' in p else f'copy \"{p[\"copy\"]}\" \"{b}\"' if 'copy' in p else f'curl.exe --fail -l -s -o \"{b}\" \"{p[\"fetch\"]}\" || exit /b 1') + f' && copy nul \"{os.path.join(source_dir, f\"__patched_{b}\")}\"' + (' && popd' if 'chdir' in p else '') for p in patch_files if p.get('when', True) is not False and (v := (p.get('remote') or p.get('local') or p.get('copy') or p.get('fetch'))) and (b := os.path.basename(v)) and not os.path.exists(os.path.join(source_dir, f'__patched_{b}'))])}}"
            },
            {
              "message": "Clean /opt/ucrt64 directory in msys2",
              "script": "rmdir /q /s \"$msys2_external_runtime_dir\" > nul",
              "ignore_errors": true
            }
          ]
        },
        "build": {
          "scripts": [
            {
              "message": "Clean /opt/${name} directory in msys2",
              "bash_script": "rm -rf /opt/${name}/*",
              "script": "${msys2_bash} \"${bash_script}\"",
              "ignore_errors": true
            },
            {
              "when": "{{'Debug' in $build_type}}",
              "script": "xcopy \"${source_dir}\" \"${build_dir_debug}\" /s /e /i /y"
            },
            {
              "when": "{{'Release' in $build_type}}",
              "script": "xcopy \"${source_dir}\" \"${build_dir_release}\" /s /e /i /y"
            },
            {
              "message": "build for debug.",
              "when": "{{'Debug' in $build_type}}",
              "chdir": "$build_dir_debug",
              "bash_script": "make -j4",
              "script": "${msys2_bash} \"${bash_script}\""
            },
            {
              "message": "build for release.",
              "when": "{{'Release' in $build_type}}",
              "chdir": "$build_dir_release",
              "bash_script": "make -j4",
              "script": "${msys2_bash} \"${bash_script}\""
            }
          ]
        },
        "install": {
          "scripts": [
            {
              "bash_script": "mkdir -p /opt/${name}/debug",
              "script": "${msys2_bash} \"${bash_script}\""
            },
            {
              "bash_script": "mkdir -p /opt/${name}/release",
              "script": "${msys2_bash} \"${bash_script}\""
            },
            {
              "when": "{{'Debug' in $build_type}}",
              "chdir": "$build_dir_debug",
              "bash_script": "install -m755 -d /opt/${name}/debug/{bin,lib,include,share/{licenses/${_realname},man/man{1,3}}}",
              "script": "${msys2_bash} \"${bash_script}\""
            },
            {
              "when": "{{'Release' in $build_type}}",
              "chdir": "$build_dir_release",
              "bash_script": "install -m755 -d /opt/${name}/release/{bin,lib,include,share/{licenses/${_realname},man/man{1,3}}}",
              "script": "${msys2_bash} \"${bash_script}\""
            },
            {
              "message": "install for debug.",
              "when": "{{'Debug' in $build_type}}",
              "chdir": "$build_dir_debug",
              "bash_script": "make -j1 INSTALL_ROOT=/opt/${name}/debug install",
              "script": "${msys2_bash} \"${bash_script}\""
            },
            {
              "message": "install for release.",
              "when": "{{'Release' in $build_type}}",
              "chdir": "$build_dir_release",
              "bash_script": "make -j1 INSTALL_ROOT=/opt/${name}/release install",
              "script": "${msys2_bash} \"${bash_script}\""
            },
            {
              "message": "Copy ${name} files for debug.",
              "when": "{{'Debug' in $build_type}}",
              "script": "xcopy \"${msys2_dir}\\opt\\${name}\\debug\" \"$dist_dir_debug\" /s /e /i /y"
            },
            {
              "message": "Copy ${name} files for release.",
              "when": "{{'Release' in $build_type}}",
              "script": "xcopy \"${msys2_dir}\\opt\\${name}\\release\" \"$dist_dir_release\" /s /e /i /y"
            }
          ]
        },
        "post-install": {
          "environments": {
            "PERLIO": "raw"
          },
          "scripts": [
            {
              "message": "Rename the library files to be MSVC-compatible.",
              "when":"{{'Debug' in $build_type}}",
              "chdir": "$dist_dir_debug\\lib",
              "script": "cmd /v:on /c \"for %f in (*.a) do (set \"n=%~nf\" & set \"n=!n:.dll=!\" & copy /y \"%f\" \"!n!.lib\" & if \"!n:~0,3!\"==\"lib\" copy /y \"%f\" \"!n:~3!.lib\")\"",
              "ignore_errors": true
            },
            {
              "message": "Rename the library files to be MSVC-compatible.",
              "when":"{{'Release' in $build_type }}",
              "chdir": "$dist_dir_release\\lib",
              "script": "cmd /v:on /c \"for %f in (*.a) do (set \"n=%~nf\" & set \"n=!n:.dll=!\" & copy /y \"%f\" \"!n!.lib\" & if \"!n:~0,3!\"==\"lib\" copy /y \"%f\" \"!n:~3!.lib\")\"",
              "ignore_errors": true
            }
          ]
        }
      }
    },
    "1.0.24": {
      "source_dir": "${source_rootdir}\\gsm-1.0-pl24"
    }
  }
}

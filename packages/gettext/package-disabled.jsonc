{
  "name": "gettext",
  "display": "gettext",
  "description": "A standard system and library for the internationalization (i18n) and localization (l10n) of software.",
  "site": "https://www.gnu.org/software/gettext/",
  "license": "GPL v3, LGPL v2.1",
  "info": "info.md",
  "process_time": 300,
  "options": [
    {
      "display": "Version",
      "name": "version",
      "type": "choice",
      "items": "{{$versions}}",
      "default": "$latest_version"
    },
    {
      "display": "Visual Studio version",
      "name": "msvc_version",
      "type": "choice",
      "items": "{{$msvc_versions}}",
      "default": "$msvc_version_default"
    },
    {
      "display": "MSVC toolset version",
      "name": "msvc_toolset_version",
      "type": "choice",
      "items": "{{$msvc_toolset_versions}}",
      "default": "$msvc_toolset_version_default"
    },
    {
      "display": "Build arch",
      "name": "build_arch",
      "type": "choice",
      "items": [
        "x64",
        "x32"
      ],
      "default": "$build_arch_default"
    },
    {
      "display": "MSVC runtime library",
      "name": "msvc_runtime_library",
      "type": "choice",
      "items": [
        "mt",
        "md"
      ],
      "default": "$msvc_runtime_library_default"
    },
    {
      "display": "Build library",
      "name": "build_library",
      "enable": false,
      "type": "choice",
      "items": [
        "shared",
        "static"
      ],
      "default": "shared"
    },
    {
      "display": "Build type",
      "name": "build_type",
      "enable": false,
      "type": "choice",
      "items": [
        "Release",
        "Debug"
      ],
      "default": "Release"
    },
    {
      "display": "Build layout",
      "name": "build_layout",
      "enable": false,
      "type": "choice",
      "items": [
        "union",
        "separation"
      ],
      "default": "separation"
    },
    {
      "display": "Using CUDA",
      "name": "cuda_enable",
      "enable": false,
      "type": "bool",
      "default": false
    },
    {
      "display": "CUDA Version",
      "name": "cuda_version",
      "enable": "{{$cuda_enable}}",
      "type": "choice",
      "items": "{{$cuda_versions}}",
      "default": "{{$cuda_version_default}}"
    }
  ],
  "versions": {
    "default": {
      "dependencies": {
        "libiconv": {
          "version": ">=1.19"
        },
        "libxml2": {
          "version": ">=2.11"
        },
        "libunistring": {
          "version": ">=1.4"
        }
      },
      "environments": {
        "LC_ALL": "C",
        "MSYS": "winsymlinks:nativestrict",
        "MSYSTEM": "MSYS",
        "CHERE_INVOKING": "1",
        // "MSYS2_PATH_TYPE": "inherit",
        "CC": "/ucrt64/bin/gcc.exe",
        "CXX": "/ucrt64/bin/g++.exe",
        "LD": "/ucrt64/bin/ld.exe",
        "AR": "/ucrt64/bin/ar.exe",
        "RANLIB": "/ucrt64/bin/ranlib.exe",
        "STRIP": "/ucrt64/bin/strip.exe",
        "NM": "/ucrt64/bin/nm.exe",
        "OBJCOPY": "/ucrt64/bin/objcopy.exe",
        "OBJDUMP": "/ucrt64/bin/objdump.exe",
        "CPPFLAGS": "-I/opt/ucrt64/include",
        "LDFLAGS": "-L/opt/ucrt64/lib",
        "CFLAGS": "-DLIBTEXTSTYLE_STATIC",
        "SED": "/usr/bin/sed.exe",
        "PERLIO": "raw",
        "CUDA_PATH": "{{os.path.join($cuda_root, f'v{$cuda_version}')  if $cuda_enable else ''}}",
        "CUDNN_PATH": "{{os.path.join($cuda_root, f'v{$cuda_version}')  if $cuda_enable else ''}}"
      },
      "source_dir": "${source_rootdir}\\${name}-${version}",
      "dist_name": "${name}-${version}{{'' if $build_library == 'interface' else '-' + $build_arch + '-' + $msvc_toolset_version + '-' + $msvc_runtime_library + (('-cu' + $cuda_version.replace('.','')) if $cuda_enable else '') + ('-static' if 'static' == $build_library else '')}}",
      "dist_name_debug": "${dist_name}{{'-debug' if $build_layout == 'separation' else ''}}",
      "dist_name_release": "${dist_name}{{'-release' if $build_layout == 'separation' else ''}}",
      "build_dir_debug": "${source_rootdir}\\${dist_name_debug}-build",
      "build_dir_release": "${source_rootdir}\\${dist_name_release}-build",
      "dist_dir_debug": "${dist_rootdir}\\${dist_name_debug}",
      "dist_dir_release": "${dist_rootdir}\\${dist_name_release}",
      "cache_file": "${cache_rootdir}\\${name}-${version}.tar.gz",
      "download_url": "https://ftp.gnu.org/pub/gnu/gettext/gettext-${version}.tar.gz",
      "msys2_dir": "${tools_rootdir}\\msys2\\msys64",
      "msys2_external_runtime_dir": "${msys2_dir}\\opt\\ucrt64",
      "msys2_bash": "\"${msys2_dir}\\usr\\bin\\bash.exe\" -lc ",
      "stages": {
        "download": {
          "scripts": [
            {
              "when": "{{os.path.isdir($source_dir)}}",
              "script": "rmdir /q /s \"$source_dir\""
            },
            {
              "message": "donloads",
              "when": "{{not os.path.isdir($source_dir) and not os.path.isfile($cache_file)}}",
              "script": "curl.exe --fail -L -s -o \"$cache_file\" \"$download_url\"",
              "fallback": "rmdir /q /s \"$source_dir\""
            },
            {
              "message": "extract from cache.",
              "when": "{{not os.path.isdir($source_dir) and os.path.isfile($cache_file)}}",
              "script": "7z.exe x \"${cache_file}\" -so > \"${cache_file}.temp.tar\" && 7z.exe x \"${cache_file}.temp.tar\" -aoa -o\"${source_rootdir}\" && del \"${cache_file}.temp.tar\"",
              "fallback": "rmdir /q /s \"$source_dir\""
            }
          ]
        },
        "patch": {
          "repo_url": "https://raw.githubusercontent.com/msys2/MSYS2-packages/refs/heads/master/gettext",
          "patch_files": [
            {
              "url": "${repo_url}/gettext-tools-tests-locale-ll-es.patch"
            },
            {
              "url": "${repo_url}/gettext-0.21.1-autopoint-V.patch"
            },
            {
              "url": "${repo_url}/gettext-0.21.1-cygwin-ftm.patch"
            },
            {
              "url": "${repo_url}/gettext-0.22-no-woe32dll-gettext-tools-configure-ac.patch"
            },
            {
              "url": "${repo_url}/gettext-0.22-no-woe32dll-m4-woe32-dll-m4.patch"
            },
            {
              "url": "${repo_url}/gettext-0.22.5-gettext-runtime-gnulib-lib-localcharset-c.patch"
            },
            {
              "url": "${repo_url}/gettext-0.22.5-gettext-runtime-gnulib-lib-localename-h.patch"
            },
            {
              "url": "${repo_url}/gettext-0.22.5-gettext-runtime-gnulib-lib-localename-unsafe-c.patch"
            },
            {
              "url": "${repo_url}/gettext-0.22.5-gettext-runtime-intl-gnulib-lib-localcharset-c.patch"
            },
            {
              "url": "${repo_url}/gettext-0.22.5-gettext-runtime-intl-gnulib-lib-localename-h.patch"
            },
            {
              "url": "${repo_url}/gettext-0.22.5-gettext-runtime-intl-gnulib-lib-localename-unsafe-c.patch"
            },
            {
              "url": "${repo_url}/gettext-0.22.5-gettext-tools-gnulib-lib-localcharset-c.patch"
            },
            {
              "url": "${repo_url}/gettext-0.22.5-gettext-tools-gnulib-lib-localename-h.patch"
            },
            {
              "url": "${repo_url}/gettext-0.22.5-gettext-tools-gnulib-lib-localename-unsafe-c.patch"
            },
            {
              "url": "${repo_url}/gettext-0.22-disable-libtextstyle.patch"
            },
            {
              "url": "${repo_url}/gettext-0.19.8.1-msys2.patch"
            }
          ],
          "msys2_require_runtimes": [
            {
              "name": "libiconv",
              "remove_prefix_pc": [
                "libiconv"
              ]
            },
            {
              "name": "libxml2",
              "remove_prefix_pc": [
                "libxml2"
              ]
            },
            {
              "name": "libunistring",
              "remove_prefix_pc": [
                "libunistring"
              ]
            }
          ],
          "scripts": [
            {
              // Patch Script: patching source code with patch_files
              "message": "Patch ${name} source code",

              "chdir": "$source_dir",
              "script": "{{' && '.join([(f'pushd \"{p[\"chdir\"]}\" && ' if \"chdir\" in p else '')+(f'(if not exist \"{os.path.join($cache_rootdir, os.path.basename(p[\"url\"]))}\" (curl.exe --fail -L -s -o \"{os.path.join($cache_rootdir, os.path.basename(p[\"url\"]))}\" \"{p[\"url\"]}\" || exit /b 1 )) && patch -t -b -p1 -i \"{os.path.join($cache_rootdir,os.path.basename(p[\"url\"]))}\" && copy nul > \"__patched__{os.path.basename(p[\"url\"])}\"' if \"url\" in p else f'patch -t -b -p1 -i \"{p[\"file\"]}\" && copy nul > \"__patched__{os.path.basename(p[\"file\"])}\"') + (' && popd ' if \"chdir\" in p else '') for p in $patch_files if p.get('when', True) and not os.path.exists('__patched__' + os.path.basename(p.get('url') or p.get('file')))])}}"
            },
            {
              "chdir": "$source_dir",
              "when": "{{not os.path.exists(os.path.join($source_dir, 'gettext-0.19.7-archive.patch'))}}",
              "script": "curl.exe --fail -L -s -o \"gettext-0.19.7-archive.patch\" \"${repo_url}/gettext-0.19.7-archive.patch\""
            },
            {
              "chdir": "${source_dir}\\gettext-tools\\misc",
              "bash_script": "mkdir -p ./archive && tar -xvf archive.dir.tar -C archive && rm -f archive.dir.tar",
              "script": "${msys2_bash} \"${bash_script}\""
            },
            {
              "chdir": "${source_dir}\\gettext-tools\\misc\\archive",
              "bash_script": "patch -p1 -i ../../../gettext-0.19.7-archive.patch",
              "script": "${msys2_bash} \"${bash_script}\""
            },
            {
              "chdir": "${source_dir}\\gettext-tools\\misc\\archive",
              "bash_script": "tar -cvf ../archive.dir.tar *",
              "script": "${msys2_bash} \"${bash_script}\""
            },
            {
              "chdir": "${source_dir}\\gettext-tools\\misc",
              "bash_script": "rm -rf archive",
              "script": "${msys2_bash} \"${bash_script}\""
            },
            {
              "message": "Clean /opt/ucrt64 directory in msys2",
              "bash_script": "rm -rf /opt/ucrt64/*",
              "script": "${msys2_bash} \"${bash_script}\"",
              "ignore_errors": false
            },
            {
              // Copy runtime Script: with msys2_require_runtimes
              "message": "Copy runtime libraries to MSYS2",
              "when": "{{'msys2_require_runtimes' in globals() and not os.path.exists(os.path.join($msys2_external_runtime_dir, '__copied__'))}}",
              "script": "{{' && '.join([f'xcopy \"{src_dir}\" \"{msys2_external_runtime_dir}\" /s /e /i /y' for dpr in [dependent_packages_release.split(';')] for item in msys2_require_runtimes if item.get('when', True) for src_dir in dpr if item['name'] in src_dir]+ [f'copy nul > \"{os.path.join(msys2_external_runtime_dir, \"__copied__\")}\"'])}}"
            },
            {
              // Rename runtime Script: with msys2_require_runtimes
              "message": "Rename library files and rewrite pc files.",
              "when": "{{'msys2_require_runtimes' in globals() and not os.path.exists(os.path.join($msys2_external_runtime_dir, '__renamed__'))}}",
              "script": "{{' && '.join([cmd for item in $msys2_require_runtimes if item.get('when', True) for cmd in ([f'ren \"{p}\" \"lib{os.path.basename(p)}\"' for n in item.get('add_prefix_lib', []) for p in glob.glob(os.path.join($msys2_external_runtime_dir, '**', n), recursive=True)] + [f'perl -i.bak -pe \"if(/^Libs:/){{ s/-l{n}\\\\b/-l{n[3:] if n.startswith(\"lib\") else n}/g }}\" \"{p}\"' for n in item.get('remove_prefix_pc', []) for p in glob.glob(os.path.join($msys2_external_runtime_dir, '**', '*.pc'), recursive=True) if os.path.isfile(p) and any(re.search(rf'^Libs:.*-l{n}\\b', l) for l in [pathlib.Path(p).read_text(errors=\"ignore\")] for l in l.splitlines())])]+[f'copy nul > \"{os.path.join($msys2_external_runtime_dir, \"__renamed__\")}\"'])}}"
            },
            {
              "message": "reconfigure in gettext",
              "chdir": "$source_dir",
              "bash_script": "libtoolize --copy --force && ./autogen.sh --skip-gnulib",
              "script": "${msys2_bash} \"${bash_script}\""
            }
          ]
        },
        "configure": {
          "config_options": [
            "--host=x86_64-w64-mingw32",
            "--disable-static",
            "--enable-shared",
            "--with-included-libcroco",
            "--with-included-libunistring",
            "--with-included-libxml",
            "--without-included-glib",
            "--with-included-gettext",
            "--without-emacs",
            "--disable-java",
            "--disable-native-java",
            "--disable-csharp",
            "--disable-openmp"
          ],
          "config_options_debug": [
            "--prefix=/opt/${name}/debug"
          ],
          "config_options_release": [
            "--prefix=/opt/${name}/release"
          ],
          "scripts": [
            {
              "when": "{{'Debug' in $build_type and $build_layout == 'separation'}}",
              "script": "del /q /s \"$build_dir_debug\" > nul",
              "ignore_errors": true
            },
            {
              "when": "{{'Release' in $build_type }}",
              "script": "del /q /s \"$build_dir_release\" > nul",
              "ignore_errors": true
            },
            {
              "when": "{{'Debug' in $build_type and not os.path.isdir($build_dir_debug)}}",
              "script": "mkdir \"$build_dir_debug\"",
              "ignore_errors": true
            },
            {
              "when": "{{'Release' in $build_type and not os.path.isdir($build_dir_release)}}",
              "script": "mkdir \"$build_dir_release\"",
              "ignore_errors": true
            },
            {
              "message": "config for debug.",
              "when": "{{'Debug' in $build_type}}",
              "environments": {
                "PATH": "{{re.sub(r'[^;]+pkg-config[^;]+', '', '%PATH%')}}"
              },
              "chdir": "$build_dir_debug",
              "bash_script": "../{{os.path.basename($source_dir)}}/configure {{' '.join($config_options)}} {{' '.join($config_options_debug)}}",
              "script": "${msys2_bash} \"${bash_script}\""
            },
            {
              "message": "config for release.",
              "when": "{{'Release' in $build_type}}",
              "environments": {
                "PATH": "{{re.sub(r'[^;]+pkg-config[^;]+', '', '%PATH%')}}"
              },
              "chdir": "$build_dir_release",
              "bash_script": "../{{os.path.basename($source_dir)}}/configure {{' '.join($config_options)}} {{' '.join($config_options_release)}}",
              "script": "${msys2_bash} \"${bash_script}\""
            }
          ]
        },
        "build": {
          "scripts": [
            {
              "message": "build for debug.",
              "when": "{{'Debug' in $build_type}}",
              "environments": {
                "PATH": "{{';'.join(['%PATH%', $dependent_dlls_debug])}}",
                "PERLIO": "raw"
              },
              "chdir": "$build_dir_debug",
              "bash_script": "make -j4",
              "script": "${msys2_bash} \"${bash_script}\""
            },
            {
              "message": "build for release.",
              "when": "{{'Release' in $build_type}}",
              "environments": {
                "PATH": "{{';'.join(['%PATH%', $dependent_dlls_release])}}",
                "PERLIO": "raw"
              },
              "chdir": "$build_dir_release",
              "bash_script": "make -j4",
              "script": "${msys2_bash} \"${bash_script}\""
            }
          ]
        },
        "install": {
          "scripts": [
            {
              "message": "install for debug.",
              "when": "{{'Debug' in $build_type}}",
              "chdir": "$build_dir_debug",
              "bash_script": "make install",
              "script": "${msys2_bash} \"${bash_script}\""
            },
            {
              "message": "install for release.",
              "when": "{{'Release' in $build_type}}",
              "chdir": "$build_dir_release",
              "bash_script": "make install",
              "script": "${msys2_bash} \"${bash_script}\""
            },
            {
              "message": "Copy ${name} files for debug.",
              "when": "{{'Debug' in $build_type}}",
              "script": "xcopy \"${msys2_dir}\\opt\\${name}\\debug\" \"$dist_dir_debug\" /s /e /i /y"
            },
            {
              "message": "Copy ${name} files for release.",
              "when": "{{'Release' in $build_type}}",
              "script": "xcopy \"${msys2_dir}\\opt\\${name}\\release\" \"$dist_dir_release\" /s /e /i /y"
            }
          ]
        },
        "post-install": {
          "pkgconfig_dir_release": "$dist_dir_release\\lib\\pkgconfig",
          "pkgconfig_dir_debug": "$dist_lib_debug\\lib\\pkgconfig",
          "environments": {
            "PERLIO": "raw"
          },
          "template_files": [
            {
              "when": "{{'Debug' in $build_type}}",
              "template": "${package_dir}\\libintl.pc.j2",
              "defines": [
                "VERSION=\"$version\""
              ],
              "output": "${pkgconfig_dir_debug}\\libintl.pc"
            },
            {
              "when": "{{'Release' in $build_type}}",
              "template": "${package_dir}\\libintl.pc.j2",
              "defines": [
                "VERSION=\"$version\""
              ],
              "output": "${pkgconfig_dir_release}\\libintl.pc"
            }
          ],
          "scripts": [
            {
              // Template Script:
              // This will render the template files specified in template_files, and the rendered result will be executed as a script. So you can generate files from templates  and execute any script after installation.
              "message": "Generate files from templates.",
              "script": "{{' && '.join([f\"(if not exist \\\"{os.path.dirname(tp['output'])}\\\" mkdir \\\"{os.path.dirname(tp['output'])}\\\") && jinja2 {(' '.join(['-D ' + d for d in tp['defines']]))} \\\"{tp['template']}\\\" > \\\"{tp['output']}\\\"\" for tp in ${template_files} if tp.get('when', True)])}}"
            },
            {
              "message": "Rename the library files to be MSVC-compatible.",
              "when": "{{'Debug' in $build_type}}",
              "chdir": "$dist_dir_debug\\lib",
              "script": "for %f in (*.dll.a) do @set \"fname=%f\" & cmd /v:on /c \"copy /y /b \"!fname!\" \"!fname:.dll.a=.lib!\"\"",
              "ignore_errors": true
            },
            {
              "message": "Rename the library files to be MSVC-compatible.",
              "when": "{{'Release' in $build_type }}",
              "chdir": "$dist_dir_release\\lib",
              "script": "for %f in (*.dll.a) do @set \"fname=%f\" & cmd /v:on /c \"copy /y /b \"!fname!\" \"!fname:.dll.a=.lib!\"\"",
              "ignore_errors": true
            }
          ]
        }
      }
    },
    "0.22.5": {}
    // "1.0": {}
  }
}

{
  "name": "zstd",
  "alias": "$name",
  "display": "Zstandard",
  "description": "Fast real-time compression algorithm",
  "site": "https://facebook.github.io/zstd",
  "license": "3-Clause BSD or GPLv2",
  "info":"info.md",
  "process_time": 80,
  "options": [
    {
      "display": "Version",
      "name": "version",
      "type": "choice",
      "items": "{{$versions}}",
      "default": "$latest_version"
    },
    {
      "display": "Visual Studio version",
      "name": "msvc_version",
      "type": "choice",
      "items": "{{$msvc_versions}}",
      "default": "$msvc_version_default"
    },
    {
      "display": "MSVC toolset version",
      "name": "msvc_toolset_version",
      "type": "choice",
      "items": "{{$msvc_toolset_versions}}",
      "default": "$msvc_toolset_version_default"
    },
    {
      "display": "Build arch",
      "name": "build_arch",
      "type": "choice",
      "items": [
        "x64",
        "x32"
      ],
      "default": "$build_arch_default"
    },
    {
      "display": "MSVC runtime library",
      "name": "msvc_runtime_library",
      "type": "choice",
      "items": [
        "mt",
        "md"
      ],
      "default": "$msvc_runtime_library_default"
    },
    {
      "display": "Build library",
      "name": "build_library",
      "type": "choice",
      "items": [
        "shared",
        "static",
        "shared;static"
      ],
      "default": "$build_library_default"
    },
    {
      "display": "Build type",
      "name": "build_type",
      "type": "choice",
      "items": [
        "Release",
        "Debug",
        "Release;Debug"
      ],
      "default": "Release"
    },
    {
      "display": "Build layout",
      "name": "build_layout",
      "type": "choice",
      "items": [
        "union",
        "separation"
      ],
      "default": "union"
    },
        {
      "display": "Using CUDA",
      "name": "cuda_enable",
      "enable": false,
      "type": "bool",
      "default": false
    },
    {
      "display": "CUDA Version",
      "name": "cuda_version",
      "enable": "{{$cuda_enable}}",
      "type": "choice",
      "items": "{{$cuda_versions}}",
      "default": "{{$cuda_version_default}}"
    },
    {
      "display": "Build programs",
      "name": "zstd_build_programs",
      "type": "bool",
      "default": false
    }
  ],
  "versions": {
    "default": {
      "dependencies": {
        "zlib": {
          "enable": "{{True if $zstd_build_programs else False}}",
          "version": ">=1.3"
        },
        "xz": {
          "enable": "{{True if $zstd_build_programs else False}}",
          "version": ">=5.6"
        }
      },
      "source_dir": "${source_rootdir}\\${name}-${version}",
      "dist_name": "${name}-${version}{{'' if $build_library == 'interface' else '-' + $build_arch + '-' + $msvc_toolset_version + '-' + $msvc_runtime_library + (('-cu' + $cuda_version.replace('.','')) if $cuda_enable else '') + ('-static' if 'static' == $build_library else '')}}",
      "dist_name_debug": "${dist_name}{{'-debug' if $build_layout == 'separation' else ''}}",
      "dist_name_release": "${dist_name}{{'-release' if $build_layout == 'separation' else ''}}",
      "build_dir_debug": "${source_rootdir}\\${dist_name_debug}-build",
      "build_dir_release": "${source_rootdir}\\${dist_name_release}-build",
      "dist_dir_debug": "${dist_rootdir}\\${dist_name_debug}",
      "dist_dir_release": "${dist_rootdir}\\${dist_name_release}",
      "cache_file": "${cache_rootdir}\\${name}-${version}.7z",
      "git_url": "https://github.com/facebook/zstd.git",
      "git_tag": "{{$version.split('@', 1)[0] if '@' in $version else 'v' + $version}}",
      "git_hash": "{{$version.split('@', 1)[1] if '@' in $version else ''}}",
      "stages": {
        "download": {
          "scripts": [
            {
              "message": "git clone.",
              "when": "{{not os.path.isdir($source_dir) and not os.path.isfile($cache_file)}}",
              "script": "git clone --no-progress --quiet -b \"$git_tag\" {{'' if $git_hash else '--depth 1'}} --single-branch --recurse --shallow-submodules $git_url \"$source_dir\"",
              "fallback": "rmdir /q /s \"$source_dir\""
            },
            {
              "message": "git checkout.",
              "when": "{{$git_hash and os.path.isdir($source_dir) and not os.path.isfile($cache_file)}}",
              "chdir": "$source_dir",
              "script": "git checkout $git_hash",
              "fallback": "rmdir /q /s \"$source_dir\""
            },
            {
              "message": "extract from cache.",
              "when": "{{not os.path.isdir($source_dir) and os.path.isfile($cache_file)}}",
              "script": "7z -sccUTF-8 x -aoa \"$cache_file\" -o\"$source_dir\"",
              "fallback": "rmdir /q /s \"$source_dir\""
            },
            {
              "message": "make cache.",
              "when": "{{not os.path.isfile($cache_file)}}",
              "script": "7z -sccUTF-8 a \"$cache_file\" \"$source_dir\\*\"",
              "fallback": "del \"$cache_file\""
            }
          ]
        },
        "patch": {
          "patch_file_01": "${package_dir}\\zstd_cmake.diff",
          "scripts": [
            {
              "when": "{{not os.path.isfile(os.path.join($source_dir, '__patched_' + os.path.basename($patch_file_01)))}}",
              "chdir": "$source_dir",
              "script": "git apply \"$patch_file_01\" && copy nul > {{'__patched_' + os.path.basename($patch_file_01)}}"
            }
          ]
        },
        "configure": {
          "cmake_genarator": "-G \"${msvc_generator}\" -A {{'Win32' if $build_arch == 'x32' else 'x64'}}",
          "cmake_options": [
            "-DCMAKE_POLICY_VERSION_MINIMUM=3.5",
            "-DCMAKE_FIND_LIBRARY_PREFIXES=\"lib\"",
            "-DCMAKE_CONFIGURATION_TYPES=\"$build_type\"",
            "-DCMAKE_DEBUG_POSTFIX=d",
            "-DZSTD_BUILD_SHARED={{'ON' if 'shared' in $build_library else 'OFF'}}",
            "-DZSTD_BUILD_STATIC={{'ON' if 'static' in $build_library else 'OFF'}}",
            "-DCMAKE_MSVC_RUNTIME_LIBRARY=\"{{'MultiThreaded$<$<CONFIG:Debug>:Debug>DLL' if $msvc_runtime_library == 'md' else 'MultiThreaded$<$<CONFIG:Debug>:Debug>'}}\"",
            "-DZSTD_LEGACY_SUPPORT=ON",
            "-DZSTD_BUILD_TESTS=OFF",
            "-DZSTD_BUILD_CONTRIB=OFF",
            "-DZSTD_MULTITHREAD_SUPPORT=ON",
            "-DZSTD_USE_STATIC_RUNTIME=OFF"
          ],
          "cmake_options_debug": [
            "-DCMAKE_INSTALL_PREFIX=\"$dist_dir_debug\"",
            "-DZSTD_BUILD_PROGRAMS=OFF"
          ],
          "cmake_options_release": [
            "-DCMAKE_INSTALL_PREFIX=\"$dist_dir_release\"",
            "-DZSTD_BUILD_PROGRAMS={{'ON' if $zstd_build_programs else 'OFF'}}",
            "-DZSTD_PROGRAMS_LINK_SHARED={{'ON' if 'shared' in $build_library else 'OFF'}}",
            "-DZSTD_ZLIB_SUPPORT={{'ON' if $zstd_build_programs else 'OFF'}}",
            "-DZSTD_LZMA_SUPPORT={{'ON' if $zstd_build_programs else 'OFF'}}",
            "-DZSTD_LZ4_SUPPORT=OFF"
          ],
          "scripts": [
            {
              "when": "{{'Debug' in $build_type and $build_layout == 'separation'}}",
              "script": "rmdir /s /q \"$build_dir_debug\" & timeout /t 3 /nobreak > nul & mkdir \"$build_dir_debug\""
            },
            {
              "when": "{{'Release' in $build_type }}",
              "script": "rmdir /s /q \"$build_dir_release\" & timeout /t 3 /nobreak > nul & mkdir \"$build_dir_release\""
            },
            {
              "message": "config for debug.",
              "when": "{{'Debug' in $build_type and $build_layout == 'separation'}}",
              "environments": {
                "CMAKE_PREFIX_PATH": "$dependent_packages_debug",
                "PKG_CONFIG_PATH": "$pkg_config_path_debug",
                "PERLIO": "raw"
              },
              "script": "cmake $cmake_genarator {{' '.join($cmake_options)}} {{' '.join($cmake_options_debug)}} -S \"$source_dir\\build\\cmake\" -B \"$build_dir_debug\""
            },
            {
              "message": "config for release.",
              "when": "{{'Release' in $build_type}}",
              "environments": {
                "CMAKE_PREFIX_PATH": "$dependent_packages_release",
                "PKG_CONFIG_PATH": "$pkg_config_path_release",
                "PERLIO": "raw"
              },
              "script": "cmake $cmake_genarator {{' '.join($cmake_options)}} {{' '.join($cmake_options_release)}} -S \"$source_dir\\build\\cmake\" -B \"$build_dir_release\""
            }
          ]
        },
        "build": {
          "scripts": [
            {
              "message": "build for debug.",
              "when": "{{'Debug' in $build_type}}",
              "script": "cmake --build \"$build_dir_debug\" --config Debug -j4"
            },
            {
              "message": "build for release.",
              "when": "{{'Release' in $build_type}}",
              "script": "cmake --build \"$build_dir_release\" --config Release -j4"
            }
          ]
        },
        "install": {
          "scripts": [
            {
              "message": "install for debug.",
              "when": "{{'Debug' in $build_type}}",
              "script": "cmake --install \"$build_dir_debug\" --config Debug"
            },
            {
              "message": "install for release.",
              "when": "{{'Release' in $build_type}}",
              "script": "cmake --install \"$build_dir_release\" --config Release"
            }
          ]
        },
        "post-install" :{
          "dist_rootdir_slash":"{{$dist_rootdir.replace('\\\\', '/')}}",
          "environments": {
            "PERLIO": "raw"
          },
          "scripts": [
            {
              "when": "{{'Debug' in $build_type}}",
              "script": "forfiles -P \"$dist_dir_debug\" /M *.pc /S /C \"cmd /c perl ${assets_rootdir}\\fix_pcfile.pl @PATH 0x22{{dist_rootdir.replace('\\\\', '/')}}0x22\"",
              "ignore_errors": true
            },
            {
              "when": "{{'Release' in $build_type}}",
              "script": "forfiles -P \"$dist_dir_release\" /M *.pc /S /C \"cmd /c perl ${assets_rootdir}\\fix_pcfile.pl @PATH 0x22{{dist_rootdir.replace('\\\\', '/')}}0x22\"",
              "ignore_errors": true
            }
          ]
        }
      }
    },
    "1.5.6": {}
  }
}

{
  "name": "libdvdnav",
  "display": "libdvdnav",
  "description": "The library for xine-dvdnav plugin",
  "site": "https://www.videolan.org/developers/libdvdnav.html",
  "license": "GPL 2.0 or later",
  "info":"info.md",
  "process_time": 30,
  "options": [
    {
      "display": "Version",
      "name": "version",
      "type": "choice",
      "items": "{{$versions}}",
      "default": "$latest_version"
    },
    {
      "display": "Visual Studio version",
      "name": "msvc_version",
      "type": "choice",
      "items": "{{$msvc_versions}}",
      "default": "$msvc_version_default"
    },
    {
      "display": "MSVC toolset version",
      "name": "msvc_toolset_version",
      "type": "choice",
      "items": "{{$msvc_toolset_versions}}",
      "default": "$msvc_toolset_version_default"
    },
    {
      "display": "Build arch",
      "name": "build_arch",
      "type": "choice",
      "items": [
        "x64",
        "x32"
      ],
      "default": "$build_arch_default"
    },
    {
      "display": "MSVC runtime library",
      "name": "msvc_runtime_library",
      "type": "choice",
      "items": [
        "mt",
        "md"
      ],
      "default": "$msvc_runtime_library_default"
    },
    {
      "display": "Build library",
      "name": "build_library",
      "enable": false,
      "type": "choice",
      "items": [
        "shared",
        "static"
      ],
      "default": "shared"
    },
    {
      "display": "Build type",
      "name": "build_type",
      "type": "choice",
      "items": [
        "Release",
        "Debug"
      ],
      "default": "Release"
    },
    {
      "display": "Build layout",
      "name": "build_layout",
      "enable": false,
      "type": "choice",
      "items": [
        "separation"
      ],
      "default": "separation"
    },
    {
      "display": "Using CUDA",
      "name": "cuda_enable",
      "enable": false,
      "type": "bool",
      "default": false
    },
    {
      "display": "CUDA Version",
      "name": "cuda_version",
      "enable": "{{$cuda_enable}}",
      "type": "choice",
      "items": "{{$cuda_versions}}",
      "default": "{{$cuda_version_default}}"
    }
  ],
  "versions": {
    "default": {
      "source_dir": "${source_rootdir}\\${name}-${version}",
      "dist_name": "${name}-${version}{{'' if $build_library == 'interface' else '-' + $build_arch + '-' + $msvc_toolset_version + '-' + $msvc_runtime_library + (('-cu' + $cuda_version.replace('.','')) if $cuda_enable else '') + ('-static' if 'static' == $build_library else '')}}",
      "dist_name_debug": "${dist_name}{{'-debug' if $build_layout == 'separation' else ''}}",
      "dist_name_release": "${dist_name}{{'-release' if $build_layout == 'separation' else ''}}",
      "build_dir_debug": "${source_rootdir}\\${dist_name_debug}-build",
      "build_dir_release": "${source_rootdir}\\${dist_name_release}-build",
      "dist_dir_debug": "${dist_rootdir}\\${dist_name_debug}",
      "dist_dir_release": "${dist_rootdir}\\${dist_name_release}",
      "cache_file": "${cache_rootdir}\\${name}-${version}.7z",
      "git_url": "https://code.videolan.org/videolan/libdvdnav.git",
      "git_tag": "{{$version.split('@', 1)[0] if '@' in $version else $version}}",
      "git_hash": "{{$version.split('@', 1)[1] if '@' in $version else ''}}",
      "msys2_dir" : "${tools_rootdir}\\msys2\\msys64",
      "msys2_external_runtime_dir": "${msys2_dir}\\opt\\ucrt64",
      "msys2_bash": "\"${msys2_dir}\\usr\\bin\\bash.exe\" -lc ",
      "dependencies": {
          "libdvdread": {
            "version": ">=7.0"
          }
      },
      "environments": {
        "LC_ALL": "C",
        "MSYS": "winsymlinks:nativestrict",
        "MSYSTEM": "UCRT64",
        "CHERE_INVOKING": "1",
        // "MSYS2_PATH_TYPE": "inherit",
        "CC": "/ucrt64/bin/gcc.exe",
        "CXX": "/ucrt64/bin/g++.exe",
        "LD": "/ucrt64/bin/ld.exe",
        "AS": "/ucrt64/bin/nasm.exe",
        "AR": "/ucrt64/bin/ar.exe",
        "RANLIB": "/ucrt64/bin/ranlib.exe",
        "STRIP": "/ucrt64/bin/strip.exe",
        "NM": "/ucrt64/bin/nm.exe",
        "OBJCOPY": "/ucrt64/bin/objcopy.exe",
        "OBJDUMP": "/ucrt64/bin/objdump.exe",
        "CPPFLAGS": "-I/opt/ucrt64/include",
        "CFLAGS": "-Wno-incompatible-pointer-types",
        "ASFLAGS": "-w-all",
        "LDFLAGS": "-L/opt/ucrt64/lib",
        "SED": "/usr/bin/sed.exe",
        "PERLIO": "raw",
        "CUDA_PATH": "{{os.path.join($cuda_root, f'v{$cuda_version}') if $cuda_enable else ''}}",
        "CUDNN_PATH": "{{os.path.join($cuda_root, f'v{$cuda_version}') if $cuda_enable else ''}}"
      },
      "stages": {
        "download": {
          "scripts": [
            {
              "when": "{{os.path.isdir($source_dir)}}",
              "script": "rmdir /q /s \"$source_dir\""
            },
            {
              "message": "git clone.",
              "when": "{{not os.path.isdir($source_dir) and not os.path.isfile($cache_file)}}",
              "script": "git clone --no-progress --quiet -b \"$git_tag\" {{'' if $git_hash else '--depth 1'}} --single-branch --recurse --shallow-submodules $git_url \"$source_dir\"",
              "fallback": "rmdir /q /s \"$source_dir\""
            },
            {
              "message": "git checkout.",
              "when": "{{$git_hash and os.path.isdir($source_dir) and not os.path.isfile($cache_file)}}",
              "chdir": "$source_dir",
              "script": "git checkout $git_hash",
              "fallback": "rmdir /q /s \"$source_dir\""
            },
            {
              "message": "extract from cache.",
              "when": "{{not os.path.isdir($source_dir) and os.path.isfile($cache_file)}}",
              "script": "7z -sccUTF-8 x -aoa \"$cache_file\" -o\"$source_dir\"",
              "fallback": "rmdir /q /s \"$source_dir\""
            },
            {
              "message": "make cache.",
              "when": "{{not os.path.isfile($cache_file)}}",
              "script": "7z -sccUTF-8 a \"$cache_file\" \"$source_dir\\*\"",
              "fallback": "del \"$cache_file\""
            }
          ]
        },
        // "patch": {
        //   "patch_files": [
        //     {
        //       "url": "https://code.videolan.org/videolan/libdvdnav/-/merge_requests/64.patch"
        //     }
        //   ],
        //   "scripts": [
        //     {
        //       // Patch Script: patching source code with patch_files
        //       "message": "Patch ${name} source code",
        //       "chdir": "$source_dir",
        //       "script": "{{' && '.join([(f'pushd \"{p[\"chdir\"]}\" && ' if 'chdir' in p else '') + (f'(if not exist \"{c}\" (curl.exe --fail -l -s -o \"{c}\" \"{p[\"url\"]}\" || exit /b 1 )) && patch -t -b -p1 -i \"{c}\"' if 'url' in p and (c := os.path.join(cache_rootdir, b)) else f'patch -t -b -p1 -i \"{p[\"file\"]}\"' if 'file' in p else f'copy /y \"{p[\"copy\"]}\" \"{os.path.basename(p[\"copy\"])}\"') + f' && copy nul \"__patched___{b}\"' + (' && popd' if 'chdir' in p else '') for p in patch_files if p.get('when', True) and (b := os.path.basename(p.get('url') or p.get('file') or p.get('copy'))) and not os.path.exists(f'__patched__{b}')])}}"
        //     }
        //   ]
        // },
        "configure": {
          "meson_options": [
            "--vsenv",
            "--pkgconfig.relocatable",
            "--default-library={{'static' if $build_library == 'static' else 'shared'}}",
            "-Db_vscrt={{'from_buildtype' if $msvc_runtime_library == 'md' else 'static_from_buildtype'}}",
            "--wrap-mode=nodownload",
            "--auto-features=enabled"
          ],
          "meson_options_debug" : [
            "--prefix=/opt/${name}/debug",
            "--buildtype debug"
          ],
          "meson_options_release" : [
            "--prefix=/opt/${name}/release",
            "--buildtype release"
          ],
          "scripts": [
            {
              "message": "Clean /opt directory in msys2",
              "bash_script": "rm -rf /opt/*",
              "script": "${msys2_bash} \"${bash_script}\"",
              "ignore_errors": true
            },
            {
              "message": "Copy runtime libraries to MSYS2",
              "when": "{{not os.path.exists(os.path.join($msys2_external_runtime_dir, '__copied__'+ $name)) and len($dependent_packages_release)}}",
              "chdir": "$source_dir",
              "script": "{{[ (f.write('\\n'.join([f'xcopy \\\"{dpr}\\\" \\\"{msys2_external_runtime_dir}\\\" /s /e /i /y || exit /b 1' for dpr in dependent_packages_release.split(';')])), f.close(), '')[-1] for f in [open(os.path.join($source_dir,'__copy_packages.bat'), 'w', encoding='cp932',newline='\\r\\n')] ][0]}}\"$source_dir\\__copy_packages.bat\" && copy nul > \"$msys2_external_runtime_dir\\__copied__$name\""
            },
            {
              "when": "{{'Debug' in $build_type and $build_layout == 'separation'}}",
              "script": "rmdir /q /s \"$build_dir_debug\" > nul",
              "ignore_errors": true
            },
            {
              "when": "{{'Release' in $build_type }}",
              "script": "rmdir /q /s \"$build_dir_release\" > nul",
              "ignore_errors": true
            },
            {
              "when": "{{'Debug' in $build_type and not os.path.isdir($build_dir_debug)}}",
              "script": "mkdir \"$build_dir_debug\"",
              "ignore_errors": true
            },
            {
              "when": "{{'Release' in $build_type and not os.path.isdir($build_dir_release)}}",
              "script": "mkdir \"$build_dir_release\"",
              "ignore_errors": true
            },
            {
              "message": "config for debug.",
              "when": "{{'Debug' in $build_type}}",
              "environments": {
                "PATH":"{{re.sub(r'[^;]+pkg-config[^;]+', '', '%PATH%')}}"
              },
              "chdir": "$build_dir_debug",
              "bash_script": "meson setup {{' '.join($meson_options)}} {{' '.join($meson_options_debug)}} '$build_dir_debug' '$source_dir'",
              "script": "${msys2_bash} \"${bash_script}\""
            },
            {
              "message": "config for release.",
              "when": "{{'Release' in $build_type}}",
              "environments": {
                "PATH":"{{re.sub(r'[^;]+pkg-config[^;]+', '', '%PATH%')}}"
              },
              "chdir": "$build_dir_release",
              "bash_script": "meson setup {{' '.join($meson_options)}} {{' '.join($meson_options_release)}} '$build_dir_release' '$source_dir'",
              "script": "${msys2_bash} \"${bash_script}\""
            }
          ]
        },
        "build": {
          "scripts": [
            {
              "message": "Clean /opt/${name} directory in msys2",
              "bash_script": "rm -rf /opt/${name}/*",
              "script": "${msys2_bash} \"${bash_script}\"",
              "ignore_errors": true
            },
            {
              "message": "build for debug.",
              "when": "{{'Debug' in $build_type}}",
              "environments": {
                "PATH": "{{';'.join(['%PATH%', $dependent_dlls_debug])}}",
                "PERLIO": "raw"
              },
              "chdir": "$build_dir_debug",
              "bash_script": "meson compile -C '$build_dir_debug' -j 4",
              "script": "${msys2_bash} \"${bash_script}\""
            },
            {
              "message": "build for release.",
              "when": "{{'Release' in $build_type}}",
              "environments": {
                "PATH": "{{';'.join(['%PATH%', $dependent_dlls_release])}}",
                "PERLIO": "raw"
              },
              "chdir": "$build_dir_release",
              "bash_script": "meson compile -C '$build_dir_release' -j 4",
              "script": "${msys2_bash} \"${bash_script}\""
            }
          ]
        },
        "install": {
          "meson_install_options": [
            "--tags devel,runtime,bin"
          ],
          "scripts": [
            {
              "message": "build for debug.",
              "when": "{{'Debug' in $build_type}}",
              "chdir": "$build_dir_debug",
              "bash_script": "meson install -C '$build_dir_debug' {{' '.join($meson_install_options)}}",
              "script": "${msys2_bash} \"${bash_script}\""
            },
            {
              "message": "build for release.",
              "when": "{{'Release' in $build_type}}",
              "chdir": "$build_dir_release",
              "bash_script": "meson install -C '$build_dir_release' {{' '.join($meson_install_options)}}",
              "script": "${msys2_bash} \"${bash_script}\""
            },
            {
              "message": "Copy ${name} files for debug.",
              "when": "{{'Debug' in $build_type}}",
              "script": "xcopy \"${msys2_dir}\\opt\\${name}\\debug\" \"$dist_dir_debug\" /s /e /i /y"
            },
            {
              "message": "Copy ${name} files for release.",
              "when": "{{'Release' in $build_type}}",
              "script": "xcopy \"${msys2_dir}\\opt\\${name}\\release\" \"$dist_dir_release\" /s /e /i /y"
            }
          ]
        },
        "post-install": {
          "dist_rootdir_slash": "{{$dist_rootdir.replace('\\\\', '/')}}", // adjust path for pc file
          "scripts": [
            {
              "message": "Rename the library files to be MSVC-compatible.",
              "when":"{{'Debug' in $build_type}}",
              "chdir": "$dist_dir_debug\\lib",
              "script": "cmd /v:on /c \"for %f in (*.a) do (set \"n=%~nf\" & set \"n=!n:.dll=!\" & copy /y \"%f\" \"!n!.lib\" & if \"!n:~0,3!\"==\"lib\" copy /y \"%f\" \"!n:~3!.lib\")\"",
              "ignore_errors": true
            },
            {
              "message": "Rename the library files to be MSVC-compatible.",
              "when":"{{'Release' in $build_type }}",
              "chdir": "$dist_dir_release\\lib",
              "script": "cmd /v:on /c \"for %f in (*.a) do (set \"n=%~nf\" & set \"n=!n:.dll=!\" & copy /y \"%f\" \"!n!.lib\" & if \"!n:~0,3!\"==\"lib\" copy /y \"%f\" \"!n:~3!.lib\")\"",
              "ignore_errors": true
            },
            {
              "message": "Adjust paths and other configurations in *.pc",
              "when": "{{'Debug' in $build_type}}",
              "script": "forfiles -P \"$dist_dir_debug\" /M *.pc /S /C \"cmd /c perl ${assets_rootdir}\\fix_pcfile.pl @PATH 0x22${dist_rootdir_slash}0x22\"",
              "ignore_errors": true
            },
            {
              "message": "Adjust paths and other configurations in *.pc",
              "when": "{{'Release' in $build_type}}",
              "script": "forfiles -P \"$dist_dir_release\" /M *.pc /S /C \"cmd /c perl ${assets_rootdir}\\fix_pcfile.pl @PATH 0x22${dist_rootdir_slash}0x22\"",
              "ignore_errors": true
            }
          ]
        }
      }
    },
    "7.0.0": {}
  }
}

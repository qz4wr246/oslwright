{
  "name": "postgresql",
  "display": "PostgreSQL",
  "description": "The World's Most Advanced Open Source Relational Database",
  "site": "https://facebook.github.io/zstd",
  "license": " PostgreSQL License",
  "info":"info.md",
  "process_time": "700",
  "settings": [
    {
      "display": "Version",
      "name": "version",
      "type": "chose",
      "item": "{{$versions}}",
      "default": "$latest_version"
    },
    {
      "display": "Build arch",
      "name": "build_arch",
      "type": "chose",
      "item": [
        "x64",
        "x32"
      ],
      "default": "$build_arch_default"
    },
    {
      "display": "MSVC toolset version",
      "name": "msvc_toolset_version",
      "type": "chose",
      "item": "{{$msvc_toolset_versions}}",
      "default": "$msvc_toolset_version_default"
    },
    {
      "display": "MSVC runtime library",
      "name": "msvc_runtime_library",
      "type": "chose",
      "item": [
        "mt",
        "md"
      ],
      "default": "$msvc_runtime_library_default"
    },
    {
      "display": "Build library",
      "name": "build_library",
      "type": "chose",
      "item": [
        "shared",
        "static"
      ],
      "default": "$build_library_default"
    },
    {
      "display": "Build type",
      "name": "build_type",
      "type": "chose",
      "item": [
        "Release",
        "Debug",
        "Release;Debug"
      ],
      "default": "Release"
    },
    {
      "display": "Build layout",
      "name": "build_layout",
      "type": "chose",
      "item": [
        "separation"
      ],
      "default": "separation"
    },
        {
      "display": "Using CUDA",
      "name": "cuda_enable",
      "enable": false,
      "type": "bool",
      "default": false
    },
    {
      "display": "CUDA Version",
      "name": "cuda_version",
      "enable": false,
      "type": "chose",
      "item": "{{$cuda_versions}}",
      "default": "{{$cuda_version_default}}"
    },
    // {
    //   "display": "Build libpq only",
    //   "name": "build_libpq_only",
    //   "type": "bool",
    //   "default": true
    // }
  ],
  "versions": {
    "default": {
      "dependencies": {
        "libxml2": {
          "version": ">=2.11"
        },
        "libxslt": {
          "version": ">=1.1"
        },
        "openssl": {
          "version": ">=3.3"
        },
        "icu4c": {
          "version": ">=75"
        },
        "zlib": {
          "version": ">=1.3"
        },
        "zstd": {
          "version": ">=1.5"
        }
      },
      "source_dir": "${source_rootdir}\\${name}-${version}",
      "dist_name": "${name}-${version}{{'' if $build_library == 'interface' else '-' + $build_arch + '-' + $msvc_toolset_version + '-' + $msvc_runtime_library + (('-cu' + $cuda_version.replace('.','')) if $cuda_enable else '') + ('-static' if 'static' == $build_library else '')}}",
      "dist_name_debug": "${dist_name}{{'-debug' if $build_layout == 'separation' else ''}}",
      "dist_name_release": "${dist_name}{{'-release' if $build_layout == 'separation' else ''}}",
      "build_dir_debug": "${source_rootdir}\\${dist_name_debug}-build",
      "build_dir_release": "${source_rootdir}\\${dist_name_release}-build",
      "dist_dir_debug": "${dist_rootdir}\\${dist_name_debug}",
      "dist_dir_release": "${dist_rootdir}\\${dist_name_release}",
      "cache_file": "${cache_rootdir}\\${name}-${version}.tar.bz2",
      "download_url": "https://ftp.postgresql.org/pub/source/v${version}/postgresql-${version}.tar.bz2",
      "stages": {
        "download": {
          "scripts": [
            {
              "message": "donloads",
              "when": "{{not os.path.isdir($source_dir) and not os.path.isfile($cache_file)}}",
              "script": "curl.exe -L -s -o \"$cache_file\" \"$download_url\"",
              "failed": "rmdir /q /s \"$source_dir\""
            },
            {
              "message": "extruct from cache.",
              "when": "{{not os.path.isdir($source_dir) and os.path.isfile($cache_file)}}",
              "script": "7z x \"$cache_file\" -so| 7z x -aoa -si -ttar -o\"$source_rootdir\"",
              "failed": "rmdir /q /s \"$source_dir\""
            }
          ]
        },
        "configure": {
          "meson_options": [
            "--vsenv",
            "--pkgconfig.relocatable",
            "--default-library={{'static' if $build_library == 'static' else 'shared'}}",
            "-Db_vscrt={{'from_buildtype' if $msvc_runtime_library == 'md' else 'static_from_buildtype'}}"
          ],
          "meson_options_debug" : [
            "--prefix=\"$dist_dir_debug\"",
            "--buildtype debug"
          ],
          "meson_options_release" : [
            "--prefix=\"$dist_dir_release\"",
            "--buildtype release"
          ],
          "scripts": [
            {
              "ignore_errors": true,
              "when": "{{'Debug' in $build_type and $build_layout == 'separation'}}",
              "script": "del /q /s \"$build_dir_debug\" > nul"
            },
            {
              "ignore_errors": true,
              "when": "{{'Release' in $build_type}}",
              "script": "del /q /s \"$build_dir_release\" > nul"
            },
            {
              "ignore_errors": true,
              "when": "{{'Debug' in $build_type and not os.path.isdir($build_dir_debug)}}",
              "script": "mkdir \"$build_dir_debug\""
            },
            {
              "ignore_errors": true,
              "when": "{{'Release' in $build_type and not os.path.isdir($build_dir_release)}}",
              "script": "mkdir \"$build_dir_release\""
            },
            {
              "message": "config for debug.",
              "when": "{{'Debug' in $build_type}}",
              "environments": {
                "CMAKE_PREFIX_PATH": "$dependent_packages_debug",
                "PKG_CONFIG_PATH": "$pkg_config_path_debug",
                "PERLIO": "raw"
              },
              "script": "meson setup {{' '.join($meson_options)}} {{' '.join($meson_options_debug)}}  \"$build_dir_debug\" \"$source_dir\""
            },
            {
              "message": "config for release.",
              "when": "{{'Release' in $build_type}}",
              "environments": {
                "CMAKE_PREFIX_PATH": "$dependent_packages_release",
                "PKG_CONFIG_PATH": "$pkg_config_path_release",
                "PERLIO": "raw"
              },
              "script": "meson setup {{' '.join($meson_options)}} {{' '.join($meson_options_release)}} \"$build_dir_release\" \"$source_dir\""
            }
          ]
        },
        "build": {
          "scripts": [
            {
              "message": "build for debug.",
              "when": "{{'Debug' in $build_type}}",
              "environments": {
                "PATH": "{{';'.join(['%PATH%', $dependent_dlls_debug])}}",
                "PERLIO": "raw"
              },
              "script": "meson compile -C \"$build_dir_debug\" -j 4"
            },
            {
              "message": "build for release.",
              "when": "{{'Release' in $build_type}}",
              "environments": {
                "PATH": "{{';'.join(['%PATH%', $dependent_dlls_release])}}",
                "PERLIO": "raw"
              },
              "script": "meson compile -C \"$build_dir_release\" -j 4"
            }
          ]
        },
        "install": {
          "meson_install_options": [
            "--tags devel,runtime,bin"
          ],
          "scripts": [
            {
              "message": "install for debug.",
              "when": "{{'Debug' in $build_type}}",
              "script": "meson install -C \"$build_dir_debug\" {{' '.join($meson_install_options)}}"
            },
            {
              "message": "install for release.",
              "when": "{{'Release' in $build_type}}",
              "script": "meson install -C \"$build_dir_release\" {{' '.join($meson_install_options)}}"
            }
          ]
        },
        "post-install" :{
          "dist_rootdir_slash":"{{$dist_rootdir.replace('\\\\', '/')}}",
          "environments": {
            "PERLIO": "raw"
          },
          "scripts": [
            {
              "ignore_errors": true,
              "when": "{{'Debug' in $build_type}}",
              "script": "forfiles -P \"$dist_dir_debug\" /M *.pc /S /C \"cmd /c perl -p -i -e 0x22s#^prefix=.*#prefix=\\$${pcfiledir}/../..#g;s#^exec_prefix=.*#exec_prefix=\\$${prefix}#g;s#^libdir=.*#libdir=\\$${prefix}/lib#g;s#^includedir=.*#includedir=\\$${prefix}/include#g0x22 @PATH\""
            },
            {
              "ignore_errors": true,
              "when": "{{'Debug' in $build_type}}",
              "script": "forfiles -P \"$dist_dir_debug\" /M *.pc /S /C \"cmd /c perl -p -i -e 0x22s#$dist_rootdir_slash#\\$${prefix}/..#g0x22 @PATH\""
            },
            {
              "ignore_errors": true,
              "when": "{{'Release' in $build_type}}",
              "script": "forfiles -P \"$dist_dir_release\" /M *.pc /S /C \"cmd /c perl -p -i -e 0x22s#^prefix=.*#prefix=\\$${pcfiledir}/../..#g;s#^exec_prefix=.*#exec_prefix=\\$${prefix}#g;s#^libdir=.*#libdir=\\$${prefix}/lib#g;s#^includedir=.*#includedir=\\$${prefix}/include#g0x22 @PATH\""
            },
            {
              "ignore_errors": true,
              "when": "{{'Release' in $build_type}}",
              "script": "forfiles -P \"$dist_dir_release\" /M *.pc /S /C \"cmd /c perl -p -i -e 0x22s#$dist_rootdir_slash#\\$${prefix}/..#g0x22 @PATH\""
            }
          ]
        }
      }
    },
    "17.6": {}
  }
}
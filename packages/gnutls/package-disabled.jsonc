{
  "name": "gnutls",
  "display": "GnuTLS",
  "description": "TLS/SSL and crypto library",
  "site": "https://www.gnutls.org/",
  "license": "LGPL 2.1+",
  "info": "info.md",
  "process_time": 6700,
  "options": [
    {
      "display": "Version",
      "name": "version",
      "type": "choice",
      "items": "{{$versions}}",
      "default": "$latest_version"
    },
    {
      "display": "Visual Studio version",
      "name": "msvc_version",
      "type": "choice",
      "items": "{{$msvc_versions}}",
      "default": "$msvc_version_default"
    },
    {
      "display": "MSVC toolset version",
      "name": "msvc_toolset_version",
      "type": "choice",
      "items": "{{$msvc_toolset_versions}}",
      "default": "$msvc_toolset_version_default"
    },
    {
      "display": "Build arch",
      "name": "build_arch",
      "type": "choice",
      "items": [
        "x64",
        "x32"
      ],
      "default": "$build_arch_default"
    },
    {
      "display": "MSVC runtime library",
      "name": "msvc_runtime_library",
      "enable": false,
      "type": "choice",
      "items": [
        "mt",
        "md"
      ],
      "default": "md"
    },
    {
      "display": "Build library",
      "name": "build_library",
      "enable": false,
      "type": "choice",
      "items": [
        "shared",
        "static"
      ],
      "default": "shared"
    },
    {
      "display": "Build type",
      "name": "build_type",
      "enable": false,
      "type": "choice",
      "items": [
        "Release",
        "Debug",
        "Release;Debug"
      ],
      "default": "Release"
    },
    {
      "display": "Build layout",
      "name": "build_layout",
      "enable": false,
      "type": "choice",
      "items": [
        "union",
        "separation"
      ],
      "default": "separation"
    },
    {
      "display": "Using CUDA",
      "name": "cuda_enable",
      "enable": false,
      "type": "bool",
      "default": false
    },
    {
      "display": "CUDA Version",
      "name": "cuda_version",
      "enable": "{{$cuda_enable}}",
      "type": "choice",
      "items": "{{$cuda_versions}}",
      "default": "{{$cuda_version_default}}"
    },
    {
      "display": "With Zlib",
      "name": "with_zlib",
      "type": "bool",
      "default": true
    },
    {
      "display": "With brotli",
      "name": "with_brotli",
      "type": "bool",
      "default": true
    },
      {
      "display": "With zstd",
      "name": "with_zstd",
      "type": "bool",
      "default": true
    },
  ],
  "versions": {
    "default": {
      "dependencies": {
        "zlib": {
          "enable": "{{$with_zlib}}",
          "version": ">=1.3"
        },
        "brotli": {
          "enable": "{{$with_brotli}}",
          "version": ">=1.1",
          "build_library":"shared"
        },
        "zstd": {
          "enable": "{{$with_zstd}}",
          "version": ">=1.5",
          "build_library":"shared"
        }
      },
      "environments": {
        "LC_ALL": "C",
        "PERLIO": "raw"
      },
      "source_dir": "${source_rootdir}\\${name}-${version}",
      "gnutls_source_dir": "${source_dir}\\gnutls",
      "dist_name": "${name}-${version}{{'' if $build_library == 'interface' else '-' + $build_arch + '-' + $msvc_toolset_version + '-' + $msvc_runtime_library + (('-cu' + $cuda_version.replace('.','')) if $cuda_enable else '') + ('-static' if 'static' == $build_library else '')}}",
      "dist_name_debug": "${dist_name}{{'-debug' if $build_layout == 'separation' else ''}}",
      "dist_name_release": "${dist_name}{{'-release' if $build_layout == 'separation' else ''}}",
      "gnutls_build_dir_debug": "${source_rootdir}\\${dist_name}-debug\\gnutls",
      "gnutls_build_dir_release": "${source_rootdir}\\${dist_name}-release\\gnutls",
      "dist_dir_debug": "${dist_rootdir}\\${dist_name_debug}",
      "dist_dir_release": "${dist_rootdir}\\${dist_name_release}",
      "cache_file": "${cache_rootdir}\\${name}-${version}.7z",
      "git_url": "https://gitlab.com/gnutls/gnutls.git",
      "git_tag": "{{$version.split('@', 1)[0] if '@' in $version else $version}}",
      "git_hash": "{{$version.split('@', 1)[1] if '@' in $version else ''}}",
      "msys2_dir" : "${tools_rootdir}\\msys2\\msys64",
      "msys2_bash_ob": "cmd.exe /c \"set \"MSYSTEM=UCRT64\" && set \"CHERE_INVOKING=1\" && \"${msys2_dir}\\usr\\bin\\bash.exe\" -lc ",
      "msys2_bash_cb": "\"",
      "stages": {
        "download": {
          "scripts": [
            {
              "when": "{{os.path.isdir($source_dir)}}",
              "script": "rmdir /q /s \"$source_dir\""
            },
            {
              "message": "[gnutls] git clone.",
              "when": "{{not os.path.isdir($gnutls_source_dir) and not os.path.isfile($cache_file)}}",
              "script": "git clone --no-progress --quiet -b \"$git_tag\" {{'' if $git_hash else '--depth 1'}} --single-branch --recurse --shallow-submodules $git_url \"$gnutls_source_dir\"",
              "fallback": "rmdir /q /s \"$gnutls_source_dir\""
            },
            {
              "message": "[gnutls] git checkout.",
              "when": "{{$git_hash and os.path.isdir($gnutls_source_dir) and not os.path.isfile($cache_file)}}",
              "chdir": "$gnutls_source_dir",
              "script": "git checkout $git_hash",
              "fallback": "rmdir /q /s \"$gnutls_source_dir\""
            },
            {
              "message": "[gnutls] extruct from cache.",
              "when": "{{not os.path.isdir($gnutls_source_dir) and os.path.isfile($cache_file)}}",
              "script": "7z x -aoa \"$cache_file\" -o\"$gnutls_source_dir\"",
              "fallback": "del \"$cache_file\""
            }
          ]
        },
        "patch": {
          "zlib_dir_debug" : "{{next((x for x in $dependent_packages_debug.split(';') if 'zlib' in x), '')}}",
          "zlib_dir_release" : "{{next((x for x in $dependent_packages_release.split(';') if 'zlib' in x), '')}}",
          "brotli_dir_debug" : "{{next((x for x in $dependent_packages_debug.split(';') if 'brotli' in x), '')}}",
          "brotli_dir_release" : "{{next((x for x in $dependent_packages_release.split(';') if 'brotli' in x), '')}}",
          "zstd_dir_debug" : "{{next((x for x in $dependent_packages_debug.split(';') if 'zstd' in x), '')}}",
          "zstd_dir_release" : "{{next((x for x in $dependent_packages_release.split(';') if 'zstd' in x), '')}}",
          "msys2_required_library":[
            "mingw-w64-ucrt-x86_64-nettle",
            "mingw-w64-ucrt-x86_64-gmp",
            "mingw-w64-ucrt-x86_64-libtasn1",
            "mingw-w64-ucrt-x86_64-libunistring",
          ],
          "scripts": [
            {
              "message": "Clean /opt/ucrt64 directory in msys2",
              "bash_script": "rm -rf /opt/ucrt64/*",
              "script": "${msys2_bash_ob} '${bash_script}' ${msys2_bash_cb}",
              "ignore_errors": true
            },
            // Copy zlib binary to MSYS2
            {
              "when": "{{'Debug' in $build_type and $with_zlib}}",
              "script": "robocopy \"$zlib_dir_debug\" \"${msys2_dir}\\opt\\ucrt64\" /e /is /njh /njs /ndl /nc /ns /np",
              "ignore_errors": "{{%ERRORLEVEL% < 8}}"
            },
            {
              "when": "{{'Release' in $build_type and $with_zlib}}",
              "script": "robocopy \"$zlib_dir_release\" \"${msys2_dir}\\opt\\ucrt64\" /e /is /njh /njs /ndl /nc /ns /np",
              "ignore_errors": "{{%ERRORLEVEL% < 8}}"
            },
            // Remove the inclusion of unistd.h in zconf.h. This gets erroneously included when building gnutl
            {
              "when": "{{$with_zlib}}",
              "script": "perl -p -i -e \"s#^.+include <unistd.h>.*##g\" \"${msys2_dir}\\opt\\ucrt64\\include\\zconf.h\""
            },
            // Copy brotli binary to MSYS2
            {
              "when": "{{'Debug' in $build_type and $with_brotli}}",
              "script": "robocopy \"$brotli_dir_debug\" \"${msys2_dir}\\ucrt64\" /e /is /njh /njs /ndl /nc /ns /np",
              "ignore_errors": "{{%ERRORLEVEL% < 8}}"
            },
            {
              "when": "{{'Release' in $build_type and $with_brotli}}",
              "script": "robocopy \"$brotli_dir_release\" \"${msys2_dir}\\opt\\ucrt64\" /e /is /njh /njs /ndl /nc /ns /np",
              "ignore_errors": "{{%ERRORLEVEL% < 8}}"
            },
            // Copy zstd binary to MSYS2
            {
              "when": "{{'Debug' in $build_type and $with_zstd}}",
              "script": "robocopy \"$zstd_dir_debug\" \"${msys2_dir}\\opt\\ucrt64\" /e /is /njh /njs /ndl /nc /ns /np",
              "ignore_errors": "{{%ERRORLEVEL% < 8}}"
            },
            {
              "when": "{{'Release' in $build_type and $with_zstd}}",
              "script": "robocopy \"$zstd_dir_release\" \"${msys2_dir}\\opt\\ucrt64\" /e /is /njh /njs /ndl /nc /ns /np",
              "ignore_errors": "{{%ERRORLEVEL% < 8}}"
            },
            // Install required library
            {
              "when": "{{True if 'msys2_required_library' in globals() and $msys2_required_library else False}}",
              "bash_script": "pacman -S --noconfirm {{' '.join($msys2_required_library)}}",
              "script": "${msys2_bash_ob} '${bash_script}' ${msys2_bash_cb}",
            }
          ]
        },
        "configure": {
          "gnutls_bootstrap_options" : [
          ],
          "gnutls_configure_options": [
            "--host=x86_64-w64-mingw32",
            "--build=x86_64-w64-mingw32",
            "--disable-maintainer-mode",
            "--disable-gtk-doc",
            "--disable-doc",
            "--disable-manpages",
            "--disable-tests",
            "--disable-nls",
            "--disable-valgrind-tests",
            "--disable-bash-tests",
            "--disable-full-test-suite",
            "{{'--enable-static' if 'static' in $build_library else '--disable-static'}}",
            "{{'--enable-shared' if 'shared' in $build_library else '--disable-shared'}}",
            "--without-p11-kit",
            "--without-libev-prefix",
            "--with-zlib={{'link' if $with_zlib else 'no'}}",
            "--with-brotli={{'link' if $with_brotli else 'no'}}",
            "--with-zstd={{'link' if $with_brotli else 'no'}}"
          ],
          "gnutls_configure_options_release": [
            "--prefix=/opt/gnutls/release"
          ],
          "gnutls_configure_options_debug": [
            "--prefix=/opt/gnutls/debug"
          ],
          "scripts": [
            {
              "when": "{{'Debug' in $build_type and $build_layout == 'separation'}}",
              "script": "del /q /s \"$gnutls_build_dir_debug\" > nul",
              "ignore_errors": true
            },
            {
              "when": "{{'Release' in $build_type}}",
              "script": "del /q /s \"$gnutls_build_dir_release\" > nul",
              "ignore_errors": true
            },
            {
              "when": "{{'Debug' in $build_type and not os.path.isdir($gnutls_build_dir_debug)}}",
              "script": "mkdir \"$gnutls_build_dir_debug\"",
              "ignore_errors": true
            },
            {
              "when": "{{'Release' in $build_type and not os.path.isdir($gnutls_build_dir_release)}}",
              "script": "mkdir \"$gnutls_build_dir_release\"",
              "ignore_errors": true
            },
            {
              "message": "call bootstrap",
              "when": "{{not os.path.isfile(os.path.join(${gnutls_source_dir},'configure'))}}",
              "chdir": "$gnutls_source_dir",
              "bash_script": "./bootstrap",
              "script": "${msys2_bash_ob} '${bash_script}' ${msys2_bash_cb}"
            },
            {
              "message": "configure for release.",
              "when": "{{'Release' in $build_type}}",
              "chdir": "$gnutls_build_dir_release",
              "bash_script": "../../{{os.path.basename($source_dir)}}/gnutls/configure {{' '.join($gnutls_configure_options)}} {{' '.join($gnutls_configure_options_release)}}",
              "script": "${msys2_bash_ob} '${bash_script}' ${msys2_bash_cb}"
            },
            {
              "message": "configure for debug.",
              "when": "{{'Debug' in $build_type}}",
              "chdir": "$gnutls_build_dir_debug",
              "bash_script": "../../{{os.path.basename($source_dir)}}/gnutls/configure {{' '.join($gnutls_configure_options)}} {{' '.join($gnutls_configure_options_debug)}}",
              "script": "${msys2_bash_ob} '${bash_script}' ${msys2_bash_cb}"
            }
          ]
        },
        "build": {
          "scripts": [
            {
              "message": "build for debug.",
              "when": "{{'Debug' in $build_type}}",
              "chdir": "$gnutls_build_dir_debug",
              "bash_script": "make -j 4",
              "script": "${msys2_bash_ob} '${bash_script}' ${msys2_bash_cb}"
            },
            {
              "message": "build for release.",
              "when": "{{'Release' in $build_type}}",
              "chdir": "$gnutls_build_dir_release",
              "bash_script": "make -j 4",
              "script": "${msys2_bash_ob} '${bash_script}' ${msys2_bash_cb}"
            }
          ]
        },
        "install": {
          "scripts": [
            {
              "message": "build for debug.",
              "when": "{{'Debug' in $build_type}}",
              "chdir": "$gnutls_build_dir_debug",
              "bash_script": "make install",
              "script": "${msys2_bash_ob} '${bash_script}' ${msys2_bash_cb}"
            },
            {
              "message": "build for release.",
              "when": "{{'Release' in $build_type}}",
              "chdir": "$gnutls_build_dir_release",
              "bash_script": "make install",
              "script": "${msys2_bash_ob} '${bash_script}' ${msys2_bash_cb}"
            }
          ]
        },
        "post-install" :{
          "dist_rootdir_slash":"{{$dist_rootdir.replace('\\\\', '/')}}",
          "environments": {
            "PERLIO": "raw"
          },
          "scripts": [
            {"script": "exit 99"},
            {
              "when": "{{'Debug' in $build_type}}",
              "script": "forfiles -P \"$dist_dir_debug\" /M *.pc /S /C \"cmd /c perl ${assets_rootdir}\\fix_pcfile.pl @PATH 0x22${dist_rootdir_slash}0x22\"",
              "ignore_errors": true
            },
            {
              "when": "{{'Release' in $build_type}}",
              "script": "forfiles -P \"$dist_dir_release\" /M *.pc /S /C \"cmd /c perl ${assets_rootdir}\\fix_pcfile.pl @PATH 0x22${dist_rootdir_slash}0x22\"",
              "ignore_errors": true
            }
          ]
        }
      }
    },
    "3.8.12": {}
  }
}

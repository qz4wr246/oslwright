{
  "name": "gnutls",
  "display": "GnuTLS",
  "description": "TLS/SSL and crypto library",
  "site": "https://www.gnutls.org/",
  "license": "GPL-3.0+ OR LGPL-2.1+",
  "info": "info.md",
  "process_time": 1800,
  "options": [
    {
      "display": "Version",
      "name": "version",
      "type": "choice",
      "items": "{{$versions}}",
      "default": "$latest_version"
    },
    {
      "display": "Visual Studio version",
      "name": "msvc_version",
      "type": "choice",
      "items": "{{$msvc_versions}}",
      "default": "$msvc_version_default"
    },
    {
      "display": "MSVC toolset version",
      "name": "msvc_toolset_version",
      "type": "choice",
      "items": "{{$msvc_toolset_versions}}",
      "default": "$msvc_toolset_version_default"
    },
    {
      "display": "Build arch",
      "name": "build_arch",
      "type": "choice",
      "items": [
        "x64",
        "x32"
      ],
      "default": "$build_arch_default"
    },
    {
      "display": "MSVC runtime library",
      "name": "msvc_runtime_library",
      "enable": false,
      "type": "choice",
      "items": [
        "mt",
        "md"
      ],
      "default": "md"
    },
    {
      "display": "Build library",
      "name": "build_library",
      "enable": false,
      "type": "choice",
      "items": [
        "shared",
        "static"
      ],
      "default": "shared"
    },
    {
      "display": "Build type",
      "name": "build_type",
      "enable": false,
      "type": "choice",
      "items": [
        "Release",
        "Debug"
      ],
      "default": "Release"
    },
    {
      "display": "Build layout",
      "name": "build_layout",
      "enable": false,
      "type": "choice",
      "items": [
        "union",
        "separation"
      ],
      "default": "separation"
    },
    {
      "display": "Using CUDA",
      "name": "cuda_enable",
      "enable": false,
      "type": "bool",
      "default": false
    },
    {
      "display": "CUDA Version",
      "name": "cuda_version",
      "enable": "{{$cuda_enable}}",
      "type": "choice",
      "items": "{{$cuda_versions}}",
      "default": "{{$cuda_version_default}}"
    },
        {
      "display": "Enable Tools",
      "name": "enable_tools",
      "type": "bool",
      "default": false
    },
    {
      "display": "With Zlib",
      "name": "with_zlib",
      "type": "bool",
      "default": true
    },
    {
      "display": "With brotli",
      "name": "with_brotli",
      "type": "bool",
      "default": true
    },
      {
      "display": "With zstd",
      "name": "with_zstd",
      "type": "bool",
      "default": true
    }
  ],
  "versions": {
    "default": {
      "dependencies": {
        "zlib": {
          "enable": "{{$with_zlib}}",
          "version": ">=1.3"
        },
        "brotli": {
          "enable": "{{$with_brotli}}",
          "version": ">=1.1"
        },
        "zstd": {
          "enable": "{{$with_zstd}}",
          "version": ">=1.5"
        },
        "nettle": {
          "version": "==3.10.2"
        },
        "libunistring": {
          "version": ">=1.4"
        },
        "libtasn1": {
          "version": ">=4.21.0"
        },
        "gmp": {
          "version": ">=6.3"
        }
      },
      "environments": {
        "LC_ALL": "C",
        "MSYS": "winsymlinks:nativestrict",
        "MSYSTEM": "MSYS",
        "CHERE_INVOKING": "1",
        "MSYS2_PATH_TYPE": "inherit",
        "CC": "/ucrt64/bin/gcc.exe",
        "CXX": "/ucrt64/bin/g++.exe",
        "LD": "/ucrt64/bin/ld.exe",
        "AR": "/ucrt64/bin/ar.exe",
        "RANLIB": "/ucrt64/bin/ranlib.exe",
        "STRIP": "/ucrt64/bin/strip.exe",
        "NM": "/ucrt64/bin/nm.exe",
        "OBJCOPY": "/ucrt64/bin/objcopy.exe",
        "OBJDUMP": "/ucrt64/bin/objdump.exe",
        "CPPFLAGS": "-I/opt/ucrt64/include",
        "LDFLAGS": "-L/opt/ucrt64/lib",
        "SED": "/usr/bin/sed.exe",
        "PERLIO": "raw",
        "CUDA_PATH": "{{os.path.join($cuda_root, f'v{$cuda_version}') if $cuda_enable else ''}}",
        "CUDNN_PATH": "{{os.path.join($cuda_root, f'v{$cuda_version}') if $cuda_enable else ''}}"
      },
      "source_dir": "${source_rootdir}\\${name}-${version}",
      "dist_name": "${name}-${version}{{'' if $build_library == 'interface' else '-' + $build_arch + '-' + $msvc_toolset_version + '-' + $msvc_runtime_library + (('-cu' + $cuda_version.replace('.','')) if $cuda_enable else '') + ('-static' if 'static' == $build_library else '')}}",
      "dist_name_debug": "${dist_name}{{'-debug' if $build_layout == 'separation' else ''}}",
      "dist_name_release": "${dist_name}{{'-release' if $build_layout == 'separation' else ''}}",
      "build_dir_debug": "${source_rootdir}\\${dist_name}-debug",
      "build_dir_release": "${source_rootdir}\\${dist_name}-release",
      "dist_dir_debug": "${dist_rootdir}\\${dist_name_debug}",
      "dist_dir_release": "${dist_rootdir}\\${dist_name_release}",
      "cache_file": "${cache_rootdir}\\gnutls-${version}.tar.xz",
      "download_url": "https://gnupg.org/ftp/gcrypt/gnutls/v{{$version.split('.')[0] + '.' + $version.split('.')[1]}}/gnutls-${version}.tar.xz",
      "msys2_dir" : "${tools_rootdir}\\msys2\\msys64",
      "msys2_external_runtime_dir": "${msys2_dir}\\opt\\ucrt64",
      "msys2_bash": "\"${msys2_dir}\\usr\\bin\\bash.exe\" -lc ",
      "stages": {
        "download": {
          "scripts": [
            {
              "when": "{{os.path.isdir($source_dir)}}",
              "script": "rmdir /q /s \"$source_dir\""
            },
            {
              "message": "downloads",
              "when": "{{not os.path.isdir($source_dir) and not os.path.isfile($cache_file)}}",
              "script": "curl.exe --fail -L -s -o \"$cache_file\" \"$download_url\"",
              "fallback": "rmdir /q /s \"$source_dir\""
            },
            {
              "message": "extract from cache.",
              "when": "{{not os.path.isdir($source_dir) and os.path.isfile($cache_file)}}",
              "script": "7z.exe x \"${cache_file}\" -so > \"${cache_file}.temp.tar\" && 7z.exe x \"${cache_file}.temp.tar\" -aoa -o\"${source_rootdir}\" && del \"${cache_file}.temp.tar\"",
              "fallback": "rmdir /q /s \"$source_dir\""
            }
          ]
        },
        "patch": {
          "repo_url":"https://raw.githubusercontent.com/msys2/MSYS2-packages/refs/heads/master/${name}",
          "patch_files": [
            {
              "url": "$repo_url/0001-doc-fix-implicit-rule-build-failure.patch"
            }
          ],
          "msys2_require_runtimes" : [
            {
              "name": "zlib",
              "when": "{{$with_zlib}}",
              "add_prefix_lib": ["zlib.lib"]
            },
            {
              "name": "brotli",
              "when": "{{$with_brotli}}",
              "add_prefix_lib": ["brotlicommon.lib", "brotlidec.lib", "brotlienc.lib"]
            },
            {
              "name": "zstd",
              "when": "{{$with_zstd}}",
              "add_prefix_lib": ["zstd.lib"]
            },
            {
              "name": "nettle",
              "remove_prefix_pc": ["libnettle","libhogweed"]
            },
            {
              "name": "libunistring",
              "remove_prefix_pc": ["libunistring"]
            },
            {
              "name": "libtasn1",
              "remove_prefix_pc": ["libtasn1"]
            },
            {
              "name": "gmp",
              "remove_prefix_pc": ["libgmp", "libgmpxx"]
            }
          ],
          "scripts": [
            {
              "message": "Patch ${name} source code",
              "chdir": "$source_dir",
              "script": "{{' && '.join([(f'pushd \"{p[\"chdir\"]}\" && ' if \"chdir\" in p else '')+(f'(if not exist \"{os.path.join($cache_rootdir, os.path.basename(p[\"url\"]))}\" (curl.exe --fail -L -s -o \"{os.path.join($cache_rootdir, os.path.basename(p[\"url\"]))}\" \"{p[\"url\"]}\" || exit /b 1 )) && patch -t -b -p1 -i \"{os.path.join($cache_rootdir,os.path.basename(p[\"url\"]))}\" && copy nul > \"__patched__{os.path.basename(p[\"url\"])}\"' if \"url\" in p else f'patch -t -b -p1 -i \"{p[\"file\"]}\" && copy nul > \"__patched__{os.path.basename(p[\"file\"])}\"') + (' && popd ' if \"chdir\" in p else '') for p in $patch_files if p.get('when', True) and not os.path.exists('__patched__' + os.path.basename(p.get('url') or p.get('file')))])}}"
            },
            {
              "message": "Clean /opt/ucrt64 directory in msys2",
              "script": "del /q /s \"$msys2_external_runtime_dir\" > nul",
              "ignore_errors": true
            },
            {
              "message": "Copy runtime libraries to MSYS2",
              "when": "{{'msys2_require_runtimes' in globals() and not os.path.exists(os.path.join($msys2_external_runtime_dir, '__copied__'))}}",
              "script": "{{' && '.join([f'xcopy \"{src_dir}\" \"{msys2_external_runtime_dir}\" /s /e /i /y' for dpr in [dependent_packages_release.split(';')] for item in msys2_require_runtimes if item.get('when', True) for src_dir in dpr if item['name'] in src_dir]+ [f'copy nul > \"{os.path.join(msys2_external_runtime_dir, \"__copied__\")}\"'])}}"
            },
            {
              "message": "Rename library files and rewrite pc files.",
              "when": "{{'msys2_require_runtimes' in globals() and not os.path.exists(os.path.join($msys2_external_runtime_dir, '__renamed__'))}}",
              "script": "{{' && '.join([cmd for item in $msys2_require_runtimes if item.get('when', True) for cmd in ([f'ren \"{p}\" \"lib{os.path.basename(p)}\"' for n in item.get('add_prefix_lib', []) for p in glob.glob(os.path.join($msys2_external_runtime_dir, '**', n), recursive=True)] + [f'perl -i.bak -pe \"if(/^Libs:/){{ s/-l{n}\\\\b/-l{n[3:] if n.startswith(\"lib\") else n}/g }}\" \"{p}\"' for n in item.get('remove_prefix_pc', []) for p in glob.glob(os.path.join($msys2_external_runtime_dir, '**', '*.pc'), recursive=True) if os.path.isfile(p) and any(re.search(rf'^Libs:.*-l{n}\\b', l) for l in [pathlib.Path(p).read_text(errors=\"ignore\")] for l in l.splitlines())])]+[f'copy nul > \"{os.path.join($msys2_external_runtime_dir, \"__renamed__\")}\"'])}}"
            },
            {
              "message": "reconfigure",
              "chdir": "$source_dir",
              "bash_script": "autoreconf -vfi",
              "script": "${msys2_bash} \"${bash_script}\""
            }
          ]
        },
        "configure": {
          "configure_options": [
            "--build=x86_64-w64-mingw32",
            "--disable-maintainer-mode",
            "--enable-cxx",
            "--disable-gtk-doc",
            "--disable-doc",
            "--disable-manpages",
            "--disable-tests",
            "{{'--disable-tools' if not $enable_tools else '--enable-tools'}}",
            "--disable-nls",
            "--disable-valgrind-tests",
            "--disable-bash-tests",
            "--disable-full-test-suite",
            "--disable-hardware-acceleration",
            "--enable-heartbeat-support",
            "--with-default-trust-store-file=/usr/ssl/certs/ca-bundle.crt",
            "gl_cv_clean_version_stddef=yes",
            "{{'--enable-static' if 'static' in $build_library else '--disable-static'}}",
            "{{'--enable-shared' if 'shared' in $build_library else '--disable-shared'}}",
            "--without-p11-kit",
            "--without-libev-prefix",
            "--with-zlib={{'link' if $with_zlib else 'no'}}",
            "--with-brotli={{'link' if $with_brotli else 'no'}}",
            "--with-zstd={{'link' if $with_zstd else 'no'}}"
          ],
          "configure_options_release": [
            "--prefix=/opt/${name}/release"
          ],
          "configure_options_debug": [
            "--prefix=/opt/${name}/debug"
          ],
          "scripts": [
            {
              "when": "{{'Debug' in $build_type and $build_layout == 'separation'}}",
              "script": "del /q /s \"$build_dir_debug\" > nul",
              "ignore_errors": true
            },
            {
              "when": "{{'Release' in $build_type}}",
              "script": "del /q /s \"$build_dir_release\" > nul",
              "ignore_errors": true
            },
            {
              "when": "{{'Debug' in $build_type and not os.path.isdir($build_dir_debug)}}",
              "script": "mkdir \"$build_dir_debug\"",
              "ignore_errors": true
            },
            {
              "when": "{{'Release' in $build_type and not os.path.isdir($build_dir_release)}}",
              "script": "mkdir \"$build_dir_release\"",
              "ignore_errors": true
            },
            {
              "message": "configure for release.",
              "when": "{{'Release' in $build_type}}",
              "chdir": "$build_dir_release",
              "bash_script": "../{{os.path.basename($source_dir)}}/configure {{' '.join($configure_options)}} {{' '.join($configure_options_release)}}",
              "script": "${msys2_bash} \"${bash_script}\""
            },
            {
              "message": "configure for debug.",
              "when": "{{'Debug' in $build_type}}",
              "chdir": "$build_dir_debug",
              "bash_script": "../{{os.path.basename($source_dir)}}/configure {{' '.join($configure_options)}} {{' '.join($configure_options_debug)}}",
              "script": "${msys2_bash} \"${bash_script}\""
            }
          ]
        },
        "build": {
          "scripts": [
            {
              "message": "build for debug.",
              "when": "{{'Debug' in $build_type}}",
              "chdir": "$build_dir_debug",
              "bash_script": "make -j 4",
              "script": "${msys2_bash} \"${bash_script}\""
            },
            {
              "message": "build for release.",
              "when": "{{'Release' in $build_type}}",
              "chdir": "$build_dir_release",
              "bash_script": "make -j 4",
              "script": "${msys2_bash} \"${bash_script}\""
            }
          ]
        },
        "install": {
          "scripts": [
            {
              "message": "build for debug.",
              "when": "{{'Debug' in $build_type}}",
              "chdir": "$build_dir_debug",
              "bash_script": "make install",
              "script": "${msys2_bash} \"${bash_script}\""
            },
            {
              "message": "build for release.",
              "when": "{{'Release' in $build_type}}",
              "chdir": "$build_dir_release",
              "bash_script": "make install",
              "script": "${msys2_bash} \"${bash_script}\""
            },
            {
              "message": "Copy ${name} files for debug.",
              "when": "{{'Debug' in $build_type}}",
              "script": "xcopy \"${msys2_dir}\\opt\\${name}\\debug\" \"$dist_dir_debug\" /s /e /i /y"
            },
            {
              "message": "Copy ${name} files for release.",
              "when": "{{'Release' in $build_type}}",
              "script": "xcopy \"${msys2_dir}\\opt\\${name}\\release\" \"$dist_dir_release\" /s /e /i /y"
            }
          ]
        },
        "post-install" :{
          "dist_rootdir_slash":"{{$dist_rootdir.replace('\\\\', '/')}}",
          "environments": {
            "PERLIO": "raw"
          },
          "scripts": [
            {
              "message": "Rename the library files to be MSVC-compatible.",
              "when":"{{'Debug' in $build_type}}",
              "chdir": "$dist_dir_debug\\lib",
                            "script": "cmd /v:on /c \"for %f in (*.a) do (set \"n=%~nf\" & set \"n=!n:.dll=!\" & copy /y \"%f\" \"!n!.lib\" & if \"!n:~0,3!\"==\"lib\" copy /y \"%f\" \"!n:~3!.lib\")\"",
              "ignore_errors": true
            },
            {
              "message": "Rename the library files to be MSVC-compatible.",
              "when":"{{'Release' in $build_type }}",
              "chdir": "$dist_dir_release\\lib",
                            "script": "cmd /v:on /c \"for %f in (*.a) do (set \"n=%~nf\" & set \"n=!n:.dll=!\" & copy /y \"%f\" \"!n!.lib\" & if \"!n:~0,3!\"==\"lib\" copy /y \"%f\" \"!n:~3!.lib\")\"",
              "ignore_errors": true
            },
            {
              "message": "Adjust paths and other configurations in *.pc",
              "when": "{{'Debug' in $build_type}}",
              "script": "forfiles -P \"$dist_dir_debug\" /M *.pc /S /C \"cmd /c perl ${assets_rootdir}\\fix_pcfile.pl @PATH 0x22${dist_rootdir_slash}0x22\"",
              "ignore_errors": true
            },
            {
              "message": "Adjust paths and other configurations in *.pc",
              "when": "{{'Release' in $build_type}}",
              "script": "forfiles -P \"$dist_dir_release\" /M *.pc /S /C \"cmd /c perl ${assets_rootdir}\\fix_pcfile.pl @PATH 0x22${dist_rootdir_slash}0x22\"",
              "ignore_errors": true
            },
            {
              "message": "Rewriting library names for linker options in .pc files , with -llib prefix ",
              "when": "{{'Debug' in $build_type}}",
              "script": "forfiles -P \"$dist_dir_debug\" /M *.pc /S /C \"cmd /c perl -pi -e 's/(^Libs:.*?)-l([a-zA-Z0-9_\\.\\-]+)/$$1-llib$$2/g'  @PATH\""
            },
            {
              "message": "Rewriting library names for linker options in .pc files",
              "when": "{{'Release' in $build_type}}",
              "script": "forfiles -P \"$dist_dir_release\" /M *.pc /S /C \"cmd /c perl -pi -e 's/(^Libs:.*?)-l([a-zA-Z0-9_\\.\\-]+)/$$1-llib$$2/g'  @PATH\""
            }
          ]
        }
      }
    },
    "3.8.12": {
      "dependencies": {
        "nettle": {
          "version": "==3.10.2"
        }
      }
    }
  }
}

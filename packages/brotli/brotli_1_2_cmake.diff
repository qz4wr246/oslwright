diff --git a/CMakeLists.txt b/CMakeLists.txt
index 22b21d2..b22a4cf 100644
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -156,6 +156,9 @@ foreach(lib ${BROTLI_SHARED_LIBRARIES} ${BROTLI_STATIC_LIBRARIES})
   set_target_properties(${lib} PROPERTIES
     VERSION "${BROTLI_ABI_COMPATIBILITY}.${BROTLI_ABI_AGE}.${BROTLI_ABI_REVISION}"
     SOVERSION "${BROTLI_ABI_COMPATIBILITY}")
+  target_include_directories(${lib} INTERFACE
+    $<BUILD_INTERFACE:${BROTLI_INCLUDE_DIRS}>
+    $<INSTALL_INTERFACE:include>)
   if (NOT BROTLI_EMSCRIPTEN)
     set_target_properties(${lib} PROPERTIES POSITION_INDEPENDENT_CODE TRUE)
   endif()
@@ -193,6 +196,7 @@ if (NOT BROTLI_BUNDLED_MODE)
 
   install(
     TARGETS ${BROTLI_SHARED_LIBRARIES} ${BROTLI_STATIC_LIBRARIES}
+    EXPORT brotli-export
     ARCHIVE DESTINATION "${CMAKE_INSTALL_LIBDIR}"
     LIBRARY DESTINATION "${CMAKE_INSTALL_LIBDIR}"
     RUNTIME DESTINATION "${CMAKE_INSTALL_BINDIR}"
@@ -393,3 +397,26 @@ install(FILES docs/constants.h.3 docs/decode.h.3 docs/encode.h.3 docs/types.h.3
 if (ENABLE_COVERAGE STREQUAL "yes")
   setup_target_for_coverage(coverage test coverage)
 endif()
+
+include(CMakePackageConfigHelpers)
+install(EXPORT brotli-export
+  FILE brotliTargets.cmake
+  NAMESPACE brotli::
+  DESTINATION lib/cmake/brotli
+  EXPORT_LINK_INTERFACE_LIBRARIES
+)
+write_basic_package_version_file(
+  ${CMAKE_CURRENT_BINARY_DIR}/brotliConfigVersion.cmake
+  VERSION "${BROTLI_VERSION}"
+  COMPATIBILITY AnyNewerVersion
+)
+configure_package_config_file(
+    "${PROJECT_SOURCE_DIR}/Config.cmake.in"
+    "${CMAKE_CURRENT_BINARY_DIR}/brotliConfig.cmake"
+    INSTALL_DESTINATION ${CMAKE_INSTALL_LIBDIR}/cmake/brotli
+)
+install(FILES
+  ${CMAKE_CURRENT_BINARY_DIR}/brotliConfigVersion.cmake
+  ${CMAKE_CURRENT_BINARY_DIR}/brotliConfig.cmake
+  DESTINATION lib/cmake/brotli
+)

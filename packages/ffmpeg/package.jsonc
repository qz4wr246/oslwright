{
  "name": "ffmpeg",
  "display": "FFmpeg",
  "description": "The leading multimedia framework",
  "site": "https://www.ffmpeg.org",
  "license": "LGPL 2.1+, GPL 2+",
  "info":"info.md",
  "process_time": 3000,
  "options": [
    {
      "display": "Version",
      "name": "version",
      "type": "choice",
      "items": "{{$versions}}",
      "default": "$latest_version"
    },
    {
      "display": "Visual Studio version",
      "name": "msvc_version",
      "type": "choice",
      "items": "{{$msvc_versions}}",
      "default": "$msvc_version_default"
    },
    {
      "display": "MSVC toolset version",
      "name": "msvc_toolset_version",
      "type": "choice",
      "items": "{{$msvc_toolset_versions}}",
      "default": "$msvc_toolset_version_default"
    },
    {
      "display": "Build arch",
      "name": "build_arch",
      "type": "choice",
      "items": [
        "x64",
        "x32"
      ],
      "default": "$build_arch_default"
    },
    {
      "display": "MSVC runtime library",
      "name": "msvc_runtime_library",
      "type": "choice",
      "items": [
        "mt",
        "md"
      ],
      "default": "$msvc_runtime_library_default"
    },
    {
      "display": "Build library",
      "name": "build_library",
      "enable": false,
      "type": "choice",
      "items": [
        "shared",
        "static"
      ],
      "default": "shared"
    },
    {
      "display": "Build type",
      "name": "build_type",
      "enable": false,
      "type": "choice",
      "items": [
        "Release",
        "Debug"
      ],
      "default": "Release"
    },
    {
      "display": "Build layout",
      "name": "build_layout",
      "enable": false,
      "type": "choice",
      "items": [
        "union",
        "separation"
      ],
      "default": "separation"
    },
    {
      "display": "Using CUDA",
      "name": "cuda_enable",
      "enable": "{{True if $cuda_versions else False}}",
      "type": "bool",
      "default": "{{$cuda_enable_default}}"
    },
    {
      "display": "CUDA Version",
      "name": "cuda_version",
      "enable": "cuda_enable",
      "type": "choice",
      "items": "{{$cuda_versions}}",
      "default": "{{$cuda_version_default}}"
    },
    {
      "display": "Build Apps",
      "name": "build_apps",
      "type": "bool",
      "default": true
    },
    {
      "display": "Enable GPL",
      "name": "enable_gpl",
      "type": "bool",
      "default": false
    },
    {
      "display": "Enable openh264",
      "name": "enable_openh264",
      "type": "bool",
      "default": false
    },
    {
      "display": "Enable NVENC",
      "name": "enable_nvenc",
      "enable": "{{$cuda_enable}}",
      "type": "bool",
      "default": false
    }
  ],
  "versions": {
    "default": {
      "dependencies": {
        "openh264": {
          "enable": "{{$enable_openh264}}",
          "version": ">=2.6.0"
        },
        "sdl": {
          "version": ">=2.30;<3.0"  // ffmpeg ver 6.x is compatible with sdl2 ver 2.x.
        },
        "zlib": {
          "version": ">=1.3"
        }
      },
      "environments": {
        "LC_ALL": "C",
        "MSYS": "winsymlinks:nativestrict",
        "MSYSTEM": "MSYS",
        "CHERE_INVOKING": "1",
        "MSYS2_PATH_TYPE": "inherit",
        "SED": "/usr/bin/sed.exe",
        "PERLIO": "raw",
        "CUDA_PATH": "{{os.path.join($cuda_root, f'v{$cuda_version}')  if $cuda_enable else ''}}",
        "CUDNN_PATH": "{{os.path.join($cuda_root, f'v{$cuda_version}')  if $cuda_enable else ''}}"
      },
      "source_dir": "${source_rootdir}\\${name}-${version}",
      "dist_name": "${name}-${version}{{'' if $build_library == 'interface' else '-' + $build_arch + '-' + $msvc_toolset_version + '-' + $msvc_runtime_library + (('-cu' + $cuda_version.replace('.','')) if $cuda_enable else '') + ('-static' if 'static' == $build_library else '')}}",
      "dist_name_debug": "${dist_name}{{'-debug' if $build_layout == 'separation' else ''}}",
      "dist_name_release": "${dist_name}{{'-release' if $build_layout == 'separation' else ''}}",
      "build_dir_debug": "${source_rootdir}\\${dist_name_debug}-build",
      "build_dir_release": "${source_rootdir}\\${dist_name_release}-build",
      "dist_dir_debug": "${dist_rootdir}\\${dist_name_debug}",
      "dist_dir_release": "${dist_rootdir}\\${dist_name_release}",
      "cache_file": "${cache_rootdir}\\${name}-${version}.7z",
      "git_url": "https://git.ffmpeg.org/ffmpeg.git",
      "git_tag": "{{$version.split('@', 1)[0] if '@' in $version else 'n' + $version}}",
      "git_hash": "{{$version.split('@', 1)[1] if '@' in $version else ''}}",
      "msys2_dir" : "${tools_rootdir}\\msys2\\msys64",
      "msys2_external_runtime_dir": "${msys2_dir}\\opt\\ucrt64",
      "msys2_bash": "\"${msys2_dir}\\usr\\bin\\bash.exe\" -lc ",
      "stages": {
        "download": {
          "scripts": [
            {
              "message": "git clone.",
              "when": "{{not os.path.isdir($source_dir) and not os.path.isfile($cache_file)}}",
              "script": "git clone --no-progress --quiet -b \"$git_tag\" {{'' if $git_hash else '--depth 1'}} --single-branch --recurse --shallow-submodules $git_url \"$source_dir\"",
              "fallback": "rmdir /q /s \"$source_dir\""
            },
            {
              "message": "git checkout.",
              "when": "{{$git_hash and os.path.isdir($source_dir) and not os.path.isfile($cache_file)}}",
              "chdir": "$source_dir",
              "script": "git checkout $git_hash",
              "fallback": "rmdir /q /s \"$source_dir\""
            },
            {
              "message": "extract from cache.",
              "when": "{{not os.path.isdir($source_dir) and os.path.isfile($cache_file)}}",
              "script": "7z x -aoa \"$cache_file\" -o\"$source_dir\"",
              "fallback": "rmdir /q /s \"$source_dir\""
            },
            {
              "message": "make cache.",
              "when": "{{not os.path.isfile($cache_file)}}",
              "script": "7z a \"$cache_file\" \"$source_dir\\*\"",
              "fallback": "del \"$cache_file\""
            }
          ]
        },
        "patch": {
          //
          // Copy SDL2 and zlib binary to MSYS2
          // Remove the inclusion of unistd.h in zconf.h. This gets erroneously included when building FFmpeg.
          //
          "msys2_require_runtimes": [
            {
              "name": "zlib",
              "add_prefix_lib": ["zlib.lib"]
            },
            {
              "name": "sdl",
              "add_prefix_lib": ["sdl2.lib"]
            },
            {
              "name": "openh264",
              "when": "$enable_openh264",
              "remove_prefix_pc": ["libopenh264"]
            }
          ],
          "scripts": [
            {
              "message": "Clean /opt/ucrt64 directory in msys2",
              "bash_script": "rm -rf /opt/ucrt64/*",
              "script": "${msys2_bash} \"${bash_script}\"",
              "ignore_errors": false
            },
          {
              // Copy runtime Script: with msys2_require_runtimes
              "message": "Copy runtime libraries to MSYS2",
              "when": "{{'msys2_require_runtimes' in globals() and not os.path.exists(os.path.join($msys2_external_runtime_dir, '__copied__'))}}",
              "script": "{{' && '.join([f'xcopy \"{src_dir}\" \"{msys2_external_runtime_dir}\" /s /e /i /y' for dpr in [dependent_packages_release.split(';')] for item in msys2_require_runtimes if item.get('when', True) for src_dir in dpr if item['name'] in src_dir]+ [f'copy nul > \"{os.path.join(msys2_external_runtime_dir, \"__copied__\")}\"'])}}"
            },
            {
              // Rename runtime Script: with msys2_require_runtimes
              "message": "Rename library files and rewrite pc files.",
              "when": "{{'msys2_require_runtimes' in globals() and not os.path.exists(os.path.join($msys2_external_runtime_dir, '__renamed__'))}}",
              "script": "{{' && '.join([cmd for item in $msys2_require_runtimes if item.get('when', True) for cmd in ([f'ren \"{p}\" \"lib{os.path.basename(p)}\"' for n in item.get('add_prefix_lib', []) for p in glob.glob(os.path.join($msys2_external_runtime_dir, '**', n), recursive=True)] + [f'perl -i.bak -pe \"if(/^Libs:/){{ s/-l{n}\\\\b/-l{n[3:] if n.startswith(\"lib\") else n}/g }}\" \"{p}\"' for n in item.get('remove_prefix_pc', []) for p in glob.glob(os.path.join($msys2_external_runtime_dir, '**', '*.pc'), recursive=True) if os.path.isfile(p) and any(re.search(rf'^Libs:.*-l{n}\\b', l) for l in [pathlib.Path(p).read_text(errors=\"ignore\")] for l in l.splitlines())])]+[f'copy nul > \"{os.path.join($msys2_external_runtime_dir, \"__renamed__\")}\"'])}}"
            },
            {
              "script": "perl -p -i -e \"s#^.+include <unistd.h>.*##g\" \"${msys2_dir}\\opt\\ucrt64\\include\\zconf.h\""
            },
            {
              "script": "copy /Y \"${package_dir}\\sdl2-config\" \"${msys2_dir}\\opt\\ucrt64\\bin\\\""
            }
          ]
        },
        "configure": {
          "config_options": [
            "--toolchain=msvc",
            "--arch=x86_64",
            "--enable-w32threads",
            "{{'--enable-shared --disable-static' if 'shared' in $build_library else ''}}",
            "{{'--extra-cflags=\"-MD\" --extra-cxxflags=\"-MD\" --extra-ldflags=\"/nodefaultlib:libcmt.lib\"' if 'md' == $msvc_runtime_library else '--extra-cflags=\"-MT\" --extra-cxxflags=\"-MT\" --extra-ldflags=\"/nodefaultlib:msvcrt.lib\"'}}",
            "--disable-doc",
            "--disable-htmlpages",
            "--disable-manpages",
            "--disable-podpages",
            "--disable-txtpages",
            "--disable-postproc",
            "--disable-iconv",
            "--disable-nonfree",
            "{{'--enable-gpl' if $enable_gpl else '--disable-gpl'}}",
            "{{'--enable-libopenh264' if $enable_openh264 else '--disable-libopenh264'}}",
            "{{'--enable-nvenc' if $enable_nvenc else '--disable-nvenc'}}",
            "--disable-cuda-nvcc",
            "--disable-libnpp",
            "--extra-cflags=-DZLIB_DLL"
          ],
          "config_options_debug" : [
            "--prefix=/opt/ffmpeg/debug",
            "--enable-debug",
            "--disable-ffplay",
            "--disable-ffmpeg",
            "--disable-ffprobe"
          ],
          "config_options_release" : [
            "--prefix=/opt/ffmpeg/release",
            "--disable-debug",
            "--enable-small",
            "--{{'enable' if $build_apps else 'disable'}}-ffplay",
            "--{{'enable' if $build_apps else 'disable'}}-ffmpeg",
            "--{{'enable' if $build_apps else 'disable'}}-ffprobe"
          ],
          "scripts": [
            {
              "ignore_errors": true,
              "when": "{{'Debug' in $build_type and $build_layout == 'separation'}}",
              "script": "del /q /s \"$build_dir_debug\" > nul"
            },
            {
              "ignore_errors": true,
              "when": "{{'Release' in $build_type}}",
              "script": "del /q /s \"$build_dir_release\" > nul"
            },
            {
              "ignore_errors": true,
              "when": "{{'Debug' in $build_type and not os.path.isdir($build_dir_debug)}}",
              "script": "mkdir \"$build_dir_debug\""
            },
            {
              "ignore_errors": true,
              "when": "{{'Release' in $build_type and not os.path.isdir($build_dir_release)}}",
              "script": "mkdir \"$build_dir_release\""
            },
            {
              "message": "config for debug.",
              "when": "{{'Debug' in $build_type}}",
              "environments": {
                "PATH":"{{re.sub(r'[^;]+pkg-config[^;]+', '', '%PATH%')}}"
              },
              "chdir": "$build_dir_debug",
              "bash_script": "../{{os.path.basename($source_dir)}}/configure {{' '.join($config_options)}} {{' '.join($config_options_debug)}}",
              "script": "${msys2_bash} \"${bash_script}\""
            },
            {
              "message": "config for release.",
              "when": "{{'Release' in $build_type}}",
              "environments": {
                "PATH":"{{re.sub(r'[^;]+pkg-config[^;]+', '', '%PATH%')}}"
              },
              "chdir": "$build_dir_release",
              "bash_script": "../{{os.path.basename($source_dir)}}/configure {{' '.join($config_options)}} {{' '.join($config_options_release)}}",
              "script": "${msys2_bash} \"${bash_script}\""
            }
          ]
        },
        "build": {
          "scripts": [
            {
              "message": "build for debug.",
              "when": "{{'Debug' in $build_type}}",
              "environments": {
                "PATH": "{{';'.join(['%PATH%', $dependent_dlls_debug])}}",
                "PERLIO": "raw"
              },
              "chdir": "$build_dir_debug",
              "bash_script": "make -j4",
              "script": "${msys2_bash} \"${bash_script}\""
            },
            {
              "message": "build for release.",
              "when": "{{'Release' in $build_type}}",
              "environments": {
                "PATH": "{{';'.join(['%PATH%', $dependent_dlls_release])}}",
                "PERLIO": "raw"
              },
              "chdir": "$build_dir_release",
              "bash_script": "make -j4",
              "script": "${msys2_bash} \"${bash_script}\""
            }
          ]
        },
        "install": {
          "scripts": [
            {
              "message": "install for debug.",
              "when": "{{'Debug' in $build_type}}",
              "chdir": "$build_dir_debug",
              "bash_script": "make install",
              "script": "${msys2_bash} \"${bash_script}\""
            },
            {
              "message": "install for release.",
              "when": "{{'Release' in $build_type}}",
              "chdir": "$build_dir_release",
              "bash_script": "make install",
              "script": "${msys2_bash} \"${bash_script}\""
            },
            {
              "message": "Copy ${name} files for debug.",
              "when": "{{'Debug' in $build_type}}",
              "script": "xcopy \"${msys2_dir}\\opt\\${name}\\debug\" \"$dist_dir_debug\" /s /e /i /y"
            },
            {
              "message": "Copy ${name} files for release.",
              "when": "{{'Release' in $build_type}}",
              "script": "xcopy \"${msys2_dir}\\opt\\${name}\\release\" \"$dist_dir_release\" /s /e /i /y"
            }
          ]
        },
        "post-install" :{
          "template_files":[
            {
              "when": "{{'Debug' in $build_type}}",
              "template": "${package_dir}\\activate.bat.j2",
              "defines": [
                "DEPENDENT_DLL_PATHS=\"{{${dependent_dlls_debug}.replace(${dist_rootdir} +'\\\\','')}}\""
              ],
              "output": "${dist_dir_release}\\bin\\activate.bat"
            },
            {
              "when": "{{'Release' in $build_type}}",
              "template": "${package_dir}\\activate.bat.j2",
              "defines": [
                "DEPENDENT_DLL_PATHS=\"{{${dependent_dlls_release}.replace(${dist_rootdir} +'\\\\','')}}\""
              ],
              "output": "${dist_dir_release}\\bin\\activate.bat"
            }
          ],
          "environments": {
            "PERLIO": "raw"
          },
          "scripts": [
            {
              // Template Script:
              // This will render the template files specified in template_files, and the rendered result will be executed as a script. So you can generate files from templates  and execute any script after installation.
              "message": "Generate files from templates.",
              "script": "{{' && '.join([f\"(if not exist \\\"{os.path.dirname(tp['output'])}\\\" mkdir \\\"{os.path.dirname(tp['output'])}\\\") && jinja2 {(' '.join(['-D ' + d for d in tp['defines']]))} \\\"{tp['template']}\\\" > \\\"{tp['output']}\\\"\" for tp in ${template_files} if tp.get('when', True)])}}"
            },
            {
              "ignore_errors": true,
              "when": "{{'Debug' in $build_type}}",
              "script": "forfiles -P \"$dist_dir_debug\" /M *.pc /S /C \"cmd /c perl -p -i -e 0x22s#^prefix=.*#prefix=\\$${pcfiledir}/../..#g;s#^exec_prefix=.*#exec_prefix=\\$${prefix}#g;s#^libdir=.*#libdir=\\$${prefix}/lib#g;s#^includedir=.*#includedir=\\$${prefix}/include#g0x22 @PATH\""
            },
            {
              "ignore_errors": true,
              "when": "{{'Debug' in $build_type}}",
              "script": "forfiles -P \"$dist_dir_debug\" /M *.pc /S /C \"cmd /c perl -p -i -e 0x22s#-libpath:.+lib # #g0x22 @PATH\""
            },
            {
              "ignore_errors": true,
              "when": "{{'Release' in $build_type}}",
              "script": "forfiles -P \"$dist_dir_release\" /M *.pc /S /C \"cmd /c perl -p -i -e 0x22s#^prefix=.*#prefix=\\$${pcfiledir}/../..#g;s#^exec_prefix=.*#exec_prefix=\\$${prefix}#g;s#^libdir=.*#libdir=\\$${prefix}/lib#g;s#^includedir=.*#includedir=\\$${prefix}/include#g0x22 @PATH\""
            },
            {
              "ignore_errors": true,
              "when": "{{'Release' in $build_type}}",
              "script": "forfiles -P \"$dist_dir_release\" /M *.pc /S /C \"cmd /c perl -p -i -e 0x22s#-libpath:.+lib # #g0x22 @PATH\""
            },
            {
              "when": "{{'Debug' in $build_type}}",
              "script": "xcopy \"$dist_dir_debug\\bin\\*.lib\" \"$dist_dir_debug\\lib\" /s /e /i /y"
            },
            {
              "when": "{{'Release' in $build_type}}",
              "script": "xcopy \"$dist_dir_release\\bin\\*.lib\" \"$dist_dir_release\\lib\" /s /e /i /y"
            }
          ]
        }
      }
    },
    "6.1.4": { // GStreamer ver 1.24.5 is compatible with FFmpeg ver 6.x.
      "dependencies": {
        "sdl": {
          "version": ">=2.30;<3.0"  // ffmpeg ver 6.x is compatible with sdl2 ver 2.x.
        }
      }
    }
    // "7.1": {}
  }
}

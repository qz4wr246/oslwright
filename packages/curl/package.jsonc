{
  "name": "curl",
  "display": "cURL",
  "description": "Curl is a command-line tool for transferring data specified with URL syntax.",
  "site": "https://curl.se/",
  "license": "curl",
  "category": "network",
  "info": "info.md",
  "process_time": 100,
  "options": [
    {
      "display": "Version",
      "name": "version",
      "type": "choice",
      "items": "{{$versions}}",
      "default": "$latest_version"
    },
    {
      "display": "Visual Studio version",
      "name": "msvc_version",
      "type": "choice",
      "items": "{{$msvc_versions}}",
      "default": "$msvc_version_default"
    },
    {
      "display": "MSVC toolset version",
      "name": "msvc_toolset_version",
      "type": "choice",
      "items": "{{$msvc_toolset_versions}}",
      "default": "$msvc_toolset_version_default"
    },
    {
      "display": "Build arch",
      "name": "build_arch",
      "type": "choice",
      "items": [
        "x64",
        "x32"
      ],
      "default": "$build_arch_default"
    },
    {
      "display": "MSVC runtime library",
      "name": "msvc_runtime_library",
      "type": "choice",
      "items": [
        "mt",
        "md"
      ],
      "default": "$msvc_runtime_library_default"
    },
    {
      "display": "Build library",
      "name": "build_library",
      "type": "choice",
      "items": [
        "shared",
        "static"
      ],
      "default": "$build_library_default"
    },
    {
      "display": "Build type",
      "name": "build_type",
      "type": "choice",
      "items": [
        "Release",
        "Debug"
      ],
      "default": "Release"
    },
    {
      "display": "Build layout",
      "name": "build_layout",
      "type": "choice",
      "items": [
        "union",
        "separation"
      ],
      "default": "union"
    },
    {
      "display": "Enable HTTP Only",
      "name": "http_only_enable",
      "type": "bool",
      "default": true
    },
    {
      "display": "Using OpenSSL",
      "name": "openssl_enable",
      // "enable": false,
      "type": "bool",
      "default": true
    },
    {
      "display": "Using GnuTLS",
      "name": "gnutls_enable",
      "type": "bool",
      "default": false
    },
    {
      "display": "Using MbedTLS",
      "name": "mbedtls_enable",
      "type": "bool",
      "default": false
    },
    {
      "display": "Using wolfSSL",
      "name": "wolfssl_enable",
      "type": "bool",
      "default": false
    },
    {
      "display": "Using Schannel",
      "name": "schannel_enable",
      "type": "bool",
      "default": false
    },
    {
      "display": "TLS backend",
      "name": "tls_backend",
      "type": "choice",
      "items": "{{[name for name, enable in [('openssl', $openssl_enable), ('gnutls', $gnutls_enable), ('wolfssl', $wolfssl_enable), ('mbedtls', $mbedtls_enable), ('schannel', $schannel_enable)] if enable]}}",
      "default": "{{next((name for name, enable in [('openssl', $openssl_enable), ('gnutls', $gnutls_enable), ('wolfssl', $wolfssl_enable), ('mbedtls', $mbedtls_enable), ('schannel', $schannel_enable)] if enable), None)}}"
    },
    {
      "display": "Enable HTTP/2",
      "name": "http2_enable",
      "type": "bool",
      "default": true
    },
    {
      "display": "Enable HTTP/3",
      "name": "http3_enable",
      "type": "bool",
      "default": true
    }
  ],
  "versions": {
    "default": {
      "dependencies": {
        "openssl": {
          "enable": "{{$openssl_enable}}",
          "version": ">=3.5;<3.6"
        },
        "gnutls": {
          "enable": "{{$gnutls_enable}}",
          "version": ">=3.8;<=3.9"
        },
        "mbedtls": {
          "enable": "{{$mbedtls_enable}}",
          "version": ">=3.6"
        },
        "wolfssl": {
          "enable": "{{$wolfssl_enable}}",
          "version": ">=5.9"
        },
        "brotli": {
          "version": ">=1.1"
        },
        "zlib": {
          "version": ">=1.3"
        },
        "zstd": {
          "version": ">=1.5"
        },
        "libpsl" : {
          "version": ">=0.23"
        },
        "nghttp2": {
          "enable": "{{$http2_enable}}",
          "version": ">=1.71"
        },
        "ngtcp2": {
          "enable": "{{$http3_enable}}",
          "version": ">=1.26"
        },
        "nghttp3": {
          "enable": "{{$http3_enable}}",
          "version": ">=1.19"
        }
      },
      "source_dir": "${source_rootdir}\\${name}-${version}",
      "dist_name": "${name}-${version}{{'' if $build_library == 'interface' else '-' + $build_arch + '-' + $msvc_toolset_version + '-' + $msvc_runtime_library + (('-cu' + $cuda_version.replace('.','')) if $cuda_enable else '') + ('-static' if 'static' == $build_library else '')}}",
      "dist_name_debug": "${dist_name}{{'-debug' if $build_layout == 'separation' else ''}}",
      "dist_name_release": "${dist_name}{{'-release' if $build_layout == 'separation' else ''}}",
      "build_dir_debug": "${source_rootdir}\\${dist_name_debug}-build",
      "build_dir_release": "${source_rootdir}\\${dist_name_release}-build",
      "dist_dir_debug": "${dist_rootdir}\\${dist_name_debug}",
      "dist_dir_release": "${dist_rootdir}\\${dist_name_release}",
      "cache_file": "${cache_rootdir}\\${name}-${version}.7z",
      "git_url": "https://github.com/curl/curl.git",
      "git_tag": "{{$version.split('@', 1)[0] if '@' in $version else 'v' + $version}}",
      "git_hash": "{{$version.split('@', 1)[1] if '@' in $version else ''}}",
      "stages": {
        "download": {
          "scripts": [
            {
              "when": "{{os.path.isdir($source_dir)}}",
              "script": "rmdir /q /s \"$source_dir\""
            },
            {
              "message": "git clone.",
              "when": "{{not os.path.isdir($source_dir) and not os.path.isfile($cache_file)}}",
              "script": "git clone --no-progress --quiet -b \"$git_tag\" {{'' if $git_hash else '--depth 1'}} --single-branch --recurse-submodules --shallow-submodules $git_url \"$source_dir\"",
              "fallback": "rmdir /q /s \"$source_dir\""
            },
            {
              "message": "git checkout.",
              "when": "{{$git_hash and os.path.isdir($source_dir) and not os.path.isfile($cache_file)}}",
              "chdir": "$source_dir",
              "script": "git checkout $git_hash && git submodule update --init --recursive",
              "fallback": "rmdir /q /s \"$source_dir\""
            },
            {
              "message": "extract from cache.",
              "when": "{{not os.path.isdir($source_dir) and os.path.isfile($cache_file)}}",
              "script": "7z -sccUTF-8 x -aoa \"$cache_file\" -o\"$source_dir\"",
              "fallback": "rmdir /q /s \"$source_dir\""
            },
            {
              "message": "make cache.",
              "when": "{{not os.path.isfile($cache_file)}}",
              "script": "7z -sccUTF-8 a \"$cache_file\" \"$source_dir\\*\"",
              "fallback": "del \"$cache_file\""
            }
          ]
        },
        "configure": {
          "cmake_genarator": "-G \"Ninja Multi-Config\"",
          "cmake_options": [
            "-DCMAKE_FIND_PACKAGE_PREFER_CONFIG=ON",
            "-DCMAKE_FIND_LIBRARY_PREFIXES=\"lib\"",
            "-DCMAKE_CONFIGURATION_TYPES=\"$build_type\"",
            "-DCMAKE_MSVC_RUNTIME_LIBRARY=\"{{'MultiThreaded$<$<CONFIG:Debug>:Debug>DLL' if $msvc_runtime_library == 'md' else 'MultiThreaded$<$<CONFIG:Debug>:Debug>'}}\"",
            "-DBUILD_SHARED_LIBS={{'ON' if 'shared' in $build_library else 'OFF'}}",
            "-DCMAKE_C_FLAGS=\"/DNETTLE_VERSION_MAJOR=3\"",
            "-DCURL_USE_PKGCONFIG=OFF",
            "-DCURL_CA_NATIVE=ON",
            "-DCURL_ENABLE_SSL={{'ON' if $openssl_enable or $gnutls_enable or $wolfssl_enable or $mbedtls_enable or $schannel_enable else 'OFF'}}",
            "-DCURL_USE_OPENSSL={{'ON' if $openssl_enable else 'OFF'}}",
            "-DOPENSSL_USE_STATIC_LIBS='OFF'",
            "-DCURL_USE_GNUTLS={{'ON' if $gnutls_enable else 'OFF'}}",
            "-DCURL_USE_WOLFSSL={{'ON' if $wolfssl_enable else 'OFF'}}",
            "-DCURL_USE_MBEDTLS={{'ON' if $mbedtls_enable else 'OFF'}}",
            "-DCURL_USE_SCHANNEL={{'ON' if $schannel_enable else 'OFF'}}",
            "{{f'-DCURL_DEFAULT_SSL_BACKEND=\"{$tls_backend}\"' if $tls_backend is not None else ''}}",
            "-DCURL_USE_LIBPSL=ON",
            "-DUSE_NGHTTP2={{'ON' if $http2_enable else 'OFF'}}",
            "-DUSE_NGTCP2={{'ON' if $http3_enable else 'OFF'}}",
            "-DUSE_NGHTTP3={{'ON' if $http3_enable else 'OFF'}}",
            "-DHTTP_ONLY={{'ON' if $http_only_enable else 'OFF'}}",
            "-DCURL_BROTLI=ON",
            "-DCURL_ZSTD=ON",
            "-DBUILD_LIBCURL_DOCS=OFF",
            "-DBUILD_MISC_DOCS=OFF",
            "-DENABLE_CURL_MANUAL=OFF"
          ],
          "cmake_options_debug": [
            "-DCMAKE_INSTALL_PREFIX=\"$dist_dir_debug\""
          ],
          "cmake_options_release": [
            "-DCMAKE_INSTALL_PREFIX=\"$dist_dir_release\""
          ],
          "scripts": [
            {
              "when": "{{'Debug' in $build_type and $build_layout == 'separation'}}",
              "script": "rmdir /s /q \"$build_dir_debug\" & timeout /t 3 /nobreak > nul & mkdir \"$build_dir_debug\""
            },
            {
              "when": "{{'Release' in $build_type }}",
              "script": "rmdir /s /q \"$build_dir_release\" & timeout /t 3 /nobreak > nul & mkdir \"$build_dir_release\""
            },
            {
              "message": "config for debug.",
              "when": "{{'Debug' in $build_type and $build_layout == 'separation'}}",
              "environments": {
                "CMAKE_PREFIX_PATH": "$dependent_packages_debug",
                "PKG_CONFIG_PATH": "$pkg_config_path_debug",
                "PERLIO": "raw"
              },
              "script": "cmake $cmake_genarator {{' '.join($cmake_options)}} {{' '.join($cmake_options_debug)}} -S \"$source_dir\" -B \"$build_dir_debug\""
            },
            {
              "message": "config for release.",
              "when": "{{'Release' in $build_type}}",
              "environments": {
                "CMAKE_PREFIX_PATH": "$dependent_packages_release",
                "PKG_CONFIG_PATH": "$pkg_config_path_release",
                "PERLIO": "raw"
              },
              "script": "cmake $cmake_genarator {{' '.join($cmake_options)}} {{' '.join($cmake_options_release)}} -S \"$source_dir\" -B \"$build_dir_release\""
            }
          ]
        },
        "build": {
          "scripts": [
            {
              "message": "build for debug.",
              "when": "{{'Debug' in $build_type}}",
              "script": "cmake --build \"$build_dir_debug\" --config Debug -j4"
            },
            {
              "message": "build for release.",
              "when": "{{'Release' in $build_type}}",
              "script": "cmake --build \"$build_dir_release\" --config Release -j4"
            }
          ]
        },
        "install": {
          "scripts": [
            {
              "message": "install for debug.",
              "when": "{{'Debug' in $build_type}}",
              "script": "cmake --install \"$build_dir_debug\" --config Debug"
            },
            {
              "message": "install for release.",
              "when": "{{'Release' in $build_type}}",
              "script": "cmake --install \"$build_dir_release\" --config Release"
            }
          ]
        },
        "post-install" :{
          "environments": {
            "PERLIO": "raw"
          },
          "scripts": [
            {
              "when": "{{'Debug' in $build_type}}",
              "script": "forfiles -P \"$dist_dir_debug\" /M *.pc /S /C \"cmd /c perl ${assets_rootdir}\\fix_pcfile.pl @PATH 0x22{{dist_rootdir.replace('\\\\', '/')}}0x22 {{os.path.basename($dist_dir_debug)}}\"",
              "ignore_errors": true
            },
            {
              "when": "{{'Release' in $build_type}}",
              "script": "forfiles -P \"$dist_dir_release\" /M *.pc /S /C \"cmd /c perl \"${assets_rootdir}\\fix_pcfile.pl\" @PATH 0x22{{dist_rootdir.replace('\\\\', '/')}}0x22 {{os.path.basename($dist_dir_release)}}\"",
              "ignore_errors": true
            }
          ]
        }
      }
    },
    "8.10.1": {
      "git_tag": "curl-8_10_1"
    },
    "8.23.0": {
      "git_tag": "curl-8_23_0"
    }
  }
}

{
  "name": "grpc",
  "display": "gRPC",
  "description": "high-performance remote procedure call (RPC) framework.",
  "site": "https://grpc.io/",
  "license": "Apache-2.0",
  "category": "network",
  "info": "info.md",
  "process_time": 3600,
  "options": [
    {
      "display": "Version",
      "name": "version",
      "type": "choice",
      "items": "{{$versions}}",
      "default": "$latest_version"
    },
    {
      "display": "Visual Studio version",
      "name": "msvc_version",
      "type": "choice",
      "items": "{{$msvc_versions}}",
      "default": "$msvc_version_default"
    },
    {
      "display": "MSVC toolset version",
      "name": "msvc_toolset_version",
      "type": "choice",
      "items": "{{$msvc_toolset_versions}}",
      "default": "$msvc_toolset_version_default"
    },
    {
      "display": "Build arch",
      "name": "build_arch",
      "type": "choice",
      "items": [
        "x64",
        "x32"
      ],
      "default": "$build_arch_default"
    },
    {
      "display": "MSVC runtime library",
      "name": "msvc_runtime_library",
      "type": "choice",
      "items": [
        "mt",
        "md"
      ],
      "default": "$msvc_runtime_library_default"
    },
    {
      "display": "Build library",
      "name": "build_library",
      "enable": false,
      "type": "choice",
      "items": [
        "shared",
        "static"
      ],
      // "default": "$build_library_default"
      "default": "static" // Must be static; shared builds cause link errors.
    },
    {
      "display": "Build type",
      "name": "build_type",
      "type": "choice",
      "items": [
        "Release",
        "Debug",
        "Release;Debug"
      ],
      "default": "Release"
    },
    {
      "display": "Build layout",
      "name": "build_layout",
      "type": "choice",
      "items": [
        "union",
        "separation"
      ],
      "default": "union"
    },
    {
      "display": "Using CUDA",
      "name": "cuda_enable",
      "enable": false,
      "type": "bool",
      "default": false
    },
    {
      "display": "CUDA Version",
      "name": "cuda_version",
      "enable": "{{$cuda_enable}}",
      "type": "choice",
      "items": "{{$cuda_versions}}",
      "default": "{{$cuda_version_default}}"
    },
  ],
  "versions": {
    "default": {
      "dependencies": {
        "opentelemetry-cpp":{
          "version": ">=1.16.1"
        },
        "re2": {
          "version": ">=2024-07-02"
        },
        "icu4c":{
          "version": ">=75.0"
        },
        "openssl": {
          "version": ">=3.5;<3.6"
        },
        "zlib": {
          "version": ">=1.3"
        }
      },
      "source_dir": "${source_rootdir}\\${name}-${version}",
      "dist_name": "${name}-${version}{{'' if $build_library == 'interface' else '-' + $build_arch + '-' + $msvc_toolset_version + '-' + $msvc_runtime_library + (('-cu' + $cuda_version.replace('.','')) if $cuda_enable else '') + ('-static' if 'static' == $build_library else '')}}",
      "dist_name_debug": "${dist_name}{{'-debug' if $build_layout == 'separation' else ''}}",
      "dist_name_release": "${dist_name}{{'-release' if $build_layout == 'separation' else ''}}",
      "build_dir_debug": "${source_rootdir}\\${dist_name_debug}-build",
      "build_dir_release": "${source_rootdir}\\${dist_name_release}-build",
      "dist_dir_debug": "${dist_rootdir}\\${dist_name_debug}",
      "dist_dir_release": "${dist_rootdir}\\${dist_name_release}",
      "cache_file": "${cache_rootdir}\\${name}-${version}.7z",
      "git_url": "https://github.com/grpc/grpc.git",
      "git_tag": "{{$version.split('@', 1)[0] if '@' in $version else 'v' + $version}}",
      "git_hash": "{{$version.split('@', 1)[1] if '@' in $version else ''}}",
      "stages": {
        "download": {
          "scripts": [
            {
              "when": "{{os.path.isdir($source_dir)}}",
              "script": "rmdir /q /s \"$source_dir\""
            },
            {
              "message": "git clone.",
              "when": "{{not os.path.isdir($source_dir) and not os.path.isfile($cache_file)}}",
              "script": "git clone --no-progress --quiet -b \"$git_tag\" {{'' if $git_hash else '--depth 1'}} --single-branch --recurse-submodules --shallow-submodules $git_url \"$source_dir\"",
              "fallback": "rmdir /q /s \"$source_dir\""
            },
            {
              "message": "git checkout.",
              "when": "{{$git_hash and os.path.isdir($source_dir) and not os.path.isfile($cache_file)}}",
              "chdir": "$source_dir",
              "script": "git checkout $git_hash && git submodule update --init --recursive",
              "fallback": "rmdir /q /s \"$source_dir\""
            },
            {
              "message": "extract from cache.",
              "when": "{{not os.path.isdir($source_dir) and os.path.isfile($cache_file)}}",
              "script": "7z -sccUTF-8 x -aoa \"$cache_file\" -o\"$source_dir\"",
              "fallback": "rmdir /q /s \"$source_dir\""
            },
            {
              "message": "make cache.",
              "when": "{{not os.path.isfile($cache_file)}}",
              "script": "7z -sccUTF-8 a \"$cache_file\" \"$source_dir\\*\"",
              "fallback": "del \"$cache_file\""
            }
          ]
        },
        "patch": {
          "repo_url":"https://raw.githubusercontent.com/msys2/MSYS2-packages/refs/heads/master/libiconv",
          "patch_files": [],
          "scripts": [
            {
              // Patch Script: patching source code with patch_files
              "message": "Patch ${name} source code",
              "chdir": "$source_dir",
              "script": "{{' && '.join([(f'(if not exist \"{p[\"chdir\"]}\" mkdir \"{p[\"chdir\"]}\") && pushd \"{p[\"chdir\"]}\" && ' if 'chdir' in p else '') + (f'(if not exist \"{os.path.join(cache_rootdir, name + \"-\" + version)}\" mkdir \"{os.path.join(cache_rootdir, name + \"-\" + version)}\") && (if not exist \"{os.path.join(cache_rootdir, name + \"-\" + version, b)}\" (curl.exe --fail -L -s -o \"{os.path.join(cache_rootdir, name + \"-\" + version, b)}\" \"{p[\"remote\"]}\" || exit /b 1)) && patch --ignore-whitespace -t -b -p1 -i \"{os.path.join(cache_rootdir, name + \"-\" + version, b)}\"' if 'remote' in p else f'(if not exist \"{os.path.join(cache_rootdir, name + \"-\" + version)}\" mkdir \"{os.path.join(cache_rootdir, name + \"-\" + version)}\") && (if not exist \"{os.path.join(cache_rootdir, name + \"-\" + version, b)}\" (curl.exe --fail -L -s -o \"{os.path.join(cache_rootdir, name + \"-\" + version, b)}\" \"{p[\"fetch\"]}\" || exit /b 1)) && copy /Y \"{os.path.join(cache_rootdir, name + \"-\" + version, b)}\" \"{b}\"' if 'fetch' in p else f'patch --ignore-whitespace -t -b -p1 -i \"{p[\"local\"]}\"' if 'local' in p else f'copy /Y \"{p[\"copy\"]}\" \"{b}\"' if 'copy' in p else '') + f' && copy nul \"{os.path.join(source_dir, f\"__patched_{b}\")}\"' + (' && popd' if 'chdir' in p else '') for p in patch_files if p.get('when', True) is not False and (v := (p.get('remote') or p.get('local') or p.get('copy') or p.get('fetch'))) and (b := os.path.basename(v)) and not os.path.exists(os.path.join(source_dir, f'__patched_{b}'))])}}"
            }
          ]
        },
        "configure": {
          "cmake_genarator": "-G \"Ninja Multi-Config\"",
          "cmake_options": [
            "-DCMAKE_POLICY_VERSION_MINIMUM=3.5",
            "-DCMAKE_DEBUG_POSTFIX=d",
            "-DCMAKE_FIND_LIBRARY_PREFIXES=\"lib\"",
            "-DCMAKE_CONFIGURATION_TYPES=\"$build_type\"",
            "-DCMAKE_MSVC_RUNTIME_LIBRARY=\"{{'MultiThreaded$<$<CONFIG:Debug>:Debug>DLL' if $msvc_runtime_library == 'md' else 'MultiThreaded$<$<CONFIG:Debug>:Debug>'}}\"",
            "-DBUILD_SHARED_LIBS={{'ON' if 'shared' in $build_library else 'OFF'}}",
            "-DCMAKE_C_FLAGS=\"/bigobj\"",
            "-DCMAKE_CXX_FLAGS=\"/bigobj\"",
            "-DCMAKE_SHARED_LINKER_FLAGS=\"/LTCG\"",
            "-DgRPC_INSTALL=ON",
            "-DgRPC_BUILD_TESTS=OFF",
            "-DgRPC_MSVC_STATIC_RUNTIME={{'ON' if 'mt' in $msvc_runtime_library else 'OFF'}}",
            "-DgRPC_ABSL_PROVIDER=package",
            "-DgRPC_CARES_PROVIDER=module",
            "-DgRPC_PROTOBUF_PROVIDER=package",
            "-DgRPC_RE2_PROVIDER=package",
            "-DgRPC_SSL_PROVIDER=package",
            "-DgRPC_ZLIB_PROVIDER=package",
            "-DgRPC_USE_PROTO_LITE=OFF",
            "-DgRPC_BUILD_GRPC_CPP_PLUGIN=ON",
            "-DgRPC_BUILD_GRPCPP_OTEL_PLUGIN=OFF",  // This option must always be OFF
            "-DgRPC_BUILD_GRPC_CSHARP_PLUGIN=OFF",
            "-DgRPC_BUILD_GRPC_NODE_PLUGIN=ON",
            "-DgRPC_BUILD_GRPC_OBJECTIVE_C_PLUGIN=OFF",
            "-DgRPC_BUILD_GRPC_PHP_PLUGIN=OFF",
            "-DgRPC_BUILD_GRPC_PYTHON_PLUGIN=OFF",
            "-DgRPC_BUILD_GRPC_RUBY_PLUGIN=OFF"
          ],
          "cmake_options_debug": [
            "-DCMAKE_INSTALL_PREFIX=\"$dist_dir_debug\""
          ],
          "cmake_options_release": [
            "-DCMAKE_INSTALL_PREFIX=\"$dist_dir_release\""
          ],
          "scripts": [
            {
              "when": "{{'Debug' in $build_type and $build_layout == 'separation'}}",
              "script": "rmdir /s /q \"$build_dir_debug\" & timeout /t 3 /nobreak > nul & mkdir \"$build_dir_debug\""
            },
            {
              "when": "{{'Release' in $build_type }}",
              "script": "rmdir /s /q \"$build_dir_release\" & timeout /t 3 /nobreak > nul & mkdir \"$build_dir_release\""
            },
            {
              "message": "config for debug.",
              "when": "{{'Debug' in $build_type and $build_layout == 'separation'}}",
              "environments": {
                "CMAKE_PREFIX_PATH": "$dependent_packages_debug",
                "PKG_CONFIG_PATH": "$pkg_config_path_debug",
                "PERLIO": "raw"
              },
              "script": "cmake $cmake_genarator {{' '.join($cmake_options)}} {{' '.join($cmake_options_debug)}} -S \"$source_dir\" -B \"$build_dir_debug\""
            },
            {
              "message": "config for release.",
              "when": "{{'Release' in $build_type}}",
              "environments": {
                "CMAKE_PREFIX_PATH": "$dependent_packages_release",
                "PKG_CONFIG_PATH": "$pkg_config_path_release",
                "PERLIO": "raw"
              },
              "script": "cmake $cmake_genarator {{' '.join($cmake_options)}} {{' '.join($cmake_options_release)}} -S \"$source_dir\" -B \"$build_dir_release\""
            }
          ]
        },
        "build": {
          "scripts": [
            {
              "message": "build for debug.",
              "when": "{{'Debug' in $build_type}}",
              "environments": {
                "PATH": "{{';'.join(['%PATH%', $dependent_dlls_debug, f'{$build_dir_debug}/bin/Debug'])}}",
                "CMAKE_PREFIX_PATH": "$dependent_packages_debug",
                "PKG_CONFIG_PATH": "$pkg_config_path_debug"
              },
              "script": "cmake --build \"$build_dir_debug\" --config Debug -j4"
            },
            {
              "message": "build for release.",
              "when": "{{'Release' in $build_type}}",
              "environments": {
                "PATH": "{{';'.join(['%PATH%', $dependent_dlls_release, f'{$build_dir_release}/bin/Release'])}}",
                "CMAKE_PREFIX_PATH": "$dependent_packages_release",
                "PKG_CONFIG_PATH": "$pkg_config_path_release"
              },
              "script": "cmake --build \"$build_dir_release\" --config Release -j4"
            }
          ]
        },
        "install": {
          "scripts": [
            {
              "message": "install for debug.",
              "when": "{{'Debug' in $build_type}}",
              "script": "cmake --install \"$build_dir_debug\" --config Debug"
            },
            {
              "message": "install for release.",
              "when": "{{'Release' in $build_type}}",
              "script": "cmake --install \"$build_dir_release\" --config Release"
            }
          ]
        },
        "post-install" :{
          "environments": {
            "PERLIO": "raw"
          },
          "template_files":[
            {
              "when": "{{'Release' in $build_type}}",
              "template": "${assets_rootdir}\\activate.bat.j2",
              "defines": [
                "DEPENDENT_DLL_PATHS=\"{{$dependent_dlls_release.replace($dist_rootdir +'\\\\','')}}\""
              ],
              "output": "${dist_dir_release}\\bin\\activate.bat"
            }
          ],
          "scripts": [
            {
              "message": "Generate files from templates.",
              "script": "{{' && '.join([f\"(if not exist \\\"{os.path.dirname(tp['output'])}\\\" mkdir \\\"{os.path.dirname(tp['output'])}\\\") && jinja2 {(' '.join(['-D ' + d for d in tp['defines']]))} \\\"{tp['template']}\\\" > \\\"{tp['output']}\\\"\" for tp in ${template_files} if tp.get('when', True)])}}"
            },
            {
              "ignore_errors": true,
              "when": "{{'Debug' in $build_type}}",
              "script": "forfiles -P \"$dist_dir_debug\" /M *.pc /S /C \"cmd /c perl -p -i -e 0x22s#^prefix=.*#prefix=\\$${pcfiledir}/../..#g;s#^exec_prefix=.*#exec_prefix=\\$${prefix}#g;s#^libdir=.*#libdir=\\$${prefix}/lib#g;s#^includedir=.*#includedir=\\$${prefix}/include#g0x22 @PATH\""
            },
            {
              "ignore_errors": true,
              "when": "{{'Debug' in $build_type}}",
              "script": "forfiles -P \"$dist_dir_debug\" /M *.pc /S /C \"cmd /c perl -p -i -e 0x22s#$dist_rootdir_slash#\\$${prefix}/..#g0x22 @PATH\""
            },
            {
              "ignore_errors": true,
              "when": "{{'Release' in $build_type}}",
              "script": "forfiles -P \"$dist_dir_release\" /M *.pc /S /C \"cmd /c perl -p -i -e 0x22s#^prefix=.*#prefix=\\$${pcfiledir}/../..#g;s#^exec_prefix=.*#exec_prefix=\\$${prefix}#g;s#^libdir=.*#libdir=\\$${prefix}/lib#g;s#^includedir=.*#includedir=\\$${prefix}/include#g0x22 @PATH\""
            },
            {
              "ignore_errors": true,
              "when": "{{'Release' in $build_type}}",
              "script": "forfiles -P \"$dist_dir_release\" /M *.pc /S /C \"cmd /c perl -p -i -e 0x22s#$dist_rootdir_slash#\\$${prefix}/..#g0x22 @PATH\""
            }
          ]
        }
      }
    },
    "1.74.1": {  // grpc ver 1.74.1 is compatible with abseil-cpp ver 20250512.1, protobuf ver 31.1.
      "dependencies": {
        "abseil-cpp":{
          "version": "==20250512.1"   // grpc ver 1.74.1 is compatible with abseil-cpp ver 20250512.1
        },
        "protobuf": {
          "version": "==31.1"        // grpc ver 1.74.1 is compatible with protobuf ver 31.1
        }
      },
      "stages":{
        "patch": {
          "patch_files": [
            {
              "local": "${package_dir}\\grpc_1_74_1_cmake.diff"
            }
          ]
        }
      }
    },
    "1.84.0": {  // grpc ver 1.84.0 is compatible with abseil-cpp ver 20250512.1, protobuf ver 35.1.
      "dependencies": {
        "abseil-cpp":{
          "version": "==20250512.1"   // grpc ver 1.84.0  is compatible with abseil-cpp ver 20250512.1
        },
        "protobuf": {
          "version": "==35.1"        // grpc ver 1.84.0  is compatible with protobuf ver 35.1
        }
      },
      "stages":{
        "patch": {
          "patch_files": []
        }
      }
    }
  }
}

{
  "name": "frei0r",
  "display": "frei0r",
  "description": "A large collection of free and portable video plugins",
  "site": "https://frei0r.dyne.org/",
  "license": "GPL-2.0",
  "info": "info.md",
  "process_time": 300,
  "options": [
    {
      "display": "Version",
      "name": "version",
      "type": "choice",
      "items": "{{$versions}}",
      "default": "$latest_version"
    },
    {
      "display": "Visual Studio version",
      "name": "msvc_version",
      "type": "choice",
      "items": "{{$msvc_versions}}",
      "default": "$msvc_version_default"
    },
    {
      "display": "MSVC toolset version",
      "name": "msvc_toolset_version",
      "type": "choice",
      "items": "{{$msvc_toolset_versions}}",
      "default": "$msvc_toolset_version_default"
    },
    {
      "display": "Build arch",
      "name": "build_arch",
      "type": "choice",
      "items": [
        "x64",
        "x32"
      ],
      "default": "$build_arch_default"
    },
    {
      "display": "MSVC runtime library",
      "name": "msvc_runtime_library",
      "type": "choice",
      "items": [
        "mt",
        "md"
      ],
      "default": "$msvc_runtime_library_default"
    },
    {
      "display": "Build library",
      "name": "build_library",
      "enable": false,
      "type": "choice",
      "items": [
        "shared",
        "static"
      ],
      "default": "shared"
    },
    {
      "display": "Build type",
      "name": "build_type",
      "enable": false,
      "type": "choice",
      "items": [
        "Release",
        "Debug"
      ],
      "default": "Release"
    },
    {
      "display": "Build layout",
      "name": "build_layout",
      "enable":false,
      "type": "choice",
      "items": [
        "union",
        "separation"
      ],
      "default": "separation"
    },
    {
      "display": "Using CUDA",
      "name": "cuda_enable",
      "enable": false,
      "type": "bool",
      "default": false
    },
    {
      "display": "CUDA Version",
      "name": "cuda_version",
      "enable": "{{$cuda_enable}}",
      "type": "choice",
      "items": "{{$cuda_versions}}",
      "default": "{{$cuda_version_default}}"
    },
    {
      "display": "Without OpenCV",
      "name": "without_opencv",
      "type": "bool",
      "default": true
    },
    {
      "display": "Without Cairo",
      "name": "without_cairo",
      "type": "bool",
      "default": false
    },
    {
      "display": "Without Gavl",
      "name": "without_gavl",
      "type": "bool",
      "default": false
    }
  ],
  "versions": {
    "default": {
      "source_dir": "${source_rootdir}\\${name}-${version}",
      "dist_name": "${name}-${version}{{'' if $build_library == 'interface' else '-' + $build_arch + '-' + $msvc_toolset_version + '-' + $msvc_runtime_library + (('-cu' + $cuda_version.replace('.','')) if $cuda_enable else '') + ('-static' if 'static' == $build_library else '')}}",
      "dist_name_debug": "${dist_name}{{'-debug' if $build_layout == 'separation' else ''}}",
      "dist_name_release": "${dist_name}{{'-release' if $build_layout == 'separation' else ''}}",
      "build_dir_debug": "${source_rootdir}\\${dist_name_debug}-build",
      "build_dir_release": "${source_rootdir}\\${dist_name_release}-build",
      "dist_dir_debug": "${dist_rootdir}\\${dist_name_debug}",
      "dist_dir_release": "${dist_rootdir}\\${dist_name_release}",
      "cache_file": "${cache_rootdir}\\${name}-${version}.7z",
      "git_url": "https://github.com/dyne/frei0r.git",
      "git_tag": "{{$version.split('@', 1)[0] if '@' in $version else 'v' + $version}}",
      "git_hash": "{{$version.split('@', 1)[1] if '@' in $version else ''}}",
      "msys2_dir" : "${tools_rootdir}\\msys2\\msys64",
      "msys2_external_runtime_dir": "${msys2_dir}\\opt\\ucrt64",
      "msys2_bash": "\"${msys2_dir}\\usr\\bin\\bash.exe\" -lc ",
      "dependencies": {
        "opencv": {
          "enable": "{{not $without_opencv}}",
          "version": ">=4.13"
        },
        "cairo": {
          "enable": "{{not $without_cairo}}",
          "version": ">=1.18"
        },
        "gavl": {
          "enable": "{{not $without_gavl}}",
          "version": ">=1.4;<2.0"
        },
        "freetype": {
          "enable": "{{not $without_cairo}}",
          "version": ">=2.13"
        },
        "libpng": {
          "enable": "{{not $without_cairo}}",
          "version": ">=1.6"
        },
        "libjpeg-turbo": {
          "enable": "{{not $without_cairo}}",
          "version": ">=3.0"
        },
        "pixman":{
          "enable": "{{not $without_cairo}}",
          "version": ">=0.43"
        },
        "zlib": {
          "version": ">=1.3"
        },
        "brotli": {
          "version": ">=1.1"
        }
      },
      "environments": {
        "LC_ALL": "C",
        "MSYS": "winsymlinks:nativestrict",
        "MSYSTEM": "MSYS",
        "CHERE_INVOKING": "1",
        // "MSYS2_PATH_TYPE": "inherit",
        "CC": "/ucrt64/bin/gcc.exe",
        "CXX": "/ucrt64/bin/g++.exe",
        "LD": "/ucrt64/bin/ld.exe",
        "AR": "/ucrt64/bin/ar.exe",
        "RANLIB": "/ucrt64/bin/ranlib.exe",
        "STRIP": "/ucrt64/bin/strip.exe",
        "NM": "/ucrt64/bin/nm.exe",
        "OBJCOPY": "/ucrt64/bin/objcopy.exe",
        "OBJDUMP": "/ucrt64/bin/objdump.exe",
        "CPPFLAGS": "-I/opt/ucrt64/include",
        "LDFLAGS": "-L/opt/ucrt64/lib",
        "SED": "/usr/bin/sed.exe",
        "PERLIO": "raw",
        "CUDA_PATH": "{{os.path.join($cuda_root, f'v{$cuda_version}')  if $cuda_enable else ''}}",
        "CUDNN_PATH": "{{os.path.join($cuda_root, f'v{$cuda_version}')  if $cuda_enable else ''}}"
      },
      "stages": {
        "download": {
          "scripts": [
            {
              "when": "{{os.path.isdir($source_dir)}}",
              "script": "rmdir /q /s \"$source_dir\""
            },
            {
              "message": "git clone.",
              "when": "{{not os.path.isdir($source_dir) and not os.path.isfile($cache_file)}}",
              "script": "git clone --no-progress --quiet -b \"$git_tag\" {{'' if $git_hash else '--depth 1'}} --single-branch --recurse --shallow-submodules $git_url \"$source_dir\"",
              "fallback": "rmdir /q /s \"$source_dir\""
            },
            {
              "message": "git checkout.",
              "when": "{{$git_hash and os.path.isdir($source_dir) and not os.path.isfile($cache_file)}}",
              "chdir": "$source_dir",
              "script": "git checkout $git_hash",
              "fallback": "rmdir /q /s \"$source_dir\""
            },
            {
              "message": "extract from cache.",
              "when": "{{not os.path.isdir($source_dir) and os.path.isfile($cache_file)}}",
              "script": "7z -sccUTF-8 x -aoa \"$cache_file\" -o\"$source_dir\"",
              "fallback": "rmdir /q /s \"$source_dir\""
            },
            {
              "message": "make cache.",
              "when": "{{not os.path.isfile($cache_file)}}",
              "script": "7z -sccUTF-8 a \"$cache_file\" \"$source_dir\\*\"",
              "fallback": "del \"$cache_file\""
            }
          ]
        },
        "patch": {
          "msys2_require_runtimes": [
            {
              "name": "opencv",
              "enable": "{{not $without_opencv}}"
            },
            {
              "name": "cairo",
              "enable":"{{not $without_cairo}}",
              "add_prefix_lib": [
                "cairo.lib",
                "cairo-script-interpreter.lib"
              ]
            },
            {
              "name": "gavl",
              "enable":"{{not $without_gavl}}",
              "remove_prefix_pc": [
                "libgavl"
              ]
            },
            {
              "name": "freetype",
              "enable":"{{not $without_cairo}}",
              "add_prefix_lib": [
                "freetype.lib"
              ]
            },
            {
              "name": "libpng",
              "enable":"{{not $without_cairo}}"
            },
            {
              "name": "libjpeg-turbo",
              "enable":"{{not $without_cairo}}",
              "add_prefix_lib": [
                "jpeg.lib",
                "turbojpeg.lib"
              ]
            },
            {
              "name": "pixman",
              "enable":"{{not $without_cairo}}",
              "add_prefix_lib": [
                "pixman-1.lib"
              ]
            },
            {
              "name": "zlib"
            },
            {
              "name": "brotli"
            }
          ],
          "scripts": [
            {
              "message": "Clean /opt/ucrt64 directory in msys2",
              "script": "del /q /s \"$msys2_external_runtime_dir\" > nul",
              "ignore_errors": true
            },
            {
              // Copy runtime Script: with msys2_require_runtimes
              "message": "Copy runtime libraries to MSYS2",
              "when": "{{'msys2_require_runtimes' in globals() and not os.path.exists(os.path.join($msys2_external_runtime_dir, '__copied__'))}}",
              "script": "{{' && '.join([f'xcopy \"{src_dir}\" \"{msys2_external_runtime_dir}\" /s /e /i /y' for dpr in [dependent_packages_release.split(';')] for item in msys2_require_runtimes if item.get('when', True) for src_dir in dpr if item['name'] in src_dir]+ [f'copy nul > \"{os.path.join(msys2_external_runtime_dir, \"__copied__\")}\"'])}}"
            },
            {
              // Rename runtime Script: with msys2_require_runtimes
              "message": "Rename library files and rewrite pc files.",
              "when": "{{'msys2_require_runtimes' in globals() and not os.path.exists(os.path.join($msys2_external_runtime_dir, '__renamed__'))}}",
              "script": "{{' && '.join([cmd for item in $msys2_require_runtimes if item.get('when', True) for cmd in ([f'ren \"{p}\" \"lib{os.path.basename(p)}\"' for n in item.get('add_prefix_lib', []) for p in glob.glob(os.path.join($msys2_external_runtime_dir, '**', n), recursive=True)] + [f'perl -i.bak -pe \"if(/^Libs:/){{ s/-l{n}\\\\b/-l{n[3:] if n.startswith(\"lib\") else n}/g }}\" \"{p}\"' for n in item.get('remove_prefix_pc', []) for p in glob.glob(os.path.join($msys2_external_runtime_dir, '**', '*.pc'), recursive=True) if os.path.isfile(p) and any(re.search(rf'^Libs:.*-l{n}\\b', l) for l in [pathlib.Path(p).read_text(errors=\"ignore\")] for l in l.splitlines())])]+[f'copy nul > \"{os.path.join($msys2_external_runtime_dir, \"__renamed__\")}\"'])}}"
            }
          ]
        },
        "configure": {
          //"cmake_genarator": "-G \"${msvc_generator}\" -A {{'Win32' if ${build_arch} == 'x32' else 'x64'}} -Thost=x64",
          "cmake_genarator": "-G 'Ninja Multi-Config'",
          "cmake_options": [
            // "-DCMAKE_C_FLAGS=\"/utf-8 /Zc:char8_t- /Zm2000 /Od\"",
            // "-DCMAKE_CXX_FLAGS=\"/utf-8 /Zc:char8_t- /Zm2000 /Od\"",
            // "-DCMAKE_FIND_PACKAGE_PREFER_CONFIG=ON",
            "-D CMAKE_CONFIGURATION_TYPES=$build_type",
            // "-DCMAKE_MSVC_RUNTIME_LIBRARY=\"{{'MultiThreaded$<$<CONFIG:Debug>:Debug>DLL' if $msvc_runtime_library == 'md' else 'MultiThreaded$<$<CONFIG:Debug>:Debug>'}}\"",
            "-D BUILD_SHARED_LIBS={{'ON' if 'shared' in $build_library else 'OFF'}}",
            "-D WITHOUT_OPENCV={{'ON' if $without_opencv else 'OFF'}}",
            "-D WITHOUT_CAIRO={{'ON' if $without_cairo else 'OFF'}}",
            "-D WITHOUT_GAVL={{'ON' if $without_gavl else 'OFF'}}"
          ],
          "cmake_options_debug": [
            "-D CMAKE_INSTALL_PREFIX=/opt/${name}/debug"
          ],
          "cmake_options_release": [
            "-D CMAKE_INSTALL_PREFIX=/opt/${name}/release"
          ],
          "scripts": [
            {
              "when": "{{'Debug' in $build_type and $build_layout == 'separation'}}",
              "script": "del /q /s \"$build_dir_debug\" > nul",
              "ignore_errors": true
            },
            {
              "when": "{{'Release' in $build_type }}",
              "script": "del /q /s \"$build_dir_release\" > nul",
              "ignore_errors": true
            },
            {
              "when": "{{'Debug' in $build_type and not os.path.isdir($build_dir_debug)}}",
              "script": "mkdir \"$build_dir_debug\"",
              "ignore_errors": true
            },
            {
              "when": "{{'Release' in $build_type and not os.path.isdir($build_dir_release)}}",
              "script": "mkdir \"$build_dir_release\"",
              "ignore_errors": true
            },
            {
              "message": "config for debug.",
              "when": "{{'Debug' in $build_type and $build_layout == 'separation'}}",
              "chdir": "$source_dir",
              "bash_script": "cmake $cmake_genarator {{' '.join($cmake_options)}} {{' '.join($cmake_options_debug)}} -S .-B ../{{os.path.basename($build_dir_debug)}}",
              "script": "${msys2_bash} \"${bash_script}\""
            },
            {
              "message": "config for release.",
              "when": "{{'Release' in $build_type}}",
              "chdir": "$source_dir",
              "bash_script": "cmake $cmake_genarator {{' '.join($cmake_options)}} {{' '.join($cmake_options_release)}} -S '$source_dir' -B '$build_dir_release'",
              "script": "${msys2_bash} \"${bash_script}\""
            }
          ]
        },
        "build": {
          "scripts": [
            {
              "message": "Clean /opt/${name} directory in msys2",
              "bash_script": "rm -rf /opt/${name}/*",
              "script": "${msys2_bash} \"${bash_script}\"",
              "ignore_errors": false
            },
            {
              "message": "build for debug.",
              "when": "{{'Debug' in $build_type}}",
              "chdir": "$build_dir_debug",
              "bash_script": "cmake --build . --config Debug -j 1",
              "script": "${msys2_bash} \"${bash_script}\""
            },
            {
              "message": "build for release.",
              "when": "{{'Release' in $build_type}}",
              "chdir": "$build_dir_release",
              "bash_script": "cmake --build . --config Release -j 1",
              "script": "${msys2_bash} \"${bash_script}\""
            }
          ]
        },
        "install": {
          "scripts": [
            {
              "message": "install for debug.",
              "when": "{{'Debug' in $build_type}}",
              "chdir": "$build_dir_debug",
              "bash_script": "cmake --install . --config Debug",
              "script": "${msys2_bash} \"${bash_script}\""
            },
            {
              "message": "install for release.",
              "when": "{{'Release' in $build_type}}",
              "bash_script": "cmake --install . --config Release",
              "script": "${msys2_bash} \"${bash_script}\""
            },
            {
              "message": "Copy ${name} files for debug.",
              "when": "{{'Debug' in $build_type}}",
              "script": "xcopy \"${msys2_dir}\\opt\\${name}\\debug\" \"$dist_dir_debug\" /s /e /i /y"
            },
            {
              "message": "Copy ${name} files for release.",
              "when": "{{'Release' in $build_type}}",
              "script": "xcopy \"${msys2_dir}\\opt\\${name}\\release\" \"$dist_dir_release\" /s /e /i /y"
            }
          ]
        },
        "post-install": {
          "dist_rootdir_slash": "{{$dist_rootdir.replace('\\\\', '/')}}",
          "environments": {
            "PERLIO": "raw"
          },
          "scripts": [
            {
              "message": "Rename DLL files to be compatible with MSVC",
              "when":"{{'Debug' in $build_type}}",
              "chdir": "$dist_dir_debug\\lib",
              "script":"for %f in (*.dll.a) do @set \"fname=%f\" & cmd /v:on /c \"copy /y /b \"!fname!\" \"!fname:.dll.a=.lib!\"\"",
              "ignore_errors": true
            },
            {
              "message": "Rename DLL files to be compatible with MSVC",
              "when":"{{'Release' in $build_type }}",
              "chdir": "$dist_dir_release\\lib",
              "script":"for %f in (*.dll.a) do @set \"fname=%f\" & cmd /v:on /c \"copy /y /b \"!fname!\" \"!fname:.dll.a=.lib!\"\"",
              "ignore_errors": true
            },
            {
              "message": "Adjust paths and other configurations in *.pc",
              "when": "{{'Debug' in $build_type}}",
              "script": "forfiles -P \"$dist_dir_debug\" /M *.pc /S /C \"cmd /c perl ${assets_rootdir}\\fix_pcfile.pl @PATH 0x22${dist_rootdir_slash}0x22\"",
              "ignore_errors": true
            },
            {
              "message": "Adjust paths and other configurations in *.pc",
              "when": "{{'Release' in $build_type}}",
              "script": "forfiles -P \"$dist_dir_release\" /M *.pc /S /C \"cmd /c perl ${assets_rootdir}\\fix_pcfile.pl @PATH 0x22${dist_rootdir_slash}0x22\"",
              "ignore_errors": true
            },
            {
              "message": "Rewriting library names for linker options in .pc files , with -llib prefix ",
              "when": "{{'Debug' in $build_type}}",
              "script":"forfiles -P \"$dist_dir_debug\" /M *.pc /S /C \"cmd /c perl -i -pe \"if(/^Libs:/){s/-l(?!lib)/-llib/g}\" @path\""
            },
            {
              "message": "Rewriting library names for linker options in .pc files",
              "when": "{{'Release' in $build_type}}",
              "script":"forfiles -P \"$dist_dir_release\" /M *.pc /S /C \"cmd /c perl -i -pe \"if(/^Libs:/){s/-l(?!lib)/-llib/g}\" @path\""
            }
          ]
        }
      }
    },
    "3.1.2": {}
  }
}

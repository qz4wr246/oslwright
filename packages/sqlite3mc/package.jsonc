{
  "name": "sqlite3mc",
  "display": "SQLite3MultipleCiphers",
  "description": "SQLite3 encryption extension with support for multiple ciphers",
  "site": "https://utelle.github.io/SQLite3MultipleCiphers",
  "license": "MIT license",
  "info":"info.md",
  "process_time": "120",
  "settings": [
    {
      "display": "Version",
      "name": "version",
      "type": "chose",
      "item": "{{$versions}}",
      "default": "$latest_version"
    },
    {
      "display": "Build arch",
      "name": "build_arch",
      "type": "chose",
      "item": [
        "x64",
        "x32"
      ],
      "default": "$build_arch_default"
    },
    {
      "display": "MSVC toolset version",
      "name": "msvc_toolset_version",
      "type": "chose",
      "item": "{{$msvc_toolset_versions}}",
      "default": "$msvc_toolset_version_default"
    },
    {
      "display": "MSVC runtime library",
      "name": "msvc_runtime_library",
      "type": "chose",
      "item": [
        "mt",
        "md"
      ],
      "default": "$msvc_runtime_library_default"
    },
    {
      "display": "Build library",
      "name": "build_library",
      "type": "chose",
      "item": [
        "shared",
        "static"
      ],
      "default": "$build_library_default"
    },
    {
      "display": "Build type",
      "name": "build_type",
      "type": "chose",
      "item": [
        "Release",
        "Debug",
        "Release;Debug"
      ],
      "default": "Release"
    },
    {
      "display": "Build layout",
      "name": "build_layout",
      "type": "chose",
      "item": [
        "union",
        "separation"
      ],
      "default": "union"
    },
    {
      "display": "Using CUDA",
      "name": "cuda_enable",
      "enable": false,
      "type": "bool",
      "default": false
    },
    {
      "display": "CUDA Version",
      "name": "cuda_version",
      "enable": false,
      "type": "chose",
      "item": "{{$cuda_versions}}",
      "default": "{{$cuda_version_default}}"
    },
    {
      "display": "Build shell",
      "name": "build_shell",
      "type": "bool",
      "default": true
    },
    {
      "display": "Threading mode",
      "name": "sqlite_threadsafe",
      "type": "chose",
      "item": [
        "single-threaded:0",
        "serialized:1",
        "multi-threaded:2"
      ],
      "default": "multi-threaded:2"
    },
    {
      "display": "Enable memory security",
      "name": "secure_memory",
      "type": "bool",
      "default": true
    },
    {
      "display": "Enable compress",
      "name": "enable_compress",
      "type": "bool",
      "default": true
    },
    {
      "display": "With Zlib",
      "name": "with_zlib",
      "enable": "enable_compress",
      "type": "chose",
      "item": [
        "none",
        "shared",
        "static"
      ],
      "default": "$build_library_default"
    },
    {
      "display": "With ICU",
      "name": "with_icu",
      "type": "bool",
      "default": true
    }
  ],
  "versions": {
    "default": {
      "dependencies": {
        "zlib": {
          "enable": "{{True if not $with_zlib == 'none' else False}}",
          "version": ">=1.3",
          "build_library": "$with_zlib"
        },
        "icu4c":{
          "enable": "{{$with_icu}}",
          "version": ">=75.0"
        }
      },
      "source_dir": "${source_rootdir}\\${name}-${version}",
      "dist_name": "${name}-${version}{{'' if $build_library == 'interface' else '-' + $build_arch + '-' + $msvc_toolset_version + '-' + $msvc_runtime_library + (('-cu' + $cuda_version.replace('.','')) if $cuda_enable else '') + ('-static' if 'static' == $build_library else '')}}",
      "dist_name_debug": "${dist_name}{{'-debug' if $build_layout == 'separation' else ''}}",
      "dist_name_release": "${dist_name}{{'-release' if $build_layout == 'separation' else ''}}",
      "build_dir_debug": "${source_rootdir}\\${dist_name_debug}-build",
      "build_dir_release": "${source_rootdir}\\${dist_name_release}-build",
      "dist_dir_debug": "${dist_rootdir}\\${dist_name_debug}",
      "dist_dir_release": "${dist_rootdir}\\${dist_name_release}",
      "cache_file": "${cache_rootdir}\\${name}-${version}.7z",
      "git_url": "https://github.com/utelle/SQLite3MultipleCiphers.git",
      "git_tag": "v${version}",
      "stages": {
        "download": {
          "scripts": [
            {
              "when": "{{not os.path.isdir($source_dir) and not os.path.isfile($cache_file)}}",
              "script": "git clone -b \"$git_tag\" --depth 1 --single-branch --recurse --shallow-submodules $git_url \"$source_dir\"",
              "failed": "rmdir /q /s \"$source_dir\""
            },
            {
              "when": "{{not os.path.isdir($source_dir) and os.path.isfile($cache_file)}}",
              "script": "7z x -aoa \"$cache_file\" -o\"$source_dir\"",
              "failed": "rmdir /q /s \"$source_dir\""
            },
            {
              "when": "{{not os.path.isfile($cache_file)}}",
              "script": "7z a \"$cache_file\" \"$source_dir\\*\"",
               "failed": "del \"$cache_file\""
            }
          ]
        },
        "patch": {
          "patch_file_01": "${package_dir}\\sqlite3mc_cmake.diff",
          "patch_file_02": "${package_dir}\\sqlite3mc_src-fix.diff",
          "scripts": [
            {
              "when": "{{not os.path.isfile(os.path.join($source_dir, '__patched_' + os.path.basename($patch_file_01)))}}",
              "chdir": "$source_dir",
              "script": "git apply \"$patch_file_01\" && copy nul > {{'__patched_' + os.path.basename($patch_file_01)}}"
            },
            {
              "when": "{{not os.path.isfile(os.path.join($source_dir, '__patched_' + os.path.basename($patch_file_02)))}}",
              "chdir": "$source_dir",
              "script": "git apply \"$patch_file_02\" && copy nul > {{'__patched_' + os.path.basename($patch_file_02)}}"
            }
          ]
        },
        "configure": {
          "cmake_genarator": "-G \"${msvc_generator}\" -A {{'Win32' if $build_arch == 'x32' else 'x64'}}",
          "cmake_options": [
            "-DCMAKE_CONFIGURATION_TYPES=\"$build_type\"",
            "-DSQLITE3MC_STATIC_RUNTIME_LINK={{'OFF' if $msvc_runtime_library == 'md' else 'ON'}}",
            "-DSQLITE_THREADSAFE={{$sqlite_threadsafe.split(':')[1]}}",
            "-DSQLITE3MC_STATIC={{'ON' if 'static' == $build_library else 'OFF'}}",
            "-DSQLITE3MC_BUILD_SHELL={{'ON' if $build_shell else 'OFF'}}",
            "-DSQLITE3MC_WITH_ICU={{'ON' if $with_icu else 'OFF'}}",
            "-DSQLITE_ENABLE_COMPRESS={{'ON' if $enable_compress else 'OFF'}}",
            "-DSQLITE_ENABLE_ZIPFILE={{'ON' if $with_zlib != 'none' else 'OFF'}}",
            "-DSQLITE3MC_SECURE_MEMORY={{'ON' if $secure_memory else 'OFF'}}"
          ],
          "cmake_options_debug": [
            "-DCMAKE_INSTALL_PREFIX=\"$dist_dir_debug\"",
            "-DSQLITE_ENABLE_DEBUG=ON"
          ],
          "cmake_options_release": [
            "-DCMAKE_INSTALL_PREFIX=\"$dist_dir_release\"",
            "-DSQLITE_ENABLE_DEBUG=OFF"
          ],
          "scripts": [
            {
              "ignore_errors": true,
              "when": "{{'Debug' in $build_type and $build_layout == 'separation'}}",
              "script": "del /q /s \"$build_dir_debug\" > nul"
            },
            {
              "ignore_errors": true,
              "when": "{{'Release' in $build_type }}",
              "script": "del /q /s \"$build_dir_release\" > nul"
            },
            {
              "ignore_errors": true,
              "when": "{{'Debug' in $build_type and not os.path.isdir($build_dir_debug)}}",
              "script": "mkdir \"$build_dir_debug\""
            },
            {
              "ignore_errors": true,
              "when": "{{'Release' in $build_type and not os.path.isdir($build_dir_release)}}",
              "script": "mkdir \"$build_dir_release\""
            },
            {
              "message": "config for debug.",
              "when": "{{'Debug' in $build_type and $build_layout == 'separation'}}",
              "environments": {
                "CMAKE_PREFIX_PATH": "$dependent_packages_debug",
                "PKG_CONFIG_PATH": "$pkg_config_path_debug",
                "PERLIO": "raw"
              },
              "script": "cmake $cmake_genarator {{' '.join($cmake_options)}} {{' '.join($cmake_options_debug)}} -S \"$source_dir\" -B \"$build_dir_debug\""
            },
            {
              "message": "config for release.",
              "when": "{{'Release' in $build_type}}",
              "environments": {
                "CMAKE_PREFIX_PATH": "$dependent_packages_release",
                "PKG_CONFIG_PATH": "$pkg_config_path_release",
                "PERLIO": "raw"
              },
              "script": "cmake $cmake_genarator {{' '.join($cmake_options)}} {{' '.join($cmake_options_release)}} -S \"$source_dir\" -B \"$build_dir_release\""
            }
          ]
        },
        "build": {
          "scripts": [
            {
              "message": "build for debug.",
              "when": "{{'Debug' in $build_type}}",
              "script": "cmake --build \"$build_dir_debug\" --config Debug -j4"
            },
            {
              "message": "build for release.",
              "when": "{{'Release' in $build_type}}",
              "script": "cmake --build \"$build_dir_release\" --config Release -j4"
            }
          ]
        },
        "install": {
          "scripts": [
            {
              "message": "install for debug.",
              "when": "{{'Debug' in $build_type}}",
              "script": "cmake --install \"$build_dir_debug\" --config Debug"
            },
            {
              "message": "install for release.",
              "when": "{{'Release' in $build_type}}",
              "script": "cmake --install \"$build_dir_release\" --config Release"
            }
          ]
        },
        "post-install" :{
          "dist_rootdir_slash":"{{$dist_rootdir.replace('\\\\', '/')}}",
          "environments": {
            "PERLIO": "raw"
          },
          "scripts": [
            {
              "ignore_errors": true,
              "when": "{{'Debug' in $build_type}}",
              "script": "forfiles -P \"$dist_dir_debug\" /M *.pc /S /C \"cmd /c perl -p -i -e 0x22s#^prefix=.*#prefix=\\$${pcfiledir}/../..#g;s#^exec_prefix=.*#exec_prefix=\\$${prefix}#g;s#^libdir=.*#libdir=\\$${prefix}/lib#g;s#^includedir=.*#includedir=\\$${prefix}/include#g0x22 @PATH\""
            },
            {
              "ignore_errors": true,
              "when": "{{'Debug' in $build_type}}",
              "script": "forfiles -P \"$dist_dir_debug\" /M *.pc /S /C \"cmd /c perl -p -i -e 0x22s#$dist_rootdir_slash#\\$${prefix}/..#g0x22 @PATH\""
            },
            {
              "ignore_errors": true,
              "when": "{{'Release' in $build_type}}",
              "script": "forfiles -P \"$dist_dir_release\" /M *.pc /S /C \"cmd /c perl -p -i -e 0x22s#^prefix=.*#prefix=\\$${pcfiledir}/../..#g;s#^exec_prefix=.*#exec_prefix=\\$${prefix}#g;s#^libdir=.*#libdir=\\$${prefix}/lib#g;s#^includedir=.*#includedir=\\$${prefix}/include#g0x22 @PATH\""
            },
            {
              "ignore_errors": true,
              "when": "{{'Release' in $build_type}}",
              "script": "forfiles -P \"$dist_dir_release\" /M *.pc /S /C \"cmd /c perl -p -i -e 0x22s#$dist_rootdir_slash#\\$${prefix}/..#g0x22 @PATH\""
            }
          ]
        }
      }
    },
    "1.8.6": {}
  }
}
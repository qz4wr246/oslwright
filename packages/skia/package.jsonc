{
  "name": "skia",
  "display": "skia",
  "description": "A complete 2D graphic library for drawing Text, Geometries, and Images",
  "site": "https://skia.org/",
  "license": "BSD-3-Clause",
  "category": "graphic",
  "info": "info.md",
  "process_time": 1750,
  "options": [
    {
      "display": "Version",
      "name": "version",
      "type": "choice",
      "items": "{{$versions}}",
      "default": "$latest_version"
    },
    {
      "display": "Visual Studio version",
      "name": "msvc_version",
      "type": "choice",
      "items": "{{$msvc_versions}}",
      "default": "$msvc_version_default"
    },
    {
      "display": "MSVC toolset version",
      "name": "msvc_toolset_version",
      "type": "choice",
      "items": "{{$msvc_toolset_versions}}",
      "default": "$msvc_toolset_version_default"
    },
    {
      "display": "Build arch",
      "name": "build_arch",
      "type": "choice",
      "items": [
        "x64",
        "x32"
      ],
      "default": "$build_arch_default"
    },
    {
      "display": "MSVC runtime library",
      "name": "msvc_runtime_library",
      "type": "choice",
      "items": [
        "mt",
        "md"
      ],
      "default": "$msvc_runtime_library_default"
    },
    {
      "display": "Build library",
      "name": "build_library",
      "type": "choice",
      "items": [
        "shared",
        "static"
      ],
      "default": "static"
    },
    {
      "display": "Build type",
      "name": "build_type",
      "type": "choice",
      "items": [
        "Release",
        "Debug"
      ],
      "default": "Release"
    },
    {
      "display": "Build layout",
      "name": "build_layout",
      "enable": false,
      "type": "choice",
      "items": [
        "union",
        "separation"
      ],
      "default": "separation"
    },
    {
      "display": "Using CUDA",
      "name": "cuda_enable",
      "enable": false,
      "type": "bool",
      "default": false
    },
    {
      "display": "CUDA Version",
      "name": "cuda_version",
      "enable": "{{$cuda_enable}}",
      "type": "choice",
      "items": "{{$cuda_versions}}",
      "default": "{{$cuda_version_default}}"
    },
    {
      "display": "Using External Library",
      "name": "using_external",
      "type": "bool",
      "default": true
    }
  ],
  "versions": {
    "default": {
      "dependencies": {
        "abseil-cpp":{
          "enable": "{{$using_external}}",
          "version": "==20250512.1"
        },
        "fontconfig": {
          "enable": "{{$using_external}}",
          "version": ">=2.15"
        },
        "freetype": {
          "enable": "{{$using_external}}",
          "version": ">=2.13"
        },
        "harfbuzz": {
          "enable": "{{$using_external}}",
          "version": ">=9.0"
        },
        "icu4c":{
          "enable": "{{$using_external}}",
          "version": ">=75.0"
        },
        "libavif":{
          "enable": "{{$using_external}}",
          "version": ">=1.4"
        },
        "libexpat":{
          "enable": "{{$using_external}}",
          "version": ">=2.6"
        },
        "libpng": {
          "enable": "{{$using_external}}",
          "version": ">=1.6"
        },
        "libjpeg-turbo": {
          "enable": "{{$using_external}}",
          "version": ">=3.0"
        },
        "libwebp": {
          "enable": "{{$using_external}}",
          "version": ">=1.4"
        },
        "zlib": {
          "enable": "{{$using_external}}",
          "version": ">=1.3"
        }
      },
      "environments": {
        "PERLIO": "raw",
        "CUDA_PATH": "{{os.path.join($cuda_root, f'v{$cuda_version}')  if $cuda_enable else ''}}",
        "CUDNN_PATH": "{{os.path.join($cuda_root, f'v{$cuda_version}')  if $cuda_enable else ''}}"
      },
      "base_dir": "${source_rootdir}\\${name}-${version}",
      "source_dir": "${base_dir}\\skia",
      "dist_name": "${name}-${version}{{'' if $build_library == 'interface' else '-' + $build_arch + '-' + $msvc_toolset_version + '-' + $msvc_runtime_library + (('-cu' + $cuda_version.replace('.','')) if $cuda_enable else '') + ('-static' if 'static' == $build_library else '')}}",
      "dist_name_debug": "${dist_name}{{'-debug' if $build_layout == 'separation' else ''}}",
      "dist_name_release": "${dist_name}{{'-release' if $build_layout == 'separation' else ''}}",
      "build_dir_debug": "${source_rootdir}\\${dist_name_debug}-build",
      "build_dir_release": "${source_rootdir}\\${dist_name_release}-build",
      "dist_dir_debug": "${dist_rootdir}\\${dist_name_debug}",
      "dist_dir_release": "${dist_rootdir}\\${dist_name_release}",
      "cache_file": "${cache_rootdir}\\${name}-${version}.7z",
      "git_url": "https://skia.googlesource.com/skia",
      "git_tag": "{{$version.split('@', 1)[0] if '@' in $version else 'v' + $version}}",
      "git_hash": "{{$version.split('@', 1)[1] if '@' in $version else ''}}",
      "stages": {
        "download": {
          "scripts": [
            {
              "when": "{{os.path.isdir($base_dir)}}",
              "script": "rmdir /q /s \"$base_dir\""
            },
            {
              "message": "git clone.",
              "when": "{{not os.path.isdir($source_dir) and not os.path.isfile($cache_file)}}",
              "script": "(if not exist \"$base_dir\" mkdir \"$base_dir\") & git clone --no-progress --quiet -b \"$git_tag\" {{'' if $git_hash else '--depth 1'}} --single-branch --recurse-submodules --shallow-submodules $git_url \"$source_dir\"",
              "fallback": "rmdir /q /s \"$source_dir\""
            },
            {
              "message": "copy .gclient",
              "when": "{{not os.path.isfile(os.path.join($base_dir, '.gclient'))}}",
              "script": "(if not exist \"$base_dir\" mkdir \"$base_dir\") & copy /y \"$package_dir\\gclient\" \"$base_dir\\.gclient\""
            },
            {
              "message": "gclient sysc",
              "when": "{{os.path.isdir($source_dir) and not os.path.isfile($cache_file)}}",
              "chdir": "$base_dir",
              "script": "gclient sync --no-history --shallow",
              "fallback": "rmdir /q /s \"$source_dir\""
            },
            {
              "message": "extract from cache.",
              "when": "{{not os.path.isdir($source_dir) and os.path.isfile($cache_file)}}",
              "script": "7z -sccUTF-8 x -snld -aoa \"$cache_file\" -o\"$source_dir\"",
              "fallback": "rmdir /q /s \"$source_dir\""
            },
            {
              "message": "make cache.",
              "when": "{{not os.path.isfile($cache_file)}}",
              "script": "7z -sccUTF-8 a -snl \"$cache_file\" \"$source_dir\\*\"",
              "fallback": "del \"$cache_file\""
            }
          ]
        },
        "patch": {
          "template_files":[],
          "patch_files": [],
          "scripts": [
            {
              // Template script: genrate files with template_files
              "message": "Generate files from templates.",
              "script": "{{' && '.join([f\"(if not exist \\\"{os.path.dirname(tp['output'])}\\\" mkdir \\\"{os.path.dirname(tp['output'])}\\\") && jinja2 {(' '.join(['-D ' + d for d in tp['defines']]))} \\\"{tp['template']}\\\" > \\\"{tp['output']}\\\"\" for tp in ${template_files} if tp.get('when', True)])}}"
            },
            {
              // Patch Script: patching source code with patch_files
              "message": "Patch ${name} source code",
              "chdir": "$source_dir",
              "script": "{{' && '.join([(f'(if not exist \"{p[\"chdir\"]}\" mkdir \"{p[\"chdir\"]}\") && pushd \"{p[\"chdir\"]}\" && ' if 'chdir' in p else '') + (f'(if not exist \"{os.path.join(cache_rootdir, name + \"-\" + version)}\" mkdir \"{os.path.join(cache_rootdir, name + \"-\" + version)}\") && (if not exist \"{os.path.join(cache_rootdir, name + \"-\" + version, b)}\" (curl.exe --fail -L -s -o \"{os.path.join(cache_rootdir, name + \"-\" + version, b)}\" \"{p[\"remote\"]}\" || exit /b 1)) && patch --ignore-whitespace -t -b -p1 -i \"{os.path.join(cache_rootdir, name + \"-\" + version, b)}\"' if 'remote' in p else f'(if not exist \"{os.path.join(cache_rootdir, name + \"-\" + version)}\" mkdir \"{os.path.join(cache_rootdir, name + \"-\" + version)}\") && (if not exist \"{os.path.join(cache_rootdir, name + \"-\" + version, b)}\" (curl.exe --fail -L -s -o \"{os.path.join(cache_rootdir, name + \"-\" + version, b)}\" \"{p[\"fetch\"]}\" || exit /b 1)) && copy /Y \"{os.path.join(cache_rootdir, name + \"-\" + version, b)}\" \"{b}\"' if 'fetch' in p else f'patch --ignore-whitespace -t -b -p1 -i \"{p[\"local\"]}\"' if 'local' in p else f'copy /Y \"{p[\"copy\"]}\" \"{b}\"' if 'copy' in p else '') + f' && copy nul \"{os.path.join(source_dir, f\"__patched_{b}\")}\"' + (' && popd' if 'chdir' in p else '') for p in patch_files if p.get('when', True) is not False and (v := (p.get('remote') or p.get('local') or p.get('copy') or p.get('fetch'))) and (b := os.path.basename(v)) and not os.path.exists(os.path.join(source_dir, f'__patched_{b}'))])}}"
            }
          ]
        },
        "configure": {
          "gn_options": [
            "is_official_build=true",
            "is_component_build={{'false' if $build_library == 'static' else 'true'}}", // false is static, true is dynamic
            "target_os=\"win\"",
            "target_cpu=\"$build_arch\"",
            "cc=\"msvc\"",
            "cxx=\"msvc\"",
            "werror=false",
            "skia_use_vulkan=false",
            "skia_use_direct3d=false",
            "skia_use_dawn=false",
            "skia_use_gl=true",
            "skia_enable_android_utils=false",
            "skia_enable_spirv_validation=false",
            "skia_enable_tools=false",
            "skia_enable_gpu_debug_layers=false",
            "skia_enable_pdf=true",
            "skia_use_lua=false",
            "skia_use_dng_sdk=false",
            "skia_use_wuffs=false",
            "skia_use_xps=false",
            "skia_use_expat=true",
            "skia_use_system_expat={{'true' if $using_external else 'false'}}",
            "skia_use_libwebp_decode=true",
            "skia_use_libwebp_encode=true",
            "skia_use_system_libwebp={{'true' if $using_external else 'false'}}",
            "skia_use_libpng_decode=true",
            "skia_use_libpng_encode=true",
            "skia_use_system_libpng={{'true' if $using_external else 'false'}}",
            "skia_use_libjpeg_turbo_decode=true",
            "skia_use_libjpeg_turbo_encode=true",
            "skia_use_jpeg_gainmaps=false",
            "skia_use_system_libjpeg_turbo={{'true' if $using_external else 'false'}}",
            "skia_use_harfbuzz=true",
            "skia_use_system_harfbuzz={{'true' if $using_external else 'false'}}",
            "skia_use_icu=true",
            "skia_use_system_icu={{'true' if $using_external else 'false'}}",
            "skia_use_zlib=true",
            "skia_use_system_zlib={{'true' if $using_external else 'false'}}",
            "skia_enable_skshaper_tests=false",
            "skunicode_tests_enabled=false",
            "paragraph_tests_enabled=false",
            "skia_compile_sksl_tests=false"
          ],
          "gn_options_debug": [
            "is_debug=true",
            "extra_cflags=[\"/{{'MDd' if 'md' == $msvc_runtime_library else 'MTd'}}\",{{','.join([f'\"-I{os.path.join(p, 'include')}\"' for p in $dependent_packages_debug.split(';') if p])}}]",
            "extra_ldflags=[{{','.join([f'\"/LIBPATH:{p}\"' for p in dependent_libs_debug.split(';') if p])}}]"
          ],
          "gn_options_release": [
            "is_debug=false",
            "extra_cflags=[\"/{{'MD' if 'md' == $msvc_runtime_library else 'MT'}}\",{{','.join([f'\"-I{os.path.join(p, 'include')}\"' for p in $dependent_packages_release.split(';') if p])}}]",
            "extra_ldflags=[{{','.join([f'\"/LIBPATH:{p}\"' for p in dependent_libs_release.split(';') if p])}}]"
          ],
          "scripts": [
            {
              "when": "{{'Debug' in $build_type and $build_layout == 'separation'}}",
              "script": "rmdir /s /q \"$build_dir_debug\" & timeout /t 3 /nobreak > nul & mkdir \"$build_dir_debug\""
            },
            {
              "when": "{{'Release' in $build_type }}",
              "script": "rmdir /s /q \"$build_dir_release\" & timeout /t 3 /nobreak > nul & mkdir \"$build_dir_release\""
            },
            {
              "message": "config for debug.",
              "when": "{{'Debug' in $build_type and $build_layout == 'separation'}}",
              "environments": {
                "CMAKE_PREFIX_PATH": "$dependent_packages_debug",
                "PKG_CONFIG_PATH": "$pkg_config_path_debug",
                "PERLIO": "raw"
              },
              "chdir": "$source_dir",
              "script": "gn.exe gen \"$build_dir_release\" --args=\"{{' '.join($gn_options).replace(chr(34), '\\\\' + chr(34))}} {{' '.join($gn_options_debug).replace(chr(34), '\\\\' + chr(34))}}\""
            },
            {
              "message": "config for release.",
              "when": "{{'Release' in $build_type}}",
              "environments": {
                "CMAKE_PREFIX_PATH": "$dependent_packages_release",
                "PKG_CONFIG_PATH": "$pkg_config_path_release",
                "PERLIO": "raw"
              },
              "chdir": "$source_dir",
              "script": "gn.exe gen \"$build_dir_release\" --args=\"{{' '.join($gn_options).replace(chr(34), '\\\\' + chr(34))}} {{' '.join($gn_options_release).replace(chr(34), '\\\\' + chr(34))}}\""
            },
            {
              "message": "fix harfbuzz include path",
              "when": "{{'Debug' in $build_type and $using_external}}",
              "chdir": "$build_dir_debug",
              "script": "for /R %i in (*.ninja) do perl -i -pe \"s/(-I[^\\s]*harfbuzz-[^\\s]*\\\\include)(?=\\s|$$)/$$1\\\\harfbuzz/g\" \"%i\""
            },
            {
              "message": "fix harfbuzz include path",
              "when": "{{'Release' in $build_type and $using_external}}",
              "chdir": "$build_dir_release",
              "script": "for /R %i in (*.ninja) do perl -i -pe \"s/(-I[^\\s]*harfbuzz-[^\\s]*\\\\include)(?=\\s|$$)/$$1\\\\harfbuzz/g\" \"%i\""

            },
            {
              "message":"fix fiddle_examples.ninja",
              "when": "{{'Debug' in $build_type and $using_external}}",
              "chdir": "$build_dir_debug\\obj",
              "script": "for /R %i in (*.ninja) do perl -i -pe \"if (/^\\s*libs\\s*=/) { s/(?<!\\S)png(?!\\S)/png16.lib/g; s/(?<!\\S)jpeg(?!\\S)/jpeg.lib/g; s/(?<!\\S)z(?!\\S)/zlib.lib/g; s/(?<!\\S)harfbuzz-subset(?!\\S)/harfbuzz-subset.lib/g; s/(?!\\S)harfbuzz(?!\\S)/harfbuzz.lib/g; s/(?<!\\S)webp(?!\\S)/libwebp.lib/g; s/(?<!\\S)webpdemux(?!\\S)/libwebpdemux.lib/g; s/(?<!\\S)webpmux(?!\\S)/libwebpmux.lib/g; s/(?<!\\S)expat(?!\\S)/libexpat.lib/g; s/(?<!\\S)icuuc(?!\\S)/icuuc.lib/g; }\" \"%i\""
            },
            {
              "message":"fix fiddle_examples.ninja",
              "when": "{{'Release' in $build_type and $using_external}}",
              "chdir": "$build_dir_release\\obj",
              "script": "for /R %i in (*.ninja) do perl -i -pe \"if (/^\\s*libs\\s*=/) { s/(?<!\\S)png(?!\\S)/png16.lib/g; s/(?<!\\S)jpeg(?!\\S)/jpeg.lib/g; s/(?<!\\S)z(?!\\S)/zlib.lib/g; s/(?<!\\S)harfbuzz-subset(?!\\S)/harfbuzz-subset.lib/g; s/(?<!\\S)harfbuzz(?!\\S)/harfbuzz.lib/g; s/(?<!\\S)webp(?!\\S)/libwebp.lib/g; s/(?<!\\S)webpdemux(?!\\S)/libwebpdemux.lib/g; s/(?<!\\S)webpmux(?!\\S)/libwebpmux.lib/g; s/(?<!\\S)expat(?!\\S)/libexpat.lib/g; s/(?<!\\S)icuuc(?!\\S)/icuuc.lib/g; }\" \"%i\""
            }
          ]
        },
        "build": {
          "scripts": [
            {
              "message": "build for debug.",
              "when": "{{'Debug' in $build_type}}",
              "script": "ninja -C \"$build_dir_debug\" all"
            },
            {
              "message": "build for release.",
              "when": "{{'Release' in $build_type}}",
              "script": "ninja -C \"$build_dir_release\" all"
            }
          ]
        },
        "install": {
          "template_files": [
            {
              "when": "{{'Debug' in $build_type}}",
              "template": "${package_dir}\\skia.pc.j2",
              "defines": [
                "VERSION=\"$version\"",
                "SHARED={{'true' if $build_library in'shared' else 'false'}}"
              ],
              "output": "$dist_dir_debug\\lib\\pkgconfig\\skia.pc"
            },
            {
              "when": "{{'Release' in $build_type}}",
              "template": "${package_dir}\\skia.pc.j2",
              "defines": [
                "VERSION=\"$version\"",
                "SHARED={{'true' if 'shared' in $build_library else 'false'}}"
              ],
              "output": "$dist_dir_release\\lib\\pkgconfig\\skia.pc"
            }
          ],
          "scripts": [
            {
              "message": "Install dll for debug.",
              "when": "{{'Debug' in $build_type}}",
              "script": "if not exist \"$dist_dir_debug\\bin\" mkdir \"$dist_dir_debug\\bin\" >nul & for %i in (\"$build_dir_debug\\*.dll\") do copy \"%i\" \"$dist_dir_debug\\bin\""
            },
            {
              "message": "Install lib for debug.",
              "when": "{{'Debug' in $build_type}}",
              "script": "if not exist \"$dist_dir_debug\\lib\" mkdir \"$dist_dir_debug\\lib\" >nul & for %i in (\"$build_dir_debug\\*.lib\") do copy \"%i\" \"$dist_dir_debug\\lib\""
            },
            {
              "message": "Install header for debug.",
              "when": "{{'Debug' in $build_type}}",
              "ignore_errors": "{{%ERRORLEVEL% < 8}}",
              "script": "if not exist \"$dist_dir_debug\\include\\skia\" mkdir \"$dist_dir_debug\\include\\skia\" >nul & robocopy \"$source_dir\\include\" \"$dist_dir_debug\\include\\skia\" *.h /s /NFL /NDL /NJH /NJS /NP"
            },
            {
              "message": "Install modules for debug.",
              "when": "{{'Debug' in $build_type}}",
              "ignore_errors": "{{%ERRORLEVEL% < 8}}",
              "script": "if not exist \"$dist_dir_debug\\modules\" mkdir \"$dist_dir_debug\\modules\" >nul & robocopy \"$source_dir\\modules\" \"$dist_dir_debug\\modules\" *.h /s /NFL /NDL /NJH /NJS /NP"
            },
            {
              "message": "Install pkgconfig for debug.",
              "when": "{{'Debug' in $build_type}}",
              "script": "if not exist \"$dist_dir_debug\\lib\\pkgconfig\" mkdir \"$dist_dir_debug\\lib\\pkgconfig\""
            },
            {
              "message": "Install dll for release.",
              "when": "{{'Release' in $build_type}}",
              "script": "if not exist \"$dist_dir_release\\bin\" mkdir \"$dist_dir_release\\bin\" >nul & for %i in (\"$build_dir_release\\*.dll\") do copy \"%i\" \"$dist_dir_release\\bin\""
            },
            {
              "message": "Install lib for release.",
              "when": "{{'Release' in $build_type}}",
              "script": "if not exist \"$dist_dir_release\\lib\" mkdir \"$dist_dir_release\\lib\" >nul & for %i in (\"$build_dir_release\\*.lib\") do copy \"%i\" \"$dist_dir_release\\lib\""
            },
            {
              "message": "Install header for release.",
              "when": "{{'Release' in $build_type}}",
              "ignore_errors": "{{%ERRORLEVEL% < 8}}",
              "script": "if not exist \"$dist_dir_release\\include\" mkdir \"$dist_dir_release\\include\" >nul & robocopy \"$source_dir\\include\" \"$dist_dir_release\\include\" *.h /s /NFL /NDL /NJH /NJS /NP"
            },
            {
              "message": "Install modules for release.",
              "when": "{{'Release' in $build_type}}",
              "ignore_errors": "{{%ERRORLEVEL% < 8}}",
              "script": "if not exist \"$dist_dir_release\\modules\" mkdir \"$dist_dir_release\\modules\" >nul & robocopy \"$source_dir\\modules\" \"$dist_dir_release\\modules\" *.h /s /NFL /NDL /NJH /NJS /NP"
            },
            {
              "message": "Install pkgconfig for release.",
              "when": "{{'Release' in $build_type}}",
              "script": "if not exist \"$dist_dir_release\\lib\\pkgconfig\" mkdir \"$dist_dir_release\\lib\\pkgconfig\""
            },
            {
              // Template script: genrate files with template_files
              "message": "Generate files from templates.",
              "script": "{{' && '.join([f\"(if not exist \\\"{os.path.dirname(tp['output'])}\\\" mkdir \\\"{os.path.dirname(tp['output'])}\\\") && jinja2 {(' '.join(['-D ' + d for d in tp['defines']]))} \\\"{tp['template']}\\\" > \\\"{tp['output']}\\\"\" for tp in ${template_files} if tp.get('when', True)])}}"
            }
          ]
        },
        "post-install": {
          "environments": {
            "PERLIO": "raw"
          },
          "scripts": [
            {
              "when": "{{'Debug' in $build_type}}",
              "script": "forfiles -P \"$dist_dir_debug\" /M *.pc /S /C \"cmd /c perl ${assets_rootdir}\\fix_pcfile.pl @PATH 0x22{{dist_rootdir.replace('\\\\', '/')}}0x22 {{os.path.basename($dist_dir_debug)}}\"",
              "ignore_errors": true
            },
            {
              "when": "{{'Release' in $build_type}}",
              "script": "forfiles -P \"$dist_dir_release\" /M *.pc /S /C \"cmd /c perl \"${assets_rootdir}\\fix_pcfile.pl\" @PATH 0x22{{dist_rootdir.replace('\\\\', '/')}}0x22 {{os.path.basename($dist_dir_release)}}\"",
              "ignore_errors": true
            }
          ]
        }
      }
    },
    "m148": {
      "stable": true,
      "git_tag": "chrome/m148",
      "stages": {
        "patch": {
          "patch_files": [
            {
              "local": "${package_dir}\\001-bentleyottmann-build.patch"
            },
            {
              "local": "${package_dir}\\002-graphite.patch"
            },
            {
              "local": "${package_dir}\\003-vulkan-headers.patch"
            },
            {
              "local": "${package_dir}\\004-pdfsubsetfont-uwp.patch"
            },
            {
              "local": "${package_dir}\\005-skparagraph-dllexport.patch"
            },
            {
              "local": "${package_dir}\\006-use-pkgconfig-to-find-gl.patch"
            },
            {
              "local": "${package_dir}\\007-dont-use-response-file.patch"
            },
            {
              "local": "${package_dir}\\008-fix-bsd.patch"
            },
            {

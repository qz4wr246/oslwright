prefix=${pcfiledir}/../..
exec_prefix=${prefix}
libdir=${prefix}/lib
includedir=${prefix}

Name: skia
Description: Skia is a complete 2D graphic library for drawing Text, Geometries, and Images.
Version: {{VERSION}}
{% if SHARED == 'true' %}
Requires: expat, libpng, zlib, libwebp, libwebpmux, libwebpdecoder, libwebpdemux, libjpeg, harfbuzz, icu-uc, icu-i18n
{% endif %}
Libs: -L${libdir} -lskia -lgdi32 -lopengl32 -lole32 -loleaut32 -luuid -lfontsub -luser32 -lusp10
Cflags: -I${includedir}

{
  "name": "libraw",
  "display": "LibRaw",
  "description": "A library for reading RAW files from digital cameras",
  "site": "http://www.libraw.org/",
  "license": "LGPL-2.1 license",
  "info": "info.md",
  "process_time": 230,
  "options": [
    {
      "display": "Version",
      "name": "version",
      "type": "choice",
      "items": "{{$versions}}",
      "default": "$latest_version"
    },
    {
      "display": "Visual Studio version",
      "name": "msvc_version",
      "type": "choice",
      "items": "{{$msvc_versions}}",
      "default": "$msvc_version_default"
    },
    {
      "display": "MSVC toolset version",
      "name": "msvc_toolset_version",
      "type": "choice",
      "items": "{{$msvc_toolset_versions}}",
      "default": "$msvc_toolset_version_default"
    },
    {
      "display": "Build arch",
      "name": "build_arch",
      "type": "choice",
      "items": [
        "x64",
        "x32"
      ],
      "default": "$build_arch_default"
    },
    {
      "display": "MSVC runtime library",
      "name": "msvc_runtime_library",
      "type": "choice",
      "items": [
        "mt",
        "md"
      ],
      "default": "$msvc_runtime_library_default"
    },
    {
      "display": "Build library",
      "name": "build_library",
      "enable": false,
      "type": "choice",
      "items": [
        "shared",
        "static",
        "shared; static"
      ],
      "default": "shared"
    },
    {
      "display": "Build type",
      "name": "build_type",
      "type": "choice",
      "items": [
        "Release",
        "Debug"
      ],
      "default": "Release"
    },
    {
      "display": "Build layout",
      "name": "build_layout",
      "type": "choice",
      "items": [
        "union",
        "separation"
      ],
      "default": "separation"
    },
    {
      "display": "Using CUDA",
      "name": "cuda_enable",
      "enable": false,
      "type": "bool",
      "default": false
    },
    {
      "display": "CUDA Version",
      "name": "cuda_version",
      "enable": "{{$cuda_enable}}",
      "type": "choice",
      "items": "{{$cuda_versions}}",
      "default": "{{$cuda_version_default}}"
    }
  ],
  "versions": {
    "default": {
      "environments": {
        "PERLIO": "raw",
        "CUDA_PATH": "{{os.path.join($cuda_root, f'v{$cuda_version}')  if $cuda_enable else ''}}",
        "CUDNN_PATH": "{{os.path.join($cuda_root, f'v{$cuda_version}')  if $cuda_enable else ''}}"
      },
      "source_dir": "${source_rootdir}\\${name}-${version}",
      "dist_name": "${name}-${version}{{'' if $build_library == 'interface' else '-' + $build_arch + '-' + $msvc_toolset_version + '-' + $msvc_runtime_library + (('-cu' + $cuda_version.replace('.','')) if $cuda_enable else '') + ('-static' if 'static' == $build_library else '')}}",
      "dist_name_debug": "${dist_name}{{'-debug' if $build_layout == 'separation' else ''}}",
      "dist_name_release": "${dist_name}{{'-release' if $build_layout == 'separation' else ''}}",
      "build_dir_debug": "${source_rootdir}\\${dist_name_debug}-build",
      "build_dir_release": "${source_rootdir}\\${dist_name_release}-build",
      "dist_dir_debug": "${dist_rootdir}\\${dist_name_debug}",
      "dist_dir_release": "${dist_rootdir}\\${dist_name_release}",
      "cache_file": "${cache_rootdir}\\${name}-${version}.7z",
      "git_url": "https://github.com/LibRaw/LibRaw.git",
      "git_tag": "{{$version.split('@', 1)[0] if '@' in $version else $version}}",
      "git_hash": "{{$version.split('@', 1)[1] if '@' in $version else ''}}",
      "stages": {
        "download": {
          "scripts": [
            {
              "when": "{{os.path.isdir($source_dir)}}",
              "script": "rmdir /q /s \"$source_dir\""
            },
            {
              "message": "git clone.",
              "when": "{{not os.path.isdir($source_dir) and not os.path.isfile($cache_file)}}",
              "script": "git clone --no-progress --quiet -b \"$git_tag\" {{'' if $git_hash else '--depth 1'}} --single-branch --recurse --shallow-submodules $git_url \"$source_dir\"",
              "fallback": "rmdir /q /s \"$source_dir\""
            },
            {
              "message": "git checkout.",
              "when": "{{$git_hash and os.path.isdir($source_dir) and not os.path.isfile($cache_file)}}",
              "chdir": "$source_dir",
              "script": "git checkout $git_hash",
              "fallback": "rmdir /q /s \"$source_dir\""
            },
            {
              "message": "extract from cache.",
              "when": "{{not os.path.isdir($source_dir) and os.path.isfile($cache_file)}}",
              "script": "7z x -aoa \"$cache_file\" -o\"$source_dir\"",
              "fallback": "rmdir /q /s \"$source_dir\""
            },
            {
              "message": "make cache.",
              "when": "{{not os.path.isfile($cache_file)}}",
              "script": "7z a \"$cache_file\" \"$source_dir\\*\"",
              "fallback": "del \"$cache_file\""
            }
          ]
        },
        // "patch": {
        //   "patch_file_01": "${package_dir}\\patches\\file01.patch",
        //   "scripts": [
        //     {
        //       "when": "{{not os.path.isfile(os.path.join($source_dir, '__patched_' + os.path.basename($patch_file_01)))}}",
        //       "chdir": "$source_dir",
        //       "script": "git apply \"$patch_file_01\" && copy nul > {{'__patched_' + os.path.basename($patch_file_01)}}"
        //     }
        //   ]
        // },
        "configure": {
          "scripts": [
            {
              "when": "{{'Debug' in $build_type and $build_layout == 'separation'}}",
              "script": "del /q /s \"$build_dir_debug\" > nul",
              "ignore_errors": true
            },
            {
              "when": "{{'Release' in $build_type }}",
              "script": "del /q /s \"$build_dir_release\" > nul",
              "ignore_errors": true
            },
            {
              "when": "{{'Debug' in $build_type and not os.path.isdir($build_dir_debug)}}",
              "script": "mkdir \"$build_dir_debug\"",
              "ignore_errors": true
            },
            {
              "when": "{{'Release' in $build_type and not os.path.isdir($build_dir_release)}}",
              "script": "mkdir \"$build_dir_release\"",
              "ignore_errors": true
            },
            {
              "message": "config for debug.",
              "when": "{{'Debug' in $build_type and $build_layout == 'separation'}}",
              "script": ""
            },
            {
              "message": "config for debug.",
              "when": "{{'Debug' in $build_type}}",
              "chdir": "$source_dir",
              "script": "perl -pe \"s#src\\\\#..\\\\{{os.path.basename($source_dir)}}\\\\src\\\\#g;s#/I\\.#/I..\\\\{{os.path.basename($source_dir)}}#g\" Makefile.msvc > \"$build_dir_debug/Makefile\""
            },
            {
              "message": "config for release.",
              "when": "{{'Release' in $build_type}}",
              "chdir": "$source_dir",
              "script": "perl -pe \"s#src\\\\#..\\\\{{os.path.basename($source_dir)}}\\\\src\\\\#g;s#/I\\.#/I..\\\\{{os.path.basename($source_dir)}}#g\" Makefile.msvc > \"$build_dir_release/Makefile\""
            }
          ]
        },
        "build": {
          "LIBSTATIC": "lib\\libraw_static.lib",
          "LIBDLL": "lib\\libraw.lib",
          "DLL": "bin\\libraw.dll",
          "scripts": [
            {
              "when": "{{'Debug' in $build_type}}",
              "script": "mkdir \"$build_dir_debug\\object\" \"$build_dir_debug\\bin\" \"$build_dir_debug\\lib\"",
              "ignore_errors": true
            },
            {
              "when": "{{'Release' in $build_type}}",
              "script": "mkdir \"$build_dir_release\\object\" \"$build_dir_release\\bin\" \"$build_dir_release\\lib\"",
              "ignore_errors": true
            },
            {
              "message": "build for debug.",
              "when": "{{'Debug' in $build_type}}",
              "chdir": "$build_dir_debug",
              "script": "nmake /NOLOGO {{$LIBDLL if 'shared' in $build_library else ''}}  {{$LIBSTATIC if 'static' in $build_library else ''}}"
            },
            {
              "message": "build for release.",
              "when": "{{'Release' in $build_type}}",
              "chdir": "$build_dir_release",
              "script": "nmake /NOLOGO {{$LIBDLL if 'shared' in $build_library else ''}}  {{$LIBSTATIC if 'static' in $build_library else ''}}"
            }
          ]
        },
        "install": {
          "pkgconfig_dir_release": "$dist_dir_release\\lib\\pkgconfig",
          "pkgconfig_dir_debug": "$dist_lib_debug\\lib\\pkgconfig",
          "j2_template_01": "${package_dir}\\libraw.pc.j2",
          "j2_output_01_release": "${pkgconfig_dir_release}\\libraw.pc",
          "j2_output_01_debug": "${pkgconfig_dir_debug}\\libraw.pc",
          "scripts": [
            {
              "when": "{{'Debug' in $build_type}}",
              "script": "robocopy \"$source_dir\\libraw\" \"$dist_dir_debug\\include\" *.h /NFL /NDL /NJH /NJS /NP /NS /NC /XO",
              "ignore_errors": "{{%ERRORLEVEL% < 8}}"
            },
            {
              "when": "{{'Debug' in $build_type}}",
              "script": "robocopy \"$build_dir_debug\\bin\" \"$dist_dir_debug\\bin\" *.* /E /NFL /NDL /NJH /NJS /NP /NS /NC",
              "ignore_errors": "{{%ERRORLEVEL% < 8}}"
            },
            {
              "when": "{{'Debug' in $build_type}}",
              "script": "robocopy \"$build_dir_debug\\lib\" \"$dist_dir_debug\\lib\" *.* /E /NFL /NDL /NJH /NJS /NP /NS /NC",
              "ignore_errors": "{{%ERRORLEVEL% < 8}}"
            },
            {
              "when": "{{'Debug' in $build_type}}",
              "script": "mkdir \"$pkgconfig_dir_debug\"",
              "ignore_errors": true
            },
            {
              "when": "{{'Debug' in $build_type}}",
              "script": "jinja2 -D LIBRAW_VERSION=\"$version\" \"$j2_template_01\" > \"$j2_output_01_debug\""
            },
            {
              "when": "{{'Release' in $build_type}}",
              "script": "robocopy \"$source_dir\\libraw\" \"$dist_dir_release\\include\" *.h /NFL /NDL /NJH /NJS /NP /NS /NC /XO",
              "ignore_errors": "{{%ERRORLEVEL% < 8}}"
            },
            {
              "when": "{{'Release' in $build_type}}",
              "script": "robocopy \"$build_dir_release\\bin\" \"$dist_dir_release\\bin\" *.* /E /NFL /NDL /NJH /NJS /NP /NS /NC",
              "ignore_errors": "{{%ERRORLEVEL% < 8}}"
            },
            {
              "when": "{{'Release' in $build_type}}",
              "script": "robocopy \"$build_dir_release\\lib\" \"$dist_dir_release\\lib\" *.* /E /NFL /NDL /NJH /NJS /NP /NS /NC",
              "ignore_errors": "{{%ERRORLEVEL% < 8}}"
            },
            {
              "when": "{{'Release' in $build_type}}",
              "script": "mkdir \"$pkgconfig_dir_release\"",
              "ignore_errors": true
            },
            {
              "when": "{{'Release' in $build_type}}",
              "script": "jinja2 -D LIBRAW_VERSION=\"$version\" \"$j2_template_01\" > \"$j2_output_01_release\""
            }
          ]
        }
      }
    },
    "0.22.0": {}
  }
}

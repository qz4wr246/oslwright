diff --git a/CMakeLists.txt b/CMakeLists.txt
new file mode 100644
index 0000000..657ed88
--- /dev/null
+++ b/CMakeLists.txt
@@ -0,0 +1,94 @@
+cmake_minimum_required(VERSION 3.30)
+
+include(GNUInstallDirs)
+
+file(STRINGS implot.h version REGEX "#define[ \\t]+IMPLOT_VERSION[ \\t]+\".+\"")
+string(REGEX MATCH "[0-9.]+" IMPLOT_VERSION "${version}" "")
+
+project(implot VERSION ${IMPLOT_VERSION} LANGUAGES CXX)
+
+set(IMPLOT_SOURCE_DIR ${CMAKE_CURRENT_SOURCE_DIR})
+
+find_package(imgui)
+
+if(BUILD_SHARED_LIBS)
+    set(IMPLOT_API "#define IMPLOT_API __declspec(dllimport)")
+else()
+    set(IMPLOT_API "#define IMPLOT_API")
+endif()
+add_custom_command(
+    OUTPUT ${CMAKE_CURRENT_SOURCE_DIR}/implot.h.stamp
+    COMMAND perl -0777 -pi -e "s@\#define IMPLOT_API.*@${IMPLOT_API}@g" ${CMAKE_CURRENT_SOURCE_DIR}/implot.h
+    COMMAND ${CMAKE_COMMAND} -E touch ${CMAKE_CURRENT_SOURCE_DIR}/implot.h.stamp
+)
+add_custom_target(run_replace ALL DEPENDS ${CMAKE_CURRENT_SOURCE_DIR}/implot.h.stamp)
+
+set(IMPLOT_PUBLIC_H_FILES
+    implot.h
+    implot_internal.h
+)
+
+set(IMPLOT_PUBLIC_CXX_FILES
+    implot.cpp
+    implot_items.cpp
+)
+
+add_library(implot
+    ${IMPLOT_PUBLIC_H_FILES}
+    ${IMPLOT_PUBLIC_CXX_FILES}
+)
+add_library(ImGui::implot ALIAS implot)
+
+target_include_directories(implot
+  PUBLIC
+    $<BUILD_INTERFACE:${IMPLOT_SOURCE_DIR}>
+    $<BUILD_INTERFACE:${IMPLOT_BACKENDS_DIR}>
+    $<INSTALL_INTERFACE:include>
+)
+target_link_libraries(implot PRIVATE ImGui::imgui)
+target_compile_definitions(implot PRIVATE ImTextureID=ImU64)
+
+if(BUILD_SHARED_LIBS)
+  set_property(TARGET implot PROPERTY WINDOWS_EXPORT_ALL_SYMBOLS ON)
+  target_compile_definitions(implot
+    PRIVATE
+    "IMPLOT_API=_declspec(dllexport)"
+    INTERFACE
+    "IMPLOT_API=_declspec(dllimport)"
+  )
+else()
+    set_property(TARGET implot PROPERTY WINDOWS_EXPORT_ALL_SYMBOLS OFF)
+endif()
+
+install(FILES ${IMPLOT_PUBLIC_H_FILES}
+  DESTINATION include
+)
+
+install(TARGETS implot
+  EXPORT implot-export
+  RUNTIME DESTINATION bin
+  ARCHIVE DESTINATION lib
+  LIBRARY DESTINATION lib
+)
+
+include(CMakePackageConfigHelpers)
+install(EXPORT implot-export
+  FILE implotTargets.cmake
+  NAMESPACE   ImGui::
+  DESTINATION lib/cmake/implot
+  EXPORT_LINK_INTERFACE_LIBRARIES
+)
+write_basic_package_version_file(
+  ${CMAKE_CURRENT_BINARY_DIR}/implotConfigVersion.cmake
+  COMPATIBILITY AnyNewerVersion
+)
+configure_package_config_file(
+    "${PROJECT_SOURCE_DIR}/Config.cmake.in"
+    "${CMAKE_BINARY_DIR}/implotConfig.cmake"
+    INSTALL_DESTINATION lib/cmake/implot
+)
+install(FILES
+  ${CMAKE_CURRENT_BINARY_DIR}/implotConfig.cmake
+  ${CMAKE_CURRENT_BINARY_DIR}/implotConfigVersion.cmake
+  DESTINATION lib/cmake/implot
+)

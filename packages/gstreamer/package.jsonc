{
  "name": "gstreamer",
  "display": "GStreamer",
  "description": "GStreamer open-source multimedia framework",
  "site": "https://gstreamer.freedesktop.org/",
  "license": "LGPL v2.1",
  "process_time": 1900,
  "options": [
    {
      "display": "Version",
      "name": "version",
      "type": "choice",
      "items": "{{$versions}}",
      "default": "$latest_version"
    },
    {
      "display": "Visual Studio version",
      "name": "msvc_version",
      "type": "choice",
      "items": "{{$msvc_versions}}",
      "default": "$msvc_version_default"
    },
    {
      "display": "MSVC toolset version",
      "name": "msvc_toolset_version",
      "type": "choice",
      "items": "{{$msvc_toolset_versions}}",
      "default": "$msvc_toolset_version_default"
    },
    {
      "display": "Build arch",
      "name": "build_arch",
      "type": "choice",
      "items": [
        "x64",
        "x32"
      ],
      "default": "$build_arch_default"
    },
    {
      "display": "MSVC runtime library",
      "name": "msvc_runtime_library",
      "type": "choice",
      "items": [
        "mt",
        "md"
      ],
      "default": "$msvc_runtime_library_default"
    },
    {
      "display": "Build library",
      "name": "build_library",
      "type": "choice",
      "items": [
        "shared",
        // "static"
      ],
      "default": "shared"
    },
    {
      "display": "Build type",
      "name": "build_type",
      "type": "choice",
      "items": [
        "Release",
        "Debug"
      ],
      "default": "Release"
    },
    {
      "display": "Build layout",
      "name": "build_layout",
      "enable": false,
      "type": "choice",
      "items": [
        "union",
        "separation"
      ],
      "default": "separation"
    },
    {
      "display": "Using CUDA",
      "name": "cuda_enable",
      "enable": "{{True if $cuda_versions else False}}",
      "type": "bool",
      "default": "{{$cuda_enable_default}}"
    },
    {
      "display": "CUDA Version",
      "name": "cuda_version",
      "enable": "{{$cuda_enable}}",
      "type": "choice",
      "items": "{{$cuda_versions}}",
      "default": "{{$cuda_version_default}}"
    },
    {
      "display": "Enable tools",
      "name": "gst_enable_tools",
      "type": "bool",
      "default": false
    },
    {
      "display": "Enable NVCodec",
      "name": "enable_nvcodec",
      "enable": "{{$cuda_enable}}",
      "type": "bool",
      "default": false
    },
    {
      "display": "Enable openh264",
      "name": "enable_openh264",
      "type": "bool",
      "default": false
    }
  ],
  "versions": {
    "default": {
      "dependencies": {
        "sqlite": {
          "version": ">=3.45"
        },
        "openssl": {
          "version": ">=3.3"
        },
        "libxml2": {
          "version": ">=2.11"
        },
        "libpng": {
          "version": ">=1.6"
        },
        "libjpeg-turbo": {
          "version": ">=3.0"
        },
        "harfbuzz": {
          "version": ">=9.0"
        },
        "freetype": {
          "version": ">=2.13"
        },
        "cairo": {
          "version": ">=1.18"
        },
        "icu4c": {
          "version": ">=75.1"
        },
        "ffmpeg": {
          "version": ">=6.1;<7.0",   // GStreamer ver 1.24.5 is compatible with FFmpeg ver 6.x.
          "build_library": "shared"
        },
        "openh264": {
          "enable": "{{$enable_openh264}}",
          "version": ">=2.6"
        },
        // cannot build with external glib.
        // "glib": {
        //   "version": ">=2.81"
        // },
        "pixman":{
          "version": ">=0.43"
        },
        "zlib": {
          "version": ">=1.3"
        },
        "brotli": {
          "version": ">=1.1"
        },
        "zstd": {
          "version": ">=1.5"
        },
        "xz": {
          "version": ">=5.6"
        }
      },
      "environments": {
        "CUDA_PATH": "{{os.path.join($cuda_root, f'v{$cuda_version}')  if $cuda_enable else ''}}"
      },
      "source_dir": "${source_rootdir}\\${name}-${version}",
      "dist_name": "${name}-${version}{{'' if $build_library == 'interface' else '-' + $build_arch + '-' + $msvc_toolset_version + '-' + $msvc_runtime_library + (('-cu' + $cuda_version.replace('.','')) if $cuda_enable else '') + ('-static' if 'static' == $build_library else '')}}",
      "dist_name_debug": "${dist_name}{{'-debug' if $build_layout == 'separation' else ''}}",
      "dist_name_release": "${dist_name}{{'-release' if $build_layout == 'separation' else ''}}",
      "build_dir_debug": "${source_rootdir}\\${dist_name_debug}-build",
      "build_dir_release": "${source_rootdir}\\${dist_name_release}-build",
      "dist_dir_debug": "${dist_rootdir}\\${dist_name_debug}",
      "dist_dir_release": "${dist_rootdir}\\${dist_name_release}",
      "cache_file": "${cache_rootdir}\\${name}-${version}.7z",
      "git_url": "https://gitlab.freedesktop.org/gstreamer/gstreamer.git",
      "git_tag": "{{ver.split('@', 1)[0] if '@' in $version else $version}}",
      "git_hash": "{{ver.split('@', 1)[1] if '@' in $version else ''}}",
      "stages": {
        "download": {
          "scripts": [
            {
              "when": "{{os.path.isdir($source_dir)}}",
              "script": "rmdir /q /s \"$source_dir\""
            },
            {
              "message": "git clone.",
              "when": "{{not os.path.isdir($source_dir) and not os.path.isfile($cache_file)}}",
              "script": "git clone --no-progress --quiet -b \"$git_tag\" {{'' if $git_hash else '--depth 1'}} --single-branch --recurse --shallow-submodules $git_url \"$source_dir\"",
              "fallback": "rmdir /q /s \"$source_dir\""
            },
            {
              "message": "git checkout.",
              "when": "{{$git_hash and os.path.isdir($source_dir) and not os.path.isfile($cache_file)}}",
              "chdir": "$source_dir",
              "script": "git checkout $git_hash",
              "fallback": "rmdir /q /s \"$source_dir\""
            },
            {
              "message": "extruct from cache.",
              "when": "{{os.path.isfile($cache_file)}}",
              "script": "7z x -aoa \"$cache_file\" -o\"$source_dir\"",
              "fallback": "rmdir /q /s \"$source_dir\""
            },
            {
              "message": "make cache.",
              "when": "{{not os.path.isfile($cache_file)}}",
              "script": "7z a \"$cache_file\" \"$source_dir\\*\"",
              "fallback": "del \"$cache_file\""
            }
          ]
        },
        // "patch": {
        //   "patch_file_01": "${package_dir}\\gl_mkenum_py13.diff",
        //   "scripts": [
        //     {
        //       "when": "{{not os.path.isfile(os.path.join($source_dir, '__patched_' + os.path.basename($patch_file_01)))}}",
        //       "chdir": "$source_dir",
        //       "script": "git apply \"$patch_file_01\" && copy nul > {{'__patched_' + os.path.basename($patch_file_01)}}"
        //     }
        //   ]
        // },
        "configure": {
          "meson_options": [
            "--vsenv",
            "--pkgconfig.relocatable",
            "-Db_vscrt={{'from_buildtype' if $msvc_runtime_library == 'md' else 'static_from_buildtype'}}",
            "-Ddefault_library=$build_library",
            "-Dgst-full-target-type={{'static_library' if $build_library  == 'static' else 'shared_library'}}",
            "-Dglib-networking:openssl=enabled",
            "-Dgst-plugins-bad:videoparsers=enabled",
            "-Dgst-plugins-bad:nvcodec={{'enabled' if $cuda_enable and $enable_nvcodec else 'disabled'}}",
            "-Dgst-plugins-bad:openh264={{'enabled' if $enable_openh264 else 'disabled'}}",
            "-DFFmpeg:default_library=shared",
            "-Dpython=disabled", // python should be disabled.
            "-Dgstreamer:tools={{'enabled' if $gst_enable_tools else 'disabled'}}",
            "-Drtsp_server=enabled",
            "-Dtls=enabled",
            "-Dqt5=disabled",
            "-Ddoc=disabled",
            "-Dtests=disabled",
            "-Ddevtools=disabled",
            "-Dpango:install-tests=false",
            "-Djson-glib:tests=false",
            "-Dglib:tests=false"
          ],
          "meson_options_debug" : [
            "--prefix=\"$dist_dir_debug\"",
            "--buildtype debug",
            "{{'--reconfigure --wipe --clearcache' if os.path.isdir($build_dir_debug) else ''}}"
          ],
          "meson_options_release" : [
            "--prefix=\"$dist_dir_release\"",
            "--buildtype release",
            "{{'--reconfigure --wipe --clearcache' if os.path.isdir($build_dir_release) else ''}}"
          ],
          "scripts": [
            {
              "ignore_errors": true,
              "when": "{{'Debug' in $build_type and $build_layout == 'separation'}}",
              "script": "del /q /s \"$build_dir_debug\" > nul"
            },
            {
              "ignore_errors": true,
              "when": "{{'Release' in $build_type}}",
              "script": "del /q /s \"$build_dir_release\" > nul"
            },
            {
              "ignore_errors": true,
              "when": "{{'Debug' in $build_type and not os.path.isdir($build_dir_debug)}}",
              "script": "mkdir \"$build_dir_debug\""
            },
            {
              "ignore_errors": true,
              "when": "{{'Release' in $build_type and not os.path.isdir($build_dir_release)}}",
              "script": "mkdir \"$build_dir_release\""
            },
            {
              "message": "config for debug.",
              "when": "{{'Debug' in $build_type and $build_layout == 'separation'}}",
              "environments": {
                "CMAKE_PREFIX_PATH": "$dependent_packages_debug",
                "PKG_CONFIG_PATH": "$pkg_config_path_debug",
                "PERLIO": "raw"
              },
              "script": "meson setup {{' '.join($meson_options)}} {{' '.join($meson_options_debug)}}  \"$build_dir_debug\" \"$source_dir\""
            },
            {
              "message": "config for release.",
              "when": "{{'Release' in $build_type}}",
              "environments": {
                "CMAKE_PREFIX_PATH": "$dependent_packages_release",
                "PKG_CONFIG_PATH": "$pkg_config_path_release",
                "PERLIO": "raw"
              },
              "script": "meson setup {{' '.join($meson_options)}} {{' '.join($meson_options_release)}} \"$build_dir_release\" \"$source_dir\""
            }
          ]
        },
        "build": {
          "scripts": [
            {
              "message": "build for debug.",
              "when": "{{'Debug' in $build_type}}",
              "script": "meson compile -C \"$build_dir_debug\" -j 4"
            },
            {
              "message": "build for release.",
              "when": "{{'Release' in $build_type}}",
              "script": "meson compile -C \"$build_dir_release\" -j 4"
            }
          ]
        },
        "install": {
          "meson_install_options": [
            "--tags devel,runtime,bin,i18n"
          ],
          "scripts": [
            {
              "message": "install for debug.",
              "when": "{{'Debug' in $build_type}}",
              "script": "meson install -C \"$build_dir_debug\" {{' '.join($meson_install_options)}}"
            },
            {
              "message": "install for release.",
              "when": "{{'Release' in $build_type}}",
              "script": "meson install -C \"$build_dir_release\" {{' '.join($meson_install_options)}}"
            }
          ]
        },
        "post-install" :{
          "j2_template_01": "${package_dir}\\activate.bat.j2",
          "j2_output_01_release": "${dist_dir_release}\\bin\\activate.bat",
          "dist_rootdir_slash":"{{$dist_rootdir.replace('\\\\', '/')}}",
          "environments": {
            "PERLIO": "raw"
          },
          "scripts": [
            {
              "ignore_errors": true,
              "when": "{{'Debug' in $build_type}}",
              "script": "forfiles -P \"$dist_dir_debug\" /M *.pc /S /C \"cmd /c perl -p -i -e 0x22s#^prefix=.*#prefix=\\$${pcfiledir}/../..#g;s#^exec_prefix=.*#exec_prefix=\\$${prefix}#g;s#^libdir=.*#libdir=\\$${prefix}/lib#g;s#^includedir=.*#includedir=\\$${prefix}/include#g0x22 @PATH\""
            },
            {
              "ignore_errors": true,
              "when": "{{'Debug' in $build_type}}",
              "script": "forfiles -P \"$dist_dir_debug\" /M *.pc /S /C \"cmd /c perl -p -i -e 0x22s#$dist_rootdir_slash#\\$${prefix}/..#g0x22 @PATH\""
            },
            {
              "ignore_errors": true,
              "when": "{{'Release' in $build_type}}",
              "script": "forfiles -P \"$dist_dir_release\" /M *.pc /S /C \"cmd /c perl -p -i -e 0x22s#^prefix=.*#prefix=\\$${pcfiledir}/../..#g;s#^exec_prefix=.*#exec_prefix=\\$${prefix}#g;s#^libdir=.*#libdir=\\$${prefix}/lib#g;s#^includedir=.*#includedir=\\$${prefix}/include#g0x22 @PATH\""
            },
            {
              "ignore_errors": true,
              "when": "{{'Release' in $build_type}}",
              "script": "forfiles -P \"$dist_dir_release\" /M *.pc /S /C \"cmd /c perl -p -i -e 0x22s#$dist_rootdir_slash#\\$${prefix}/..#g0x22 @PATH\""
            },
            {
              "when": "{{'Release' in $build_type}}",
              "script": "jinja2 -D DEPENDENT_DLL_PATHS=\"{{$dependent_dlls_release.replace($dist_rootdir +'\\\\','')}}\" \"$j2_template_01\" > \"$j2_output_01_release\""
            }
          ]
        }
      }
    },
    "1.24.13": {  // GStreamer ver 1.24.5 is compatible with FFmpeg ver 6.x.
      "dependencies": {
        "ffmpeg": {
          "version": ">=6.1;<7.0",
          "build_library": "shared"
        }
      }
    }
  }
}

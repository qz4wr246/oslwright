{
  "name": "opencv",
  "display": "OpenCV",
  "description": "Open Source Computer Vision Library",
  "site": "https://opencv.org",
  "license": "Apache 2 License",
  "category": "graphics",
  "info":"info.md",
  "process_time": 2070,
  "options": [
    {
      "display": "Version",
      "name": "version",
      "type": "choice",
      "items": "{{$versions}}",
      "default": "$latest_version"
    },
    {
      "display": "Visual Studio version",
      "name": "msvc_version",
      "type": "choice",
      "items": "{{$msvc_versions}}",
      "default": "$msvc_version_default"
    },
    {
      "display": "MSVC toolset version",
      "name": "msvc_toolset_version",
      "type": "choice",
      "items": "{{$msvc_toolset_versions}}",
      "default": "$msvc_toolset_version_default"
    },
    {
      "display": "Build arch",
      "name": "build_arch",
      "type": "choice",
      "items": [
        "x64",
        "x32"
      ],
      "default": "$build_arch_default"
    },
    {
      "display": "MSVC runtime library",
      "name": "msvc_runtime_library",
      "type": "choice",
      "items": [
        "mt",
        "md"
      ],
      "default": "$msvc_runtime_library_default"
    },
    {
      "display": "Build library",
      "name": "build_library",
      "type": "choice",
      "items": [
        "shared"
      ],
      "default": "$build_library_default"
    },
    {
      "display": "Build type",
      "name": "build_type",
      "type": "choice",
      "items": [
        "Release",
        "Debug",
        "Release;Debug"
      ],
      "default": "Release"
    },
    {
      "display": "Build layout",
      "name": "build_layout",
      "type": "choice",
      "items": [
        "union",
        "separation"
      ],
      "default": "union"
    },
    {
      "display": "Using CUDA",
      "name": "cuda_enable",
      "enable": "{{True if $cuda_versions else False}}",
      "type": "bool",
      "default": "{{$cuda_enable_default}}"
    },
    {
      "display": "CUDA Version",
      "name": "cuda_version",
      "enable": "cuda_enable",
      "type": "choice",
      "items": "{{$cuda_versions}}",
      "default": "{{$cuda_version_default}}"
    },
    {
      "display": "With FFmpeg",
      "name": "with_ffmpeg",
      "type": "choice",
        "items": [
        "none",
        "internal",
        "external"
      ],
      "default": "external"
    },
    {
      "display": "With Gstreamer",
      "name": "with_gstreamer",
      "type": "bool",
      "default": true
    },
    {
      "display": "With VTK",
      "name": "with_vtk",
      "type": "bool",
      "default": true
    },
    {
      "display": "With Qt",
      "name": "with_qt",
      "enable": "{{$qt_enable_default}}",
      "type": "bool",
      "default": "{{$qt_enable_default}}"
    },
    {
      "display": "Qt directory(msvc)",
      "name": "qt_msvc_dir",
      "enable": "{{$with_qt}}",
      "type": "folder",
      "default": "{{$qt_msvc_dir_default}}"
    }
  ],
  "versions": {
    "default": {
      "dependencies": {
        "vtk": {
          "version": ">=9.3"
        },
        "libavif":{
          "version": ">=1.4"
        },
        "libpng": {
          "version": ">=1.6"
        },
        "libjpeg-turbo": {
          "version": ">=3.0"
        },
        "libwebp": {
          "version": ">=1.4"
        },
        "libtiff": {
          "version": ">=4.0"
        },
        "openexr": {
          "version": ">=3.4"
        },
        "jasper": {
          "version": ">=4.2"
        },
        "harfbuzz": {
          "version": ">=9.0"
        },
        "freetype": {
          "version": ">=2.13"
        },
        "cairo": {
          "version": ">=1.18"
        },
        "icu4c": {
          "version": ">=75.1"
        },
        "pixman":{
          "version": ">=0.43"
        },
        "quirc": {
          "version": ">=1.2"
        },
        "zlib": {
          "version": ">=1.3"
        },
        "bzip2": {
          "version": ">=1.0"
        },
        "brotli": {
          "version": ">=1.1"
        }
      },
      "environments": {
        "CUDA_PATH": "{{os.path.join($cuda_root, f'v{$cuda_version}')  if $cuda_enable else ''}}",
        "CUDNN_PATH": "{{os.path.join($cuda_root, f'v{$cuda_version}')  if $cuda_enable else ''}}"
      },
      "base_dir": "${source_rootdir}\\${name}-${version}",
      "source_dir": "${base_dir}\\${name}",
      "contrib_dir": "${base_dir}\\${name}_contrib",
      "dist_name": "${name}-${version}{{'' if $build_library == 'interface' else '-' + $build_arch + '-' + $msvc_toolset_version + '-' + $msvc_runtime_library + (('-cu' + $cuda_version.replace('.','')) if $cuda_enable else '') + ('-static' if 'static' == $build_library else '')}}",
      "dist_name_debug": "${dist_name}{{'-debug' if $build_layout == 'separation' else ''}}",
      "dist_name_release": "${dist_name}{{'-release' if $build_layout == 'separation' else ''}}",
      "build_dir_debug": "${source_rootdir}\\${dist_name_debug}-build",
      "build_dir_release": "${source_rootdir}\\${dist_name_release}-build",
      "dist_dir_debug": "${dist_rootdir}\\${dist_name_debug}",
      "dist_dir_release": "${dist_rootdir}\\${dist_name_release}",
      "cache_file": "${cache_rootdir}\\${name}-${version}.7z",
      "contrib_cache_file": "${cache_rootdir}\\${name}_contrib-${version}.7z",
      "git_url": "https://github.com/opencv/opencv.git",
      "git_contrib_url" : "https://github.com/opencv/opencv_contrib",
      "git_tag": "{{$version.split('@', 1)[0] if '@' in $version else $version}}",
      "git_hash": "{{$version.split('@', 1)[1] if '@' in $version else ''}}",
      "stages": {
        "download": {
          "scripts": [
            {
              "ignore_errors": true,
              "when": "{{not os.path.isdir($base_dir)}}",
              "script": "mkdir \"$base_dir\""
            },
            {
              "when": "{{os.path.isdir($source_dir)}}",
              "script": "rmdir /q /s \"$source_dir\""
            },
            {
              "message": "git clone.",
              "when": "{{not os.path.isdir($source_dir) and not os.path.isfile($cache_file)}}",
              "script": "git clone --no-progress --quiet -b \"$git_tag\" {{'' if $git_hash else '--depth 1'}} --single-branch --recurse --shallow-submodules $git_url \"$source_dir\"",
              "fallback": "rmdir /q /s \"$source_dir\""
            },
            {
              "message": "git checkout.",
              "when": "{{$git_hash and os.path.isdir($source_dir) and not os.path.isfile($cache_file)}}",
              "chdir": "$source_dir",
              "script": "git checkout $git_hash",
              "fallback": "rmdir /q /s \"$source_dir\""
            },
            {
              "message": "extract from cache.",
              "when": "{{not os.path.isdir($source_dir) and os.path.isfile($cache_file)}}",
              "script": "7z x -aoa \"$cache_file\" -o\"$source_dir\""
            },
            {
              "message": "make cache.",
              "when": "{{not os.path.isfile($cache_file)}}",
              "script": "7z -sccUTF-8 a \"$cache_file\" \"$source_dir\\*\"",
              "fallback": "del \"$cache_file\""
            },
            {
              "when": "{{os.path.isfile(os.path.join($contrib_dir,'CMakeLists.txt'))}}",
              "script": "rmdir /q /s \"$contrib_dir\""
            },
            {
              "message": "git clone.",
              "when": "{{not os.path.isdir($contrib_dir) and not os.path.isfile($contrib_cache_file)}}",
              "script": "git clone --no-progress --quiet -b \"$git_tag\" {{'' if $git_hash else '--depth 1'}} --single-branch --recurse --shallow-submodules $git_contrib_url \"$contrib_dir\"",
              "fallback": "rmdir /q /s \"$contrib_dir\""
            },
            {
              "message": "git checkout.",
              "when": "{{$git_hash and os.path.isdir($contrib_dir) and not os.path.isfile($contrib_cache_file)}}",
              "chdir": "$contrib_dir",
              "script": "git checkout $git_hash",
              "fallback": "rmdir /q /s \"$contrib_dir\""
            },
            {
              "message": "extract from cache.",
              "when": "{{not os.path.isdir($contrib_dir) and os.path.isfile($contrib_cache_file)}}",
              "script": "7z x -aoa \"$contrib_cache_file\" -o\"$contrib_dir\""
            },
            {
              "message": "make cache.",
              "when": "{{not os.path.isfile($contrib_cache_file)}}",
              "script": "7z a \"$contrib_cache_file\" \"$contrib_dir\\*\"",
              "fallback": "del \"$contrib_cache_file\""
            }
          ]
        },
        "patch": {
          "patch_files": [
            {
              "chdir" : "$source_dir",
              "local": "${package_dir}\\cv_4.12_cmake_pkgconfig.diff",
            }
          ],
          "scripts": [
            {
              // Patch Script: patching source code with patch_files
              "message": "Patch ${name} source code",
              "chdir": "$source_dir",
              "script": "{{' && '.join([(f'(if not exist \"{p[\"chdir\"]}\" mkdir \"{p[\"chdir\"]}\") && pushd \"{p[\"chdir\"]}\" && ' if 'chdir' in p else '') + (f'(if not exist \"{os.path.join(cache_rootdir, name)}\" mkdir \"{os.path.join(cache_rootdir, name)}\") && (if not exist \"{os.path.join(cache_rootdir, name, b)}\" (curl.exe --fail -L -s -o \"{os.path.join(cache_rootdir, name, b)}\" \"{p[\"remote\"]}\" || exit /b 1)) && patch --ignore-whitespace -t -b -p1 -i \"{os.path.join(cache_rootdir, name, b)}\"' if 'remote' in p else f'(if not exist \"{os.path.join(cache_rootdir, name)}\" mkdir \"{os.path.join(cache_rootdir, name)}\") && (if not exist \"{os.path.join(cache_rootdir, name, b)}\" (curl.exe --fail -L -s -o \"{os.path.join(cache_rootdir, name, b)}\" \"{p[\"fetch\"]}\" || exit /b 1)) && copy /Y \"{os.path.join(cache_rootdir, name, b)}\" \"{b}\"' if 'fetch' in p else f'patch --ignore-whitespace -t -b -p1 -i \"{p[\"local\"]}\"' if 'local' in p else f'copy /Y \"{p[\"copy\"]}\" \"{b}\"' if 'copy' in p else '') + f' && copy nul \"{os.path.join(source_dir, f\"__patched_{b}\")}\"' + (' && popd' if 'chdir' in p else '') for p in patch_files if p.get('when', True) is not False and (v := (p.get('remote') or p.get('local') or p.get('copy') or p.get('fetch'))) and (b := os.path.basename(v)) and not os.path.exists(os.path.join(source_dir, f'__patched_{b}'))])}}"
            }
          ]
        },
        "configure": {
          "cmake_genarator": "-G \"Ninja Multi-Config\"",
          "cmake_options": [
            "-DCMAKE_POLICY_VERSION_MINIMUM=3.5",
            "-DCMAKE_FIND_LIBRARY_PREFIXES=\"lib\"",
            "-DCMAKE_CONFIGURATION_TYPES=\"$build_type\"",
            "-DCMAKE_CXX_STANDARD=17",
            "-DBUILD_WITH_STATIC_CRT={{'OFF' if $msvc_runtime_library == 'md' else 'ON'}}",
            "-DBUILD_SHARED_LIBS={{'ON' if 'shared' in $build_library else 'OFF'}}",
            "-DCMAKE_MSVC_RUNTIME_LIBRARY=\"{{'MultiThreaded$<$<CONFIG:Debug>:Debug>DLL' if $msvc_runtime_library == 'md' else 'MultiThreaded$<$<CONFIG:Debug>:Debug>'}}\"",
            "-DOPENCV_EXTRA_MODULES_PATH=\"${contrib_dir}\\modules\"",
            "-DWITH_CUDA={{'ON' if $cuda_enable else 'OFF'}}",
            "-DOPENCV_DNN_CUDA={{'ON' if $cuda_enable else 'OFF'}}",
            "-DWITH_GSTREAMER={{'ON' if $with_gstreamer else 'OFF'}}",
            "-DWITH_VT={{'ON' if $with_vtk else 'OFF'}}",
            "-DWIHT_FFMPEG={{'ON' if $with_ffmpeg != 'none' else 'OFF'}}",
            "-DOPENCV_FFMPEG_SKIP_DOWNLOAD={{'ON' if $with_ffmpeg == 'external' else 'OFF'}}",
            "-DWITH_QT={{'ON' if $with_qt else 'OFF'}}",
            "-DOPENCV_ENABLE_PKG_CONFIG=ON",
            "-DDENABLE_PRECOMPILED_HEADERS=OFF",
            "-DBUILD_TESTS=OFF",
            "-DBUILD_PERF_TESTS=OFF",
            "-DBUILD_EXAMPLES=OFF",
            "-DBUILD_opencv_apps=OFF"
          ],
          "cmake_options_debug": [
            "-DCMAKE_INSTALL_PREFIX=\"$dist_dir_debug\""
          ],
          "cmake_options_release": [
            "-DCMAKE_INSTALL_PREFIX=\"$dist_dir_release\""
          ],
          "scripts": [
            {
              "when": "{{'Debug' in $build_type and $build_layout == 'separation'}}",
              "script": "rmdir /s /q \"$build_dir_debug\" & timeout /t 3 /nobreak > nul & mkdir \"$build_dir_debug\""
            },
            {
              "when": "{{'Release' in $build_type }}",
              "script": "rmdir /s /q \"$build_dir_release\" & timeout /t 3 /nobreak > nul & mkdir \"$build_dir_release\""
            },
            {
              "message": "config for debug.",
              "when": "{{'Debug' in $build_type and $build_layout == 'separation'}}",
              "environments": {
                "CMAKE_PREFIX_PATH": "$dependent_packages_debug{{f';{$qt_msvc_dir}' if $with_qt else ''}}",
                "PKG_CONFIG_PATH": "$pkg_config_path_debug",
                "PERLIO": "raw"
              },
              "script": "cmake $cmake_genarator -C \"{{ os.path.join($package_dir, 'cv_options.cmake')}}\" {{' '.join($cmake_options)}} {{' '.join($cmake_options_debug)}} -S \"$source_dir\" -B \"$build_dir_debug\""
            },
            {
              "message": "config for release.",
              "when": "{{'Release' in $build_type}}",
              "environments": {
                "CMAKE_PREFIX_PATH": "$dependent_packages_release{{f';{$qt_msvc_dir}' if $with_qt else ''}}",
                "PKG_CONFIG_PATH": "$pkg_config_path_release",
                "PERLIO": "raw"
              },
              "script": "cmake $cmake_genarator -C \"{{ os.path.join($package_dir, 'cv_options.cmake')}}\" {{' '.join($cmake_options)}} {{' '.join($cmake_options_release)}} -S \"$source_dir\" -B \"$build_dir_release\""
            }
          ]
        },
        "build": {
          "protoc_depdll_paths": "{{';'.join([path for path in dependent_dlls_release.split(';') if 'zlib' in path or 'abseil-cpp' in path])}}",
          "scripts": [
            {
              "message": "build for debug.",
              "when": "{{'Debug' in $build_type}}",
              "environments": {
                "PATH": "{{';'.join(['%PATH%', $protoc_depdll_paths])}}",
                "PERLIO": "raw"
              },
              "script": "cmake --build \"$build_dir_debug\" --config Debug -j4"
            },
            {
              "message": "build for release.",
              "when": "{{'Release' in $build_type}}",
              "environments": {
                "PATH": "{{';'.join(['%PATH%', $protoc_depdll_paths])}}",
                "PERLIO": "raw"
              },
              "script": "cmake --build \"$build_dir_release\" --config Release -j4"
            }
          ]
        },
        "install": {
          "scripts": [
            {
              "message": "install for debug.",
              "when": "{{'Debug' in $build_type}}",
              "script": "cmake --install \"$build_dir_debug\" --config Debug"
            },
            {
              "message": "install for release.",
              "when": "{{'Release' in $build_type}}",
              "script": "cmake --install \"$build_dir_release\" --config Release"
            }
          ]
        },
        "post-install" :{
          "environments": {
            "PERLIO": "raw"
          },
          "scripts": [
            {
              "when": "{{'Debug' in $build_type}}",
              "script": "forfiles -P \"$dist_dir_debug\" /M *.pc /S /C \"cmd /c perl ${assets_rootdir}\\fix_pcfile.pl @PATH 0x22{{dist_rootdir.replace('\\\\', '/')}}0x22 {{os.path.basename($dist_dir_debug)}}\"",
              "ignore_errors": true
            },
            {
              "when": "{{'Release' in $build_type}}",
              "script": "forfiles -P \"$dist_dir_release\" /M *.pc /S /C \"cmd /c perl \"${assets_rootdir}\\fix_pcfile.pl\" @PATH 0x22{{dist_rootdir.replace('\\\\', '/')}}0x22 {{os.path.basename($dist_dir_release)}}\"",
              "ignore_errors": true
            }
          ]
        }
      }
    },
    "4.12.0": {  // OpenCV ver 4.12.0 is compatible with GStreamer ver 1.24 , FFmpeg ver 6.x.
      "dependencies": {
        "abseil-cpp":{
          "version": "==20250512.1"
        },
        "protobuf": {
          "version": "==31.1"
        },
        "ffmpeg": {
          "enable": "{{$with_gstreamer or $with_ffmpeg =='external'}}",
          "version": ">=6.1;<7.0",   // GStreamer ver 1.24.5 is compatible with FFmpeg ver 6.x.
          "build_library": "shared"
        },
        "gstreamer": {
          "enable": "{{$with_gstreamer}}",
          "version": ">=1.24;<1.25",  // OpenCV ver 4.12.0 is compatible with GStreamer ver 1.24 , FFmpeg ver 6.x.
          "build_library": "shared"
        }
      },
      "stages": {
        "patch": {
          "patch_files!replace": [
            {
              "chdir" : "$source_dir",
              "local": "${package_dir}\\cv_4.12_cmake_pkgconfig.diff",
            }
          ],
        }
      }
    },
    "4.13.0": {  // OpenCV ver 4.13.0 is compatible with GStreamer ver 1.28 , FFmpeg ver 8.1
      "dependencies": {
        "abseil-cpp":{
          "version": "==20250512.1"
        },
        "protobuf": {
          "version": "==31.1"
        },
        "ffmpeg": {
          "enable": "{{$with_gstreamer or $with_ffmpeg =='external'}}",
          "version": ">=8.1",
          "build_library": "shared"
        },
        "gstreamer": {
          "enable": "{{$with_gstreamer}}",
          "version": ">=1.28",
          "build_library": "shared"
        }
      },
      "stages": {
        "patch": {
          "patch_files!replace": [
            {
              "chdir" : "$source_dir",
              "local": "${package_dir}\\cv_4.12_cmake_pkgconfig.diff",
            }
          ],
        }
      }
    },
    "4.14.0": {  // OpenCV ver 4.14.0 is compatible with GStreamer ver 1.28 , FFmpeg ver 8.1
      "dependencies": {
        "abseil-cpp":{
          "version": "==20250512.1"
        },
        "protobuf": {
          "version": "==35.1"
        },
        "ffmpeg": {
          "enable": "{{$with_gstreamer or $with_ffmpeg =='external'}}",
          "version": ">=8.1",
          "build_library": "shared"
        },
        "gstreamer": {
          "enable": "{{$with_gstreamer}}",
          "version": ">=1.28",
          "build_library": "shared"
        }
      },
      "stages": {
        "patch": {
          "patch_files!replace": [
            {
              "chdir" : "$source_dir",
              "local": "${package_dir}\\cv_4.12_cmake_pkgconfig.diff",
            },
            {
              "chdir" : "$contrib_dir",
              "local": "${package_dir}\\cv_4.14_fix_viz.diff",
            },
          ],
        }
      }
    }
  }
}

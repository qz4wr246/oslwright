{
  "name": "gobject-introspection",
  "display": "gobject-introspection",
  "description": "A middleware layer between C libraries (using GObject) and language bindings.",
  "site": "https://gi.readthedocs.io/",
  "license": "LGPL-2.0",
  "info":"info.md",
  "process_time": 120,
  "options": [
    {
      "display": "Version",
      "name": "version",
      "type": "choice",
      "items": "{{$versions}}",
      "default": "$latest_version"
    },
    {
      "display": "Visual Studio version",
      "name": "msvc_version",
      "type": "choice",
      "items": "{{$msvc_versions}}",
      "default": "$msvc_version_default"
    },
    {
      "display": "MSVC toolset version",
      "name": "msvc_toolset_version",
      "type": "choice",
      "items": "{{$msvc_toolset_versions}}",
      "default": "$msvc_toolset_version_default"
    },
    {
      "display": "Build arch",
      "name": "build_arch",
      "type": "choice",
      "items": [
        "x64",
        "x32"
      ],
      "default": "$build_arch_default"
    },
    {
      "display": "MSVC runtime library",
      "name": "msvc_runtime_library",
      "type": "choice",
      "items": [
        "mt",
        "md"
      ],
      "default": "$msvc_runtime_library_default"
    },
    {
      "display": "Build library",
      "name": "build_library",
      "enable": false,
      "type": "choice",
      "items": [
        "shared",
        "static"
      ],
      "default": "shared"
    },
    {
      "display": "Build type",
      "name": "build_type",
      "enable": false,
      "type": "choice",
      "items": [
        "Release",
        "Debug"
      ],
      "default": "Release"
    },
    {
      "display": "Build layout",
      "name": "build_layout",
      "enable": false,
      "type": "choice",
      "items": [
        "separation"
      ],
      "default": "separation"
    },
    {
      "display": "Using CUDA",
      "name": "cuda_enable",
      "enable": false,
      "type": "bool",
      "default": false
    },
    {
      "display": "CUDA Version",
      "name": "cuda_version",
      "enable": "{{$cuda_enable}}",
      "type": "choice",
      "items": "{{$cuda_versions}}",
      "default": "{{$cuda_version_default}}"
    }
  ],
  "versions": {
    "default": {
      "source_dir": "${source_rootdir}\\${name}-${version}",
      "dist_name": "${name}-${version}{{'' if $build_library == 'interface' else '-' + $build_arch + '-' + $msvc_toolset_version + '-' + $msvc_runtime_library + (('-cu' + $cuda_version.replace('.','')) if $cuda_enable else '') + ('-static' if 'static' == $build_library else '')}}",
      "dist_name_debug": "${dist_name}{{'-debug' if $build_layout == 'separation' else ''}}",
      "dist_name_release": "${dist_name}{{'-release' if $build_layout == 'separation' else ''}}",
      "build_dir_debug": "${source_rootdir}\\${dist_name_debug}-build",
      "build_dir_release": "${source_rootdir}\\${dist_name_release}-build",
      "dist_dir_debug": "${dist_rootdir}\\${dist_name_debug}",
      "dist_dir_release": "${dist_rootdir}\\${dist_name_release}",
      "cache_file": "${cache_rootdir}\\${name}-${version}.7z",
      "git_url": "https://gitlab.gnome.org/GNOME/gobject-introspection.git",
      "git_tag": "{{$version.split('@', 1)[0] if '@' in $version else $version}}",
      "git_hash": "{{$version.split('@', 1)[1] if '@' in $version else ''}}",
      "msys2_dir" : "${tools_rootdir}\\msys2\\msys64",
      "msys2_external_runtime_dir": "${msys2_dir}\\opt\\ucrt64",
      "msys2_bash": "\"${msys2_dir}\\usr\\bin\\bash.exe\" -lc ",
      "dependencies": {
        "glib": {
          "version": ">=2.88"
        },
        "proxy-libintl": {
          "version": ">=0.5"
        },
        "libffi": {
          "version": ">=3.5"
        },
        "pcre2": {
          "version": ">=10.0"
        },
        "zlib": {
          "version": ">=1.3"
        }
      },
      "environments": {
        "LC_ALL": "C",
        "PERLIO": "raw",
        "CUDA_PATH": "{{os.path.join($cuda_root, f'v{$cuda_version}')  if $cuda_enable else ''}}",
        "CUDNN_PATH": "{{os.path.join($cuda_root, f'v{$cuda_version}')  if $cuda_enable else ''}}"
      },
      "stages": {
        "download": {
          "scripts": [
            {
              "when": "{{os.path.isdir($source_dir)}}",
              "script": "rmdir /q /s \"$source_dir\" > nul"
            },
            {
              "message": "git clone.",
              "when": "{{not os.path.isdir($source_dir) and not os.path.isfile($cache_file)}}",
              "script": "git clone --no-progress --quiet -b \"$git_tag\" {{'' if $git_hash else '--depth 1'}} --single-branch --recurse --shallow-submodules $git_url \"$source_dir\"",
              "fallback": "rmdir /q /s \"$source_dir\""
            },
            {
              "message": "git checkout.",
              "when": "{{$git_hash and os.path.isdir($source_dir) and not os.path.isfile($cache_file)}}",
              "chdir": "$source_dir",
              "script": "git checkout $git_hash",
              "fallback": "rmdir /q /s \"$source_dir\""
            },
            {
              "message": "extract from cache.",
              "when": "{{not os.path.isdir($source_dir) and os.path.isfile($cache_file)}}",
              "script": "7z -sccUTF-8 x -aoa \"$cache_file\" -o\"$source_dir\"",
              "fallback": "rmdir /q /s \"$source_dir\""
            },
            {
              "message": "make cache.",
              "when": "{{not os.path.isfile($cache_file)}}",
              "script": "7z -sccUTF-8 a \"$cache_file\" \"$source_dir\\*\"",
              "fallback": "del \"$cache_file\""
            }
          ]
        },
        "patch": {
          "repo_url":"https://raw.githubusercontent.com/msys2/MINGW-packages/refs/heads/master/mingw-w64-gobject-introspection",
          "dowload_file": "$repo_url/pyscript2exe.py",
          "patch_files": [
            {
              "url": "$repo_url/0002-relocate-tools.patch"
            },
            {
              "url": "$repo_url/0022-change-pkg-config-invocations.mingw.patch"
            },
            {
              "url": "$repo_url/0024-Support-passing-arguments-to-g-ir-scanner-through-a-.all.patch"
            },
            {
              "url": "$repo_url/0026-giscanner-assertions-and-waits.patch"
            },
            {
              "file": "$package_dir\\gobject-introspection_giscanner_ccompiler-1.86.0.diff"
            }
          ],
          "scripts": [
            {
              // Patch Script: patching source code with patch_files
              "message": "Patch ${name} source code",
              "when": "{{'patch_files' in globals()}}",
              "chdir": "$source_dir",
              "script": "{{' && '.join([(f'pushd \"{p[\"chdir\"]}\" && ' if \"chdir\" in p else '')+(f'curl.exe --fail -L -s -o \"{os.path.basename(p[\"url\"])}\" \"{p[\"url\"]}\" && patch -t -p1 -i \"{os.path.basename(p[\"url\"])}\" && copy nul > \"__patched__{os.path.basename(p[\"url\"])}\"' if \"url\" in p else f'patch -t -p1 -i \"{p[\"file\"]}\" && copy nul > \"__patched__{os.path.basename(p[\"file\"])}\"') + (' && popd ' if \"chdir\" in p else '') for p in $patch_files if p.get('when', True) and not os.path.exists('__patched__' + os.path.basename(p.get('url') or p.get('file')))])}}"
            },
            {
              "chdir": "$source_dir",
              "script": "curl.exe --fail -L -s -o \"{{os.path.basename($dowload_file)}}\" $dowload_file"
            }
          ]
        },
        "configure": {
          "meson_options": [
            "--vsenv",
            "--pkgconfig.relocatable",
            "--default-library={{'static' if $build_library == 'static' else 'shared'}}",
            "-Db_vscrt={{'from_buildtype' if $msvc_runtime_library == 'md' else 'static_from_buildtype'}}",
            "-Dpython=$python_exe",
            "-Ddoctool=enabled",
            "-Dcairo=disabled",
            "-Dtests=false"
          ],
          "meson_options_debug" : [
            "--prefix=\"$dist_dir_debug\"",
            "--buildtype debug"
          ],
          "meson_options_release" : [
            "--prefix=\"$dist_dir_release\"",
            "--buildtype release"
          ],
          "scripts": [
            {
              "ignore_errors": true,
              "when": "{{'Debug' in $build_type and $build_layout == 'separation'}}",
              "script": "del /q /s \"$build_dir_debug\" > nul"
            },
            {
              "ignore_errors": true,
              "when": "{{'Release' in $build_type}}",
              "script": "del /q /s \"$build_dir_release\" > nul"
            },
            {
              "ignore_errors": true,
              "when": "{{'Debug' in $build_type and not os.path.isdir($build_dir_debug)}}",
              "script": "mkdir \"$build_dir_debug\""
            },
            {
              "ignore_errors": true,
              "when": "{{'Release' in $build_type and not os.path.isdir($build_dir_release)}}",
              "script": "mkdir \"$build_dir_release\""
            },
            {
              "message": "config for debug.",
              "when": "{{'Debug' in $build_type}}",
              "environments": {
                "CMAKE_PREFIX_PATH": "$dependent_packages_debug",
                "PKG_CONFIG_PATH": "$pkg_config_path_debug",
                "PATH": "{{';'.join(['%PATH%', $dependent_dlls_debug])}}"
              },
              "bash_script": "meson setup {{' '.join($meson_options)}} {{' '.join($meson_options_debug)}} \"$build_dir_debug\" \"$source_dir\""
            },
            {
              "message": "config for release.",
              "when": "{{'Release' in $build_type}}",
              "environments": {
                "CMAKE_PREFIX_PATH": "$dependent_packages_release",
                "PKG_CONFIG_PATH": "$pkg_config_path_release",
                "PATH": "{{';'.join(['%PATH%', $dependent_dlls_release])}}"
              },
              "script": "meson setup {{' '.join($meson_options)}} {{' '.join($meson_options_release)}} \"$build_dir_release\" \"$source_dir\""
            }
          ]
        },
        "build": {
          "intl_dir_debug" : "{{next((x for x in $dependent_packages_debug.split(';') if 'intl' in x), '')}}",
          "intl_dir_release" : "{{next((x for x in $dependent_packages_release.split(';') if 'intl' in x), '')}}",
          "intl_include_debug": "$intl_dir_debug\\include",
          "intl_include_release": "$intl_dir_release\\include",
          "intl_lib_debug": "$intl_dir_debug\\lib\\intl.lib",
          "intl_lib_release": "$intl_dir_release\\lib\\intl.lib",
          "scripts": [
            {
              "message": "build for debug.",
              "when": "{{'Debug' in $build_type}}",
              "environments": {
                "PATH": "{{';'.join(['%PATH%', $dependent_dlls_debug])}}"
              },
              "script": "meson compile -C \"$build_dir_debug\" -j 1"
            },
            {
              "environments": {
                "dep_paths" : "$dependent_dlls_release",
                "dist_dir": "$build_dir_release\\giscanner"
              },
              "script": "for %a in (\"%dep_paths:;=\" \"%\") do @if exist %~a copy /y \"%~a\\*.dll\" \"%dist_dir%\""
            },
            {
              "environments": {
                "dep_paths" : "$dependent_libs_release",
                "dist_dir": "$build_dir_release"
              },
              "script": "for %p in (\"%dep_paths:;=\" \"%\") do @for %f in (\"%~p\\*.lib\") do @cmd /v:on /c \"set fname=%~nxf& if /i \"!fname:~0,3!\"==\"lib\" (copy /y \"%~f\" \"%dist_dir%\\!fname:~3!\") else (copy /y \"%~f\" \"%dist_dir%\\\")\""
            },
            {
              "script": "copy /y \"$intl_include_release\\libintl.h\" \"$build_dir_release\""
            },
            {
              "message": "build for release.",
              "when": "{{'Release' in $build_type}}",
              "chdir": "$build_dir_release",
              "environments": {
                "PATH": "{{';'.join(['%PATH%', $dependent_dlls_release, $build_dir_release, $build_dir_release + '\\girepository', $build_dir_release + '\\giscanner' ])}}",
                "CMAKE_PREFIX_PATH": "$dependent_packages_release",
                "PKG_CONFIG_PATH": "$pkg_config_path_release",
                "LIB": "$dependent_libss_release;%LIB%"
              },
              "script": "meson compile -C \"$build_dir_release\" -j 1"
            }
          ]
        },
        "install": {
          "meson_install_options": [
          ],
          "scripts": [
            {
              "message": "install for debug.",
              "when": "{{'Debug' in $build_type}}",
              "script": "meson install -C \"$build_dir_debug\" {{' '.join($meson_install_options)}}"
            },
            {
              "message": "install for release.",
              "when": "{{'Release' in $build_type}}",
              "script": "meson install -C \"$build_dir_release\" {{' '.join($meson_install_options)}}"
            }
          ]
        },
        "post-install": {
          "glib_dir_release" : "{{next((x for x in $dependent_packages_release.split(';') if 'glib' in x), '')}}",
          "dist_rootdir_slash": "{{$dist_rootdir.replace('\\\\', '/')}}",
          "environments": {
            "PERLIO": "raw"
          },
          "scripts": [
            {
              "message": "Adjust paths and other configurations in *.pc",
              "when": "{{'Debug' in $build_type}}",
              "script": "forfiles -P \"$dist_dir_debug\" /M *.pc /S /C \"cmd /c perl ${assets_rootdir}\\fix_pcfile.pl @PATH 0x22${dist_rootdir_slash}0x22\"",
              "ignore_errors": true
            },
            {
              "message": "Adjust paths and other configurations in *.pc",
              "when": "{{'Release' in $build_type}}",
              "script": "forfiles -P \"$dist_dir_release\" /M *.pc /S /C \"cmd /c perl ${assets_rootdir}\\fix_pcfile.pl @PATH 0x22${dist_rootdir_slash}0x22\"",
              "ignore_errors": true
            },
            // {
            //   "message": "Replace execute path of python script",
            //   "when": "{{'Debug' in $build_type}}",
            //   "script": "for /f \"delims=\" %f in ('findstr /M \"Mode: Python\" \"$dist_dir_debug\\bin\\*\"') do perl -i -pe \"s|^#!/usr/bin/env .*python\\.exe|#!/usr/bin/env python.exe|\" \"%f\""
            // },
            // {
            //   "message": "Replace execute path of python script",
            //    "when": "{{'Release' in $build_type}}",
            //   "script": "for /f \"delims=\" %f in ('findstr /M \"Mode: Python\" \"$dist_dir_release\\bin\\*\"') do perl -i -pe \"s|^#!/usr/bin/env .*python\\.exe|#!/usr/bin/env python.exe|\" \"%f\""
            // },
            {
              "message": "Copy runtime library for giscanner",
              "when": "{{'Debug' in $build_type}}",
              "environments": {
                "dep_paths" : "$dependent_dlls_release",
                "dist_dir": "$dist_dir_debug\\lib\\gobject-introspection\\giscanner"
              },
              "script": "for %a in (\"%dep_paths:;=\" \"%\") do @if exist %~a copy /y \"%~a\\*.dll\" \"%dist_dir%\""
            },
            {
              "message": "Copy runtime library for giscanner",
              "when": "{{'Release' in $build_type}}",
              "environments": {
                "dep_paths" : "$dependent_dlls_release",
                "dist_dir": "$dist_dir_release\\lib\\gobject-introspection\\giscanner"
              },
              "script": "for %a in (\"%dep_paths:;=\" \"%\") do @if exist %~a copy /y \"%~a\\*.dll\" \"%dist_dir%\""
            },
            {
              "message": "Copy gir files",
              "when": "{{'Debug' in $build_type}}",
                "environments": {
                "dep_paths" : "$glib_dir_release\\share\\gir-1.0",
                "dist_dir": "$dist_dir_debug\\share\\gir-1.0"
              },
              "script": "for %a in (\"%dep_paths:;=\" \"%\") do @if exist %~a copy /y \"%~a\\*.gir\" \"%dist_dir%\""
            },
            {
              "message": "Copy gir files",
              "when": "{{'Release' in $build_type}}",
                "environments": {
                "dep_paths" : "$glib_dir_release\\share\\gir-1.0",
                "dist_dir": "$dist_dir_release\\share\\gir-1.0"
              },
              "script": "for %a in (\"%dep_paths:;=\" \"%\") do @if exist %~a copy /y \"%~a\\*.gir\" \"%dist_dir%\""
            }
          ]
        }
      }
    },
    "1.86.0": {}
  }
}

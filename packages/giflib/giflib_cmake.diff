diff --git a/CMakeLists.txt b/CMakeLists.txt
new file mode 100644
index 0000000..cb9d4bb
--- /dev/null
+++ b/CMakeLists.txt
@@ -0,0 +1,110 @@
+cmake_minimum_required(VERSION 3.10)
+
+file(READ "${CMAKE_CURRENT_SOURCE_DIR}/gif_lib.h" GIFLIB_HEADER)
+string(REGEX MATCH "#define[ \t]+GIFLIB_MAJOR[ \t]+([0-9]+)" _major "${GIFLIB_HEADER}")
+set(GIFLIB_MAJOR "${CMAKE_MATCH_1}")
+string(REGEX MATCH "#define[ \t]+GIFLIB_MINOR[ \t]+([0-9]+)" _minor "${GIFLIB_HEADER}")
+set(GIFLIB_MINOR "${CMAKE_MATCH_1}")
+string(REGEX MATCH "#define[ \t]+GIFLIB_RELEASE[ \t]+([0-9]+)" _release "${GIFLIB_HEADER}")
+set(GIFLIB_RELEASE "${CMAKE_MATCH_1}")
+set(GIFLIB_VERSION "${GIFLIB_MAJOR}.${GIFLIB_MINOR}.${GIFLIB_RELEASE}")
+
+project(GIF LANGUAGES C VERSION ${GIFLIB_VERSION})
+include(GNUInstallDirs)
+
+set(PUBLIC_HEADERS
+  gif_lib.h
+  "${CMAKE_CURRENT_BINARY_DIR}/gif_lib_export.h"
+)
+
+set(PRIVATE_HEADERS
+  gif_hash.h
+  gif_lib_private.h
+)
+
+set(SOURCES
+  dgif_lib.c
+  egif_lib.c
+  gif_err.c
+  gif_font.c
+  gifalloc.c
+  quantize.c
+  gif_hash.c
+  openbsd-reallocarray.c
+)
+
+add_library(${PROJECT_NAME}
+  ${SOURCES}
+  ${PUBLIC_HEADERS}
+  ${PRIVATE_HEADERS}
+)
+
+target_include_directories(${PROJECT_NAME} PUBLIC
+    $<BUILD_INTERFACE:${CMAKE_CURRENT_SOURCE_DIR}>
+    $<BUILD_INTERFACE:${CMAKE_CURRENT_BINARY_DIR}>
+    $<INSTALL_INTERFACE:${CMAKE_INSTALL_INCLUDEDIR}>
+)
+
+set_target_properties(${PROJECT_NAME} PROPERTIES PUBLIC_HEADER "${PUBLIC_HEADERS}")
+set_target_properties(${PROJECT_NAME} PROPERTIES DEBUG_POSTFIX "d")
+
+add_library(${PROJECT_NAME}::${PROJECT_NAME} ALIAS ${PROJECT_NAME})
+
+if(MSVC)
+  if(BUILD_SHARED_LIBS)
+    target_compile_definitions(${PROJECT_NAME} PRIVATE GIFLIB_EXPORTS)
+    set(GIFLIB_STATIC_DEFINE "")
+  else()
+    target_compile_definitions(${PROJECT_NAME} PRIVATE GIFLIB_STATIC_DEFINE)
+    set(GIFLIB_STATIC_DEFINE "#define GIFLIB_STATIC_DEFINE 1")
+  endif()
+endif()
+
+configure_file(
+    "${CMAKE_CURRENT_SOURCE_DIR}/gif_lib_export.h.in"
+    "${CMAKE_CURRENT_BINARY_DIR}/gif_lib_export.h"
+    @ONLY
+)
+
+configure_file(
+    "${CMAKE_CURRENT_SOURCE_DIR}/GIF.pc.in"
+    "${CMAKE_CURRENT_BINARY_DIR}/GIF.pc"
+    @ONLY
+)
+
+install(TARGETS ${PROJECT_NAME}
+    EXPORT ${PROJECT_NAME}-export
+    LIBRARY DESTINATION ${CMAKE_INSTALL_LIBDIR}
+    ARCHIVE DESTINATION ${CMAKE_INSTALL_LIBDIR}
+    RUNTIME DESTINATION ${CMAKE_INSTALL_BINDIR}
+    PUBLIC_HEADER DESTINATION ${CMAKE_INSTALL_INCLUDEDIR}
+)
+
+install(FILES "${CMAKE_CURRENT_BINARY_DIR}/GIF.pc"
+    DESTINATION ${CMAKE_INSTALL_LIBDIR}/pkgconfig
+)
+
+include(CMakePackageConfigHelpers)
+install(EXPORT ${PROJECT_NAME}-export
+  FILE ${PROJECT_NAME}Targets.cmake
+  NAMESPACE ${PROJECT_NAME}::
+  DESTINATION lib/cmake/${PROJECT_NAME}
+  EXPORT_LINK_INTERFACE_LIBRARIES
+)
+
+write_basic_package_version_file(
+  ${CMAKE_CURRENT_BINARY_DIR}/${PROJECT_NAME}ConfigVersion.cmake
+  COMPATIBILITY AnyNewerVersion
+)
+
+configure_package_config_file(
+    "${PROJECT_SOURCE_DIR}/Config.cmake.in"
+    "${CMAKE_CURRENT_BINARY_DIR}/${PROJECT_NAME}Config.cmake"
+    INSTALL_DESTINATION ${CMAKE_INSTALL_LIBDIR}/cmake/${PROJECT_NAME}
+)
+
+install(FILES
+  ${CMAKE_CURRENT_BINARY_DIR}/${PROJECT_NAME}ConfigVersion.cmake
+  ${CMAKE_CURRENT_BINARY_DIR}/${PROJECT_NAME}Config.cmake
+  DESTINATION lib/cmake/${PROJECT_NAME}
+)

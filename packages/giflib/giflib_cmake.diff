diff --git a/gif_lib_export.h.in b/gif_lib_export.h.in
new file mode 100644
index 0000000..623ef39
--- /dev/null
+++ b/gif_lib_export.h.in
@@ -0,0 +1,45 @@
+
+#ifndef GIFLIB_EXPORT_H
+#define GIFLIB_EXPORT_H
+
+@GIFLIB_STATIC_DEFINE@
+
+#ifdef GIFLIB_STATIC_DEFINE
+#  define GIFLIB_EXPORT
+#  define GIFLIB_NO_EXPORT
+#else
+#  ifndef GIFLIB_EXPORT
+#    ifdef GIFLIB_EXPORTS
+        /* We are building this library */
+#      define GIFLIB_EXPORT __declspec(dllexport)
+#    else
+        /* We are using this library */
+#      define GIFLIB_EXPORT __declspec(dllimport)
+#    endif
+#  endif
+
+#  ifndef GIFLIB_NO_EXPORT
+#    define GIFLIB_NO_EXPORT
+#  endif
+#endif
+
+#ifndef GIFLIB_DEPRECATED
+#  define GIFLIB_DEPRECATED __declspec(deprecated)
+#endif
+
+#ifndef GIFLIB_DEPRECATED_EXPORT
+#  define GIFLIB_DEPRECATED_EXPORT GIFLIB_EXPORT GIFLIB_DEPRECATED
+#endif
+
+#ifndef GIFLIB_DEPRECATED_NO_EXPORT
+#  define GIFLIB_DEPRECATED_NO_EXPORT GIFLIB_NO_EXPORT GIFLIB_DEPRECATED
+#endif
+
+/* NOLINTNEXTLINE(readability-avoid-unconditional-preprocessor-if) */
+#if 0 /* DEFINE_NO_DEPRECATED */
+#  ifndef GIFLIB_NO_DEPRECATED
+#    define GIFLIB_NO_DEPRECATED
+#  endif
+#endif
+
+#endif /* GIFLIB_EXPORT_H */

{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "OSLWright package schema",
  "type": "object",
  "required": [
    "name",
    "display",
    "description",
    "site",
    "license",
    "process_time",
    "options",
    "versions"
  ], // 'info' is optional
  "properties": {
    "name": {
      "type": "string"
    },
    "display": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "site": {
      "type": "string",
      "format": "uri"
    },
    "process_time": {
      "type": "number"
    },
    "license": {
      "type": "string"
    },
    "info": {
      "type": "string"
    },
    "options": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "display": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "enable": {
            "type": [
              "string",
              "boolean"
            ]
          }, // 'enable' is optional
          "type": {
            "type": "string",
            "enum": [
              "text",
              "bool",
              "choice"
            ]
          },
          "items": {},
          "default": {
            "type": [
              "string",
              "boolean"
            ]
          }
        },
        "required": [
          "display",
          "name",
          "type",
          "default"
        ],
        "if": {
          "properties": {
            "type": {
              "const": "choice"
            }
          }
        },
        "then": {
          "properties": {
            "items": {
              "oneOf": [
                {
                  "type": "array"
                },
                {
                  "type": "string"
                }
              ]
            }
          },
          "required": ["items"]
        },
        "else": {
          "not": {
            "required": ["items"]
          }
        },
        "additionalProperties": false
      }
    },
    "versions": {
      "type": "object",
      "required": [
        "default"
      ],
      "minProperties": 2,
      "patternProperties": {
        ".*": {
          "type": "object",
          "properties": {
            "dependencies": {
              "type": "object",
              "patternProperties": {
                ".*": {
                  "oneOf": [
                    {
                      "type": "string",
                      "pattern": "^((\\s*(>=|<=|>|<)\\s*[0-9]+(\\.[0-9]+){0,3}(-[0-9A-Za-z.-]+)?\\s*)|([A-Za-z0-9_.-]+))(\\s*[;,]\\s*((>=|<=|>|<)\\s*[0-9]+(\\.[0-9]+){0,3}(-[0-9A-Za-z.-]+)?\\s*|[A-Za-z0-9_.-]+))*$"
                    },
                    {
                      "type": "object",
                      "properties": {
                        "version": {
                          "type": "string",
                          "pattern": "^((\\s*(>=|<=|>|<)\\s*[0-9]+(\\.[0-9]+){0,3}(-[0-9A-Za-z.-]+)?\\s*)|([A-Za-z0-9_.-]+))(\\s*[;,]\\s*((>=|<=|>|<)\\s*[0-9]+(\\.[0-9]+){0,3}(-[0-9A-Za-z.-]+)?\\s*|[A-Za-z0-9_.-]+))*$"
                        },
                        "enable": {
                          "type": [
                            "string",
                            "boolean"
                          ]
                        }
                      },
                      "additionalProperties": true
                    }
                  ]
                }
              },
              "additionalProperties": false
            },
            "environments": {
              "type": "object",
              "patternProperties": {
                ".*": {
                  "type": "string"
                }
              },
              "additionalProperties": false
            },
            "stages": {
              "type": "object",
              "patternProperties": {
                "^(download|patch|configure|build|test|install|post-install)$": {
                  "type": "object",
                  "properties": {
                    "environments": {
                      "type": "object",
                      "patternProperties": {
                        ".*": {
                          "type": "string"
                        }
                      },
                      "additionalProperties": true
                    },
                    "scripts": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "required": ["script"],
                        "properties": {
                          "message": {
                            "type": "string"
                          },
                          "chdir": {
                            "type": "string"
                          },
                          "when": {
                            "type": ["string", "boolean"]
                          },
                          "environments": {
                            "type": "object",
                            "patternProperties": {
                              ".*": {
                                "type": "string"
                              }
                            },
                            "additionalProperties": true
                          },
                          "script": {
                            "type": "string"
                          },
                          "fallback": {
                            "type": "string"
                          },
                          "ignore_errors": {
                            "type": ["string", "boolean"]
                          }
                        }
                      }
                    },
                    "additionalProperties": true
                  }
                }
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": true
        }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": false
}

@echo off
setlocal enabledelayedexpansion

:: =============================================================
:: 1. Preparation and input data setup
:: =============================================================
set "OW_DEP_DIRS={{DEPENDENT_DLL_PATHS}}"

set "SCRIPT_DIR=%~dp0"
set "SCRIPT_DIR=%SCRIPT_DIR:~0,-1%"
for %%I in ("%SCRIPT_DIR%\..\..") do set "ROOT_DIR=%%~fI"

:: =============================================================
:: 2. Create the "__oslw_dep_dlls" folder under the current directory
:: =============================================================
set "DLL_TARGET_DIR=%CD%\__oslw_dep_dlls"

if exist "%DLL_TARGET_DIR%" rmdir /s /q "%DLL_TARGET_DIR%"
mkdir "%DLL_TARGET_DIR%"

:: =============================================================
:: 3. Find *.dll files in all dependency folders and create symbolic links
:: =============================================================
echo Creating symbolic links for DLLs...

for %%A in (%OW_DEP_DIRS%) do (
    set "search_dir=%ROOT_DIR%\%%A"

    if exist "!search_dir!" (
        for %%F in ("!search_dir!\*.dll") do (
            set "dll_name=%%~nxF"
            set "src_path=%%~fF"
            set "dst_path=%DLL_TARGET_DIR%\!dll_name!"

            if not exist "!dst_path!" (
                mklink "!dst_path!" "!src_path!" >nul 2>&1
                if errorlevel 1 (
                    copy /y "!src_path!" "!dst_path!" >nul
                )
            )
        )
    )
)
mklink "%DLL_TARGET_DIR%\libstdc++-6.dll" "%ROOT_DIR%\..\tools\msys2\msys64\ucrt64\bin\libstdc++-6.dll" >nul 2>&1
mklink "%DLL_TARGET_DIR%\libwinpthread-1.dll" "%ROOT_DIR%\..\tools\msys2\msys64\ucrt64\bin\libwinpthread-1.dll" >nul 2>&1

:: =============================================================
:: 4. Add only "_dlls" to PATH and start a subshell
:: =============================================================
echo Sub-shell started. PATH will reset on exit.

cmd.exe /k "set "PATH=%DLL_TARGET_DIR%;%PATH%""

:: =============================================================
:: 5. Clean up after the subshell exits (reset the environment)
:: =============================================================
if exist "%DLL_TARGET_DIR%" rmdir /s /q "%DLL_TARGET_DIR%"

endlocal
echo Environment has been reset.
pause
